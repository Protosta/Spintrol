          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Transmission request bits (for all message objects)\n0 No transmission has been requested for this message object.\n1 The transmission of this message object is requested and is not yet done.\nNote: Bit 0 is for MBOX0, Bit 1 is for MBOX1, ..., Bit 63 for MBOX63. -->
            <field>
              <name>VAL</name>
              <description>Transmission request bits (for all message objects)\n0 No transmission has been requested for this message object.\n1 The transmission of this message object is requested and is not yet done.\nNote: Bit 0 is for MBOX0, Bit 1 is for MBOX1, ..., Bit 63 for MBOX63.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- CANMSGNEW: New Message Register -->
        <register>
          <!-- dimElementGroup -->
          <dim>2</dim>
          <dimIncrement>4</dimIncrement>
          <!-- end of dimElementGroup -->
          <name>CANMSGNEW[%s]</name>
          <displayName>CANMSGNEW[%s]</displayName>
          <description>New Message Register</description>
          <addressOffset>0x00000050</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: New message bits (for all message objects)\n0 No new data has been written into the data portion of this message object by the message handler since the last time when this flag was cleared by the CPU.\n1 The message handler or the CPU has written new data into the data portion of this message object.\nNote: Bit 0 is for MBOX0, Bit 1 is for MBOX1, ..., Bit 63 for MBOX63. -->
            <field>
              <name>VAL</name>
              <description>New message bits (for all message objects)\n0 No new data has been written into the data portion of this message object by the message handler since the last time when this flag was cleared by the CPU.\n1 The message handler or the CPU has written new data into the data portion of this message object.\nNote: Bit 0 is for MBOX0, Bit 1 is for MBOX1, ..., Bit 63 for MBOX63.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- CANMSGIF: Message Transfer Done Interrupt Flag Register -->
        <register>
          <!-- dimElementGroup -->
          <dim>2</dim>
          <dimIncrement>4</dimIncrement>
          <!-- end of dimElementGroup -->
          <name>CANMSGIF[%s]</name>
          <displayName>CANMSGIF[%s]</displayName>
          <description>Message Transfer Done Interrupt Flag Register</description>
          <addressOffset>0x00000060</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Interrupt pending bits (for all message objects)\n0 This mailbox is not the source of transfer OK interrupt.\n1 This mailbox is the source of transfer OK interrupt.\nNote: Bit 0 is for MBOX0, Bit 1 is for MBOX1, ..., Bit 63 for MBOX63. -->
            <field>
              <name>VAL</name>
              <description>Interrupt pending bits (for all message objects)\n0 This mailbox is not the source of transfer OK interrupt.\n1 This mailbox is the source of transfer OK interrupt.\nNote: Bit 0 is for MBOX0, Bit 1 is for MBOX1, ..., Bit 63 for MBOX63.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- CANMBEN: Mailbox Enable Register -->
        <register>
          <!-- dimElementGroup -->
          <dim>2</dim>
          <dimIncrement>4</dimIncrement>
          <!-- end of dimElementGroup -->
          <name>CANMBEN[%s]</name>
          <displayName>CANMBEN[%s]</displayName>
          <description>Mailbox Enable Register</description>
          <addressOffset>0x00000070</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Mailbox enable bits (for all message objects)\n0 This message object is ignored by the message handler.\n1 This message object is configured and will be considered by the message handler.\nNote: Bit 0 is for MBOX0, Bit 1 is for MBOX1, ..., Bit 63 for MBOX63. -->
            <field>
              <name>VAL</name>
              <description>Mailbox enable bits (for all message objects)\n0 This message object is ignored by the message handler.\n1 This message object is configured and will be considered by the message handler.\nNote: Bit 0 is for MBOX0, Bit 1 is for MBOX1, ..., Bit 63 for MBOX63.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- CANTSCTL: Timestamp Control Register -->
        <register>
          <name>CANTSCTL</name>
          <displayName>CANTSCTL</displayName>
          <description>Timestamp Control Register</description>
          <addressOffset>0x00000080</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- TSEN: Timestamp enable -->
            <field>
              <name>TSEN</name>
              <description>Timestamp enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- CANTSCNT: Timestamp Counter Register -->
        <register>
          <name>CANTSCNT</name>
          <displayName>CANTSCNT</displayName>
          <description>Timestamp Counter Register</description>
          <addressOffset>0x00000084</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- TSCNT: Timestamp up-counter value.\nNote: write will set this field.\nNote: Count based on sample point. -->
            <field>
              <name>TSCNT</name>
              <description>Timestamp up-counter value.\nNote: write will set this field.\nNote: Count based on sample point.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- CANREGKEY: Register write-allow key register -->
        <register>
          <name>CANREGKEY</name>
          <displayName>CANREGKEY</displayName>
          <description>Register write-allow key register</description>
          <addressOffset>0x0000008C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x1ACCE551</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- KEY: Write 0x1ACCE551 to unlock protected registers. -->
            <field>
              <name>KEY</name>
              <description>Write 0x1ACCE551 to unlock protected registers.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>


  </peripherals>
</device>
