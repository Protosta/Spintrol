                  <name>STANDARD</name>
                  <description>Message is standard CAN frame.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EXTENDED</name>
                  <description>Message is extended CAN frame.</description>
                  <value>0x1</value>
                </enumeratedValue>
