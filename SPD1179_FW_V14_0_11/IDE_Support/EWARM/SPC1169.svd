                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RAMPEN: DAC Ramping enable -->
            <field>
              <name>RAMPEN</name>
              <description>DAC Ramping enable</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable ramping</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable ramping. DAC0CODEA is equivalent to the 10 MSBs of RAMP0CNT</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RAMPLOAD: DAC Ramp load mode -->
            <field>
              <name>RAMPLOAD</name>
              <description>DAC Ramp load mode</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SHADOW_MODE</name>
                  <description>Register shadowing is applied for ramping counter load from RAMPMAX</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIRECT_MODE</name>
                  <description>RAMP counter is directly loaded from the latest RAMPMAX</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DBGRUN: Behavior on CPU halted or lockup -->
            <field>
              <name>DBGRUN</name>
              <description>Behavior on CPU halted or lockup</description>
              <bitRange>[15:14]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>STOP_IMMEDIATELY</name>
