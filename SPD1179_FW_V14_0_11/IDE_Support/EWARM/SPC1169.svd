          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Reload value when reset ramping -->
            <field>
              <name>VAL</name>
              <description>Reload value when reset ramping</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- RAMP1MAXA: RAMP1 Reload Value Active Register -->
        <register>
          <name>RAMP1MAXA</name>
          <displayName>RAMP1MAXA</displayName>
          <description>RAMP1 Reload Value Active Register</description>
          <addressOffset>0x000003A8</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Reload value when reset ramping -->
            <field>
              <name>VAL</name>
              <description>Reload value when reset ramping</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- RAMP1CNT: RAMP1 Count Register -->
        <register>
          <name>RAMP1CNT</name>
          <displayName>RAMP1CNT</displayName>
          <description>RAMP1 Count Register</description>
          <addressOffset>0x000003AC</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Count number of RAMP1 -->
            <field>
              <name>VAL</name>
              <description>Count number of RAMP1</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- DAC2CTL: DAC2 Control Register -->
        <register>
          <name>DAC2CTL</name>
          <displayName>DAC2CTL</displayName>
          <description>DAC2 Control Register</description>
          <addressOffset>0x000003B0</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000002</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- EN: DAC enable -->
            <field>
              <name>EN</name>
              <description>DAC enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CODELOAD: DAC code load mode -->
            <field>
              <name>CODELOAD</name>
              <description>DAC code load mode</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SHADOW_MODE</name>
                  <description>DAC code is updated upon PWMSYNC event</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIRECT_MODE</name>
                  <description>DAC code is immediately updated by writing to DAC2CODE</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SYNCSEL: PWM synchronous output select -->
            <field>
              <name>SYNCSEL</name>
              <description>PWM synchronous output select</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PWM0SYNCO</name>
                  <description>PWM0 synchronous output</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWM1SYNCO</name>
                  <description>PWM1 synchronous output</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWM2SYNCO</name>
                  <description>PWM2 synchronous output</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWM3SYNCO</name>
                  <description>PWM3 synchronous output</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- DAC2CODE: DAC2 Code Register -->
        <register>
          <name>DAC2CODE</name>
          <displayName>DAC2CODE</displayName>
          <description>DAC2 Code Register</description>
          <addressOffset>0x000003B4</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: DAC code\nWhen DAC2CTL.CODELOAD=0, write to this field only affects the shadow code.\nWhen DAC2CTL.CODELOAD=1, write to this field affects both the shadow code and the active code. -->
            <field>
              <name>VAL</name>
              <description>DAC code\nWhen DAC2CTL.CODELOAD=0, write to this field only affects the shadow code.\nWhen DAC2CTL.CODELOAD=1, write to this field affects both the shadow code and the active code.</description>
              <bitRange>[9:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- DAC2CODEA: DAC2 Active Code Register -->
        <register>
          <name>DAC2CODEA</name>
          <displayName>DAC2CODEA</displayName>
          <description>DAC2 Active Code Register</description>
          <addressOffset>0x000003B8</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Active DAC code -->
            <field>
              <name>VAL</name>
              <description>Active DAC code</description>
              <bitRange>[9:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- DACBUFCTL: DAC Buffer Control Register -->
        <register>
          <name>DACBUFCTL</name>
          <displayName>DACBUFCTL</displayName>
          <description>DAC Buffer Control Register</description>
          <addressOffset>0x000003F8</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- EN: DAC buffer enable -->
            <field>
              <name>EN</name>
              <description>DAC buffer enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- OE: Enable output to GPIO -->
            <field>
              <name>OE</name>
              <description>Enable output to GPIO</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- INSEL: Select the DAC module -->
            <field>
              <name>INSEL</name>
              <description>Select the DAC module</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DAC0</name>
                  <description>DAC0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DAC1</name>
                  <description>DAC1</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- COMPREGKEY: COMP Register Write-Allow Key Register -->
        <register>
          <name>COMPREGKEY</name>
          <displayName>COMPREGKEY</displayName>
          <description>COMP Register Write-Allow Key Register</description>
          <addressOffset>0x000003FC</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x1ACCE551</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- KEY: Write 0x1ACCE551 to unlock protected COMP registers -->
            <field>
              <name>KEY</name>
              <description>Write 0x1ACCE551 to unlock protected COMP registers</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>PGA</name>
      <description></description>
