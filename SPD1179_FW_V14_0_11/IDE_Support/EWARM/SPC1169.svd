        <!-- ADCINTSOCSEL: ADC Interrupt Trigger SOC Select Register 0 -->
        <register>
          <!-- dimElementGroup -->
          <dim>2</dim>
          <dimIncrement>4</dimIncrement>
          <!-- end of dimElementGroup -->
          <name>ADCINTSOCSEL[%s]</name>
          <displayName>ADCINTSOCSEL[%s]</displayName>
          <description>ADC Interrupt Trigger SOC Select Register 0</description>
          <addressOffset>0x0000002C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- CH0: ADC CH0 SOC from which channel interrupt -->
            <field>
              <name>CH0</name>
              <description>ADC CH0 SOC from which channel interrupt</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- CH1: ADC CH1 SOC from which channel interrupt -->
            <field>
              <name>CH1</name>
              <description>ADC CH1 SOC from which channel interrupt</description>
              <bitRange>[7:4]</bitRange>
              <access>read-write</access>
            </field>

            <!-- CH2: ADC CH2 SOC from which channel interrupt -->
            <field>
              <name>CH2</name>
              <description>ADC CH2 SOC from which channel interrupt</description>
              <bitRange>[11:8]</bitRange>
              <access>read-write</access>
            </field>

            <!-- CH3: ADC CH3 SOC from which channel interrupt -->
            <field>
              <name>CH3</name>
              <description>ADC CH3 SOC from which channel interrupt</description>
              <bitRange>[15:12]</bitRange>
              <access>read-write</access>
            </field>

            <!-- CH4: ADC CH4 SOC from which channel interrupt -->
            <field>
              <name>CH4</name>
              <description>ADC CH4 SOC from which channel interrupt</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>

            <!-- CH5: ADC CH5 SOC from which channel interrupt -->
            <field>
              <name>CH5</name>
              <description>ADC CH5 SOC from which channel interrupt</description>
              <bitRange>[23:20]</bitRange>
              <access>read-write</access>
            </field>

            <!-- CH6: ADC CH6 SOC from which channel interrupt -->
            <field>
              <name>CH6</name>
              <description>ADC CH6 SOC from which channel interrupt</description>
              <bitRange>[27:24]</bitRange>
              <access>read-write</access>
            </field>

            <!-- CH7: ADC CH7 SOC from which channel interrupt -->
            <field>
              <name>CH7</name>
              <description>ADC CH7 SOC from which channel interrupt</description>
              <bitRange>[31:28]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- ADCEXTSOCCTL: ADC External SOC Input Control Register -->
        <register>
          <name>ADCEXTSOCCTL</name>
          <displayName>ADCEXTSOCCTL</displayName>
          <description>ADC External SOC Input Control Register</description>
          <addressOffset>0x00000034</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- POL: EXTSOC polarity -->
            <field>
              <name>POL</name>
              <description>EXTSOC polarity</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ACTIVE_LOW</name>
                  <description>Active when low</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACTIVE_HIGH</name>
                  <description>Active when high</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- IOSEL: GPIO number for EXTSOC -->
            <field>
              <name>IOSEL</name>
              <description>GPIO number for EXTSOC</description>
              <bitRange>[6:1]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- ADCCHCTL: ADC Channel Control Register -->
        <register>
          <!-- dimElementGroup -->
          <dim>16</dim>
          <dimIncrement>4</dimIncrement>
          <!-- end of dimElementGroup -->
          <name>ADCCHCTL[%s]</name>
          <displayName>ADCCHCTL[%s]</displayName>
          <description>ADC Channel Control Register</description>
          <addressOffset>0x00000038</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- SAMPCNT: Sample window size,\nwhich is (SAMPCNT + 1) ADC clock cycles -->
            <field>
              <name>SAMPCNT</name>
              <description>Sample window size,\nwhich is (SAMPCNT + 1) ADC clock cycles</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- CONVCNT: Conversion window size, \nwhich is (CONVCNT + 1) ADC clock cycles -->
            <field>
              <name>CONVCNT</name>
              <description>Conversion window size, \nwhich is (CONVCNT + 1) ADC clock cycles</description>
              <bitRange>[12:8]</bitRange>
              <access>read-write</access>
            </field>

            <!-- FRACBIT: Keep 7 LSBs as fractional part to ADC result due to average -->
            <field>
              <name>FRACBIT</name>
              <description>Keep 7 LSBs as fractional part to ADC result due to average</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>ADC result is a 13-bit  integer number</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>ADC result is 20-bit and the 7 LBSs are the fractional part</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- AVGCNT: Select average counts for the ADC result -->
            <field>
              <name>AVGCNT</name>
              <description>Select average counts for the ADC result</description>
              <bitRange>[16:14]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_AVG</name>
                  <description>No average</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AVG_2</name>
                  <description>Each SOC will trigger 2 consecutive ADC operations and then average</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AVG_4</name>
                  <description>Each SOC will trigger 4 consecutive ADC operations and then average</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AVG_8</name>
                  <description>Each SOC will trigger 8 consecutive ADC operations and then average</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AVG_16</name>
                  <description>Each SOC will trigger 16 consecutive ADC operations and then average</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AVG_32</name>
                  <description>Each SOC will trigger 32 consecutive ADC operations and then average</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AVG_64</name>
                  <description>Each SOC will trigger 64 consecutive ADC operations and then average</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AVG_128</name>
                  <description>Each SOC will trigger 128 consecutive ADC operations and then average</description>
                  <value>0x7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SHINSELP: Select positive input of selected SH -->
            <field>
              <name>SHINSELP</name>
              <description>Select positive input of selected SH</description>
              <bitRange>[20:17]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>GND</name>
                  <description>Analog ground</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TSENS_P</name>
                  <description>T-sensor positive output</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DPGAP_OUT</name>
                  <description>Positive output of DPGA</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ANA_IN0</name>
                  <description>ANA_IN0 pin input</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ANA_IN2</name>
                  <description>ANA_IN2 pin input</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ANA_IN4</name>
                  <description>ANA_IN4 pin input</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SPGA_OUT</name>
                  <description>SPGA output</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ATEST</name>
                  <description>ATEST output</description>
                  <value>0x7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DACBUF</name>
                  <description>DAC buffer output</description>
                  <value>0x8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DAC0</name>
                  <description>DAC0 output</description>
                  <value>0x9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VDD12</name>
                  <description>Digital 1.2V power</description>
                  <value>0xA</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VDD33</name>
                  <description>Analog 3.3V power</description>
                  <value>0xB</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ANA_IN9_PHU</name>
                  <description>ANA_IN9 pin input / U-Phase sensed signal</description>
                  <value>0xC</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ANA_IN10_PHV</name>
                  <description>ANA_IN10 pin input / V-Phase sensed signal</description>
                  <value>0xD</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ANA_IN11_PHW</name>
                  <description>ANA_IN11 pin input / W-Phase sensed signal</description>
                  <value>0xE</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ANA_IN13_VBATM_DIV</name>
                  <description>ANA_IN13 pin input / VBATMDIV sensed signal</description>
                  <value>0xF</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SHINSELN: Select negative input of selected SH -->
            <field>
              <name>SHINSELN</name>
              <description>Select negative input of selected SH</description>
              <bitRange>[24:21]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>GND</name>
                  <description>Analog ground</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TSENS_N</name>
                  <description>T-sensor negative output</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DPGAN_OUT</name>
                  <description>Negative output of DPGA</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ANA_IN1</name>
                  <description>ANA_IN1 pin input</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ANA_IN3</name>
                  <description>ANA_IN3 pin input</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ANA_IN5</name>
                  <description>ANA_IN5 pin input</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ANA_IN6</name>
                  <description>ANA_IN6 pin input</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ANA_IN7</name>
                  <description>ANA_IN7 pin input</description>
                  <value>0x7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ANA_IN8</name>
                  <description>ANA_IN8 pin input</description>
                  <value>0x8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DAC1</name>
                  <description>DAC1 output</description>
                  <value>0x9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DAC2</name>
                  <description>DAC2 output</description>
                  <value>0xA</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ANA_IN12_PHC</name>
                  <description>ANA_IN12 pin input / 3-phase common-node sensed signal</description>
                  <value>0xB</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TRIGSEL: SOC trigger source, which will set bit in ADCSOCFLG \nIt can be overridden by ADCINTSOCSEL -->
            <field>
              <name>TRIGSEL</name>
              <description>SOC trigger source, which will set bit in ADCSOCFLG \nIt can be overridden by ADCINTSOCSEL</description>
              <bitRange>[28:25]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SOFTWARE</name>
                  <description>ADCTRIG0 - Software only</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TIMER0</name>
                  <description>ADCTRIG1 - Timer 0 </description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TIMER1</name>
                  <description>ADCTRIG2 - Timer 1 </description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TIMER2</name>
                  <description>ADCTRIG3 - Timer 2 </description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EXTSOC</name>
                  <description>ADCTRIG4 - EXTSOC</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWM0SOCA</name>
                  <description>ADCTRIG5 - PWM0SOCA </description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWM0SOCB</name>
                  <description>ADCTRIG6 - PWM0SOCB </description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWM0SOCC</name>
                  <description>ADCTRIG7 - PWM0SOCC</description>
                  <value>0x7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWM1SOCA</name>
                  <description>ADCTRIG8 - PWM1SOCA </description>
                  <value>0x8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWM1SOCB</name>
                  <description>ADCTRIG9 - PWM1SOCB </description>
                  <value>0x9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWM1SOCC</name>
