                  <description>Enable event TBCNT=CMPB when TBCNT is counting up</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TBCNT_EQU_CMPB_DOWN</name>
                  <description>Enable event TBCNT=CMPB when TBCNT is counting down</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
