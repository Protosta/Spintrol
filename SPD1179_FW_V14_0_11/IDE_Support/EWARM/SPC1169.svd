        <!-- PHCOMPRAWIF: Phase Comparison Raw Interrupt Flag Register -->
        <register>
          <name>PHCOMPRAWIF</name>
          <displayName>PHCOMPRAWIF</displayName>
          <description>Phase Comparison Raw Interrupt Flag Register</description>
          <addressOffset>0x00000004</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- PHUZCL: U-Phase zero-cross to low event flag -->
            <field>
              <name>PHUZCL</name>
              <description>U-Phase zero-cross to low event flag</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Event does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Event occurred</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PHUZCH: U-Phase zero-cross to high event flag -->
            <field>
              <name>PHUZCH</name>
              <description>U-Phase zero-cross to high event flag</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Event does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Event occurred</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PHVZCL: V-phase zero-cross to low event flag -->
            <field>
              <name>PHVZCL</name>
              <description>V-phase zero-cross to low event flag</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Event does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
