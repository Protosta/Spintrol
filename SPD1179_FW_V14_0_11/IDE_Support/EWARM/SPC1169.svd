                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>5</name>
                  <description>5-bytes.</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>6</name>
                  <description>6-bytes.</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
