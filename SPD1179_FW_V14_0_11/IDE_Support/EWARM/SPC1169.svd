        <!-- SPIIC: SPI Interrupt Clear Register -->
        <register>
          <name>SPIIC</name>
          <displayName>SPIIC</displayName>
          <description>SPI Interrupt Clear Register</description>
          <addressOffset>0x00000028</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- RXUD: Receive FIFO underrun interrupt Clear -->
            <field>
              <name>RXUD</name>
              <description>Receive FIFO underrun interrupt Clear</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write 1 clears the flag. This bit is self cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXOV: Receive FIFO Overrun Interrupt Clear -->
            <field>
              <name>RXOV</name>
              <description>Receive FIFO Overrun Interrupt Clear</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
