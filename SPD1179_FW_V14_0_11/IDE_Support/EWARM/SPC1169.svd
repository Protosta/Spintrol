              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DATA</name>
                  <description>Message is data frame.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>REMOTE</name>
                  <description>Message is remote frame.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- CANMBOXMTS: Mailbox Message Timestamp Register Note: Read only. -->
