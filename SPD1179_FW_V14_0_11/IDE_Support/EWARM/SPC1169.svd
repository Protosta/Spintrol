              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- ESICTL: Control send error state indicator enable -->
            <field>
              <name>ESICTL</name>
              <description>Control send error state indicator enable</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Send ESI value equal node passive state, node active send dominant bit and passive send recessive bit.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Send ESI valud by MBFCTL.ESI.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- LOCK: Milbox locked flag.\nNote: always write 0 to this field. -->
            <field>
              <name>LOCK</name>
              <description>Milbox locked flag.\nNote: always write 0 to this field.</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCURED</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCURRED</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- OVWR: Enable overWrite mailbox which is end of block. -->
            <field>
              <name>OVWR</name>
              <description>Enable overWrite mailbox which is end of block.</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- EOB: End of block. -->
            <field>
              <name>EOB</name>
              <description>End of block.</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- IE: Enable mailbox transfer interrupt. -->
            <field>
              <name>IE</name>
              <description>Enable mailbox transfer interrupt.</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- IF: Interrupt pending flag.\nNote: always write 0 to this field. -->
            <field>
              <name>IF</name>
              <description>Interrupt pending flag.\nNote: always write 0 to this field.</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCURED</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCURRED</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXREQ: Transmit request. -->
            <field>
              <name>TXREQ</name>
              <description>Transmit request.</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- LOST: Received message lost.\nNote: always write 0 to this field. -->
            <field>
              <name>LOST</name>
              <description>Received message lost.\nNote: always write 0 to this field.</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCURED</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCURRED</name>
                  <description>For reception: old message lost.\nFor transmission: data error occurred during transmission, MBCTL.EN will be cleared for this reason.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- NEW: New message. -->
            <field>
              <name>NEW</name>
              <description>New message.</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>OLD</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NEW</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RMTEN: Enable remote frame auto response. -->
            <field>
              <name>RMTEN</name>
              <description>Enable remote frame auto response.</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>DIR==0: transmit remote frame first, then wait receive data frame.\nDIR==1: wait receive remote frame first, then transmit message in mailbox.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DIR: Message data transfer direction on bus. -->
            <field>
              <name>DIR</name>
              <description>Message data transfer direction on bus.</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>RECEPTION</name>
                  <description>Wait receive data.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRANSMISSION</name>
                  <description>Wait transmit data.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- EN: Enable mailbox -->
            <field>
              <name>EN</name>
              <description>Enable mailbox</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>CANMBOX45</name>
      <description></description>
      <groupName>CANMBOX</groupName>
      <baseAddress>0X40004E10</baseAddress>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>80</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>

        <!-- CANMBOXFDW: Mailbox Data Word Register -->
        <register>
          <!-- dimElementGroup -->
          <dim>16</dim>
          <dimIncrement>4</dimIncrement>
          <!-- end of dimElementGroup -->
          <name>CANMBOXFDW[%s]</name>
          <displayName>CANMBOXFDW[%s]</displayName>
          <description>Mailbox Data Word Register</description>
          <addressOffset>0x00000000</addressOffset>
          <!-- registerPropertiesGroup -->
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- BYTE0: Byte (4 * N + 0) of CAN frame, N is CANMBOXFDW index. -->
            <field>
              <name>BYTE0</name>
              <description>Byte (4 * N + 0) of CAN frame, N is CANMBOXFDW index.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- BYTE1: Byte (4 * N + 1) of CAN frame, N is CANMBOXFDW index. -->
            <field>
              <name>BYTE1</name>
              <description>Byte (4 * N + 1) of CAN frame, N is CANMBOXFDW index.</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>

            <!-- BYTE2: Byte (4 * N + 2) of CAN frame, N is CANMBOXFDW index. -->
            <field>
              <name>BYTE2</name>
              <description>Byte (4 * N + 2) of CAN frame, N is CANMBOXFDW index.</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>

            <!-- BYTE3: Byte (4 * N + 3) of CAN frame, N is CANMBOXFDW index. -->
            <field>
              <name>BYTE3</name>
              <description>Byte (4 * N + 3) of CAN frame, N is CANMBOXFDW index.</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- CANMBOXFMSK: Mailbox Frame Mask Register -->
        <register>
          <name>CANMBOXFMSK</name>
          <displayName>CANMBOXFMSK</displayName>
          <description>Mailbox Frame Mask Register</description>
          <addressOffset>0x00000040</addressOffset>
          <!-- registerPropertiesGroup -->
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- ID: Identifier mask. -->
            <field>
              <name>ID</name>
              <description>Identifier mask.</description>
              <bitRange>[28:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- IDE: Identifier extension bit mask. -->
            <field>
              <name>IDE</name>
              <description>Identifier extension bit mask.</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DONT_CARE</name>
                  <description>This bit in the message identifier is not used for acceptance filtering (don&apos;t care).</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CARE</name>
                  <description>This bit in the message identifier is used for acceptance filtering.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RTR: Remote transmission request bit mask. -->
            <field>
              <name>RTR</name>
              <description>Remote transmission request bit mask.</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DONT_CARE</name>
                  <description>This bit in the message identifier is not used for acceptance filtering (don&apos;t care).</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CARE</name>
                  <description>This bit in the message identifier is used for acceptance filtering.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- CANMBOXFID: Mailbox Frame Identifier Register -->
        <register>
          <name>CANMBOXFID</name>
          <displayName>CANMBOXFID</displayName>
          <description>Mailbox Frame Identifier Register</description>
          <addressOffset>0x00000044</addressOffset>
