            <!-- VDD33OV: Latched VDD33 over-voltage event flag -->
            <field>
              <name>VDD33OV</name>
              <description>Latched VDD33 over-voltage event flag</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Event does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Event occurred</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PLLUNLOCK: Latched PLL unlock event flag\nDetailed reason can be referred to CLKSTS[PLLFAST] and CLKSTS[PLLSLOW] -->
            <field>
              <name>PLLUNLOCK</name>
              <description>Latched PLL unlock event flag\nDetailed reason can be referred to CLKSTS[PLLFAST] and CLKSTS[PLLSLOW]</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Event does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Event occurred</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CLKDETERR: Latched CLKDET error event flag\nIt means CLKDETCNT is out of the range defined by CLKDETCTH -->
            <field>
              <name>CLKDETERR</name>
              <description>Latched CLKDET error event flag\nIt means CLKDETCNT is out of the range defined by CLKDETCTH</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
