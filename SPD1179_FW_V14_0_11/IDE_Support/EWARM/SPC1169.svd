                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Send ESI valud by MBFCTL.ESI.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- LOCK: Milbox locked flag.\nNote: always write 0 to this field. -->
            <field>
              <name>LOCK</name>
