            <!-- RST: ADC digital finite state machine reset -->
            <field>
              <name>RST</name>
              <description>ADC digital finite state machine reset</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
