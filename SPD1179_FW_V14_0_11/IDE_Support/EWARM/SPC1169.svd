        <!-- PWRMODECMD: Power Mode Command Register -->
        <register>
          <name>PWRMODECMD</name>
          <displayName>PWRMODECMD</displayName>
          <description>Power Mode Command Register</description>
          <addressOffset>0x0000000C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- KEY: Write 0xA5A51EE9 to make the MCU go to deep-sleep\nWrite 0x5A5A5709 to make the MCU go to stop -->
            <field>
              <name>KEY</name>
              <description>Write 0xA5A51EE9 to make the MCU go to deep-sleep\nWrite 0x5A5A5709 to make the MCU go to stop</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- PWRREGKEY: Power Register Write-Allow Key Register -->
        <register>
          <name>PWRREGKEY</name>
          <displayName>PWRREGKEY</displayName>
          <description>Power Register Write-Allow Key Register</description>
          <addressOffset>0x00000010</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x1ACCE551</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- KEY: Write 0x1ACCE551 to unlock protected power registers\nWrite 0xACCE55CD to unlock PWRMODECMD register -->
            <field>
              <name>KEY</name>
              <description>Write 0x1ACCE551 to unlock protected power registers\nWrite 0xACCE55CD to unlock PWRMODECMD register</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>CLOCK</name>
      <description></description>
      <groupName>CLOCK</groupName>
      <baseAddress>0x40000200</baseAddress>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>64</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>

        <!-- CLKSTS: Clock Status Register -->
        <register>
          <name>CLKSTS</name>
          <displayName>CLKSTS</displayName>
          <description>Clock Status Register</description>
          <addressOffset>0x00000000</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000003</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- RCORDY: RCO clock ready indicator -->
            <field>
              <name>RCORDY</name>
              <description>RCO clock ready indicator</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_READY</name>
                  <description>Not ready</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>READY</name>
                  <description>Ready</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- ROSCRDY: ROSC clock ready indicator -->
            <field>
              <name>ROSCRDY</name>
              <description>ROSC clock ready indicator</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_READY</name>
                  <description>Not ready</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>READY</name>
                  <description>Ready</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- XORDY: XO clock ready indicator -->
            <field>
              <name>XORDY</name>
              <description>XO clock ready indicator</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_READY</name>
                  <description>Not ready</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>READY</name>
                  <description>Ready</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PLLRDY: PLL clock ready indicator -->
            <field>
              <name>PLLRDY</name>
              <description>PLL clock ready indicator</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_READY</name>
                  <description>Not ready</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>READY</name>
                  <description>Ready</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- VCOFREQ: VCO frequency flag for trimming -->
            <field>
              <name>VCOFREQ</name>
              <description>VCO frequency flag for trimming</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>TOO_SLOW</name>
                  <description>VCO in PLL is too slow</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TOO_FAST</name>
                  <description>VCO in PLL is too fast</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- VCOFREQVLD: VCOFREQ flag valid indicator -->
            <field>
              <name>VCOFREQVLD</name>
              <description>VCOFREQ flag valid indicator</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>INVALID</name>
                  <description>VCOFREQ is invalid</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VALID</name>
                  <description>VCOFREQ is valid</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PLLFAST: Indicate PLL is unlocked and faster than expected.\nPossible reason can be:\n1. Fin/NIN*NFB/65536 is lower than 400MHz (lower boundary of VCO free-running frequency)\n2. The reference clock input is somehow missing\n3. Malfunction of feedback divider so that the equivalent dividing ratio is lower than expected. -->
            <field>
              <name>PLLFAST</name>
              <description>Indicate PLL is unlocked and faster than expected.\nPossible reason can be:\n1. Fin/NIN*NFB/65536 is lower than 400MHz (lower boundary of VCO free-running frequency)\n2. The reference clock input is somehow missing\n3. Malfunction of feedback divider so that the equivalent dividing ratio is lower than expected.</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PLLSLOW: Indicate PLL is unlocked and slower than expected.\nPossible reason can be:\n1. Fin/NIN*NFB/65536 is higher than 600MHz (upper boundary of VCO free-running frequency)\n2. VCO fails to oscillate\n3. Malfunction of feedback divider so that there is no output or the equivalent dividing ratio is higher than expected -->
            <field>
              <name>PLLSLOW</name>
              <description>Indicate PLL is unlocked and slower than expected.\nPossible reason can be:\n1. Fin/NIN*NFB/65536 is higher than 600MHz (upper boundary of VCO free-running frequency)\n2. VCO fails to oscillate\n3. Malfunction of feedback divider so that there is no output or the equivalent dividing ratio is higher than expected</description>
              <bitRange>[7:7]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CLKDETERR: Indicate error detected by CLKDET -->
            <field>
              <name>CLKDETERR</name>
              <description>Indicate error detected by CLKDET</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- RCOCTL: RCO Control Register -->
        <register>
          <name>RCOCTL</name>
          <displayName>RCOCTL</displayName>
          <description>RCO Control Register</description>
          <addressOffset>0x00000004</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- EN: RCO enable -->
            <field>
              <name>EN</name>
              <description>RCO enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- LFMODE: RCO low frequency mode -->
            <field>
              <name>LFMODE</name>
