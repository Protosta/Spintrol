            <!-- PHVFLT: V-phase realtime filtered output status -->
            <field>
              <name>PHVFLT</name>
              <description>V-phase realtime filtered output status</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LOW</name>
                  <description>Low</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HIGH</name>
                  <description>High</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PHWFLT: W-phase realtime filtered output status -->
            <field>
              <name>PHWFLT</name>
