                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXTIMEOUT: Receive timeout interrupt enable -->
            <field>
              <name>RXTIMEOUT</name>
              <description>Receive timeout interrupt enable</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXOVF: Transmit overflow interrupt enable -->
            <field>
              <name>TXOVF</name>
              <description>Transmit overflow interrupt enable</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXREQ: Transmit data write request interrupt enable -->
            <field>
              <name>TXREQ</name>
              <description>Transmit data write request interrupt enable</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- ABLOCK: Auto-baud lock interrupt enable -->
            <field>
              <name>ABLOCK</name>
              <description>Auto-baud lock interrupt enable</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- LINIDMATCH: LIN received ID match interrupt enable -->
            <field>
              <name>LINIDMATCH</name>
              <description>LIN received ID match interrupt enable</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- LINBITERR: LIN bit error interrupt enable -->
            <field>
              <name>LINBITERR</name>
              <description>LIN bit error interrupt enable</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- LINCSERR: LIN checksum error interrupt enable -->
            <field>
              <name>LINCSERR</name>
              <description>LIN checksum error interrupt enable</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- LINSBERR: LIN sync byte error interrupt enable -->
            <field>
              <name>LINSBERR</name>
              <description>LIN sync byte error interrupt enable</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- BUSIDLE: Bus idle interrupt enable -->
            <field>
              <name>BUSIDLE</name>
              <description>Bus idle interrupt enable</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

          </fields>
        </register>

        <!-- UARTDGCTL: UART RXD Deglitch Control -->
        <register>
          <name>UARTDGCTL</name>
          <displayName>UARTDGCTL</displayName>
          <description>UART RXD Deglitch Control</description>
          <addressOffset>0x00000054</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- FLTWIN: Deglitch filter window size is (FLTWIN+1) samples -->
            <field>
              <name>FLTWIN</name>
              <description>Deglitch filter window size is (FLTWIN+1) samples</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- FLTTH: Deglitch filter threshold is (FLTTH+1) 1&apos;s/0&apos;s for output to toggle -->
            <field>
              <name>FLTTH</name>
              <description>Deglitch filter threshold is (FLTTH+1) 1&apos;s/0&apos;s for output to toggle</description>
              <bitRange>[7:4]</bitRange>
              <access>read-write</access>
            </field>

            <!-- FLTDIV: Deglitch filter clock dividing ratio, which is (FLTDIV+1) -->
            <field>
              <name>FLTDIV</name>
              <description>Deglitch filter clock dividing ratio, which is (FLTDIV+1)</description>
              <bitRange>[11:8]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- UARTREGKEY: Uart Register Write-Allow Key Register -->
        <register>
          <name>UARTREGKEY</name>
          <displayName>UARTREGKEY</displayName>
          <description>Uart Register Write-Allow Key Register</description>
          <addressOffset>0x00000058</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x1ACCE551</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- KEY: Write 0x1ACCE551 to unlock protected UART registers -->
            <field>
              <name>KEY</name>
              <description>Write 0x1ACCE551 to unlock protected UART registers</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>SPI0</name>
      <description></description>
      <groupName>SPI</groupName>
      <baseAddress>0x40001500</baseAddress>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>76</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
         <name>SPI0</name>
         <description>SPI0 Interrupt</description>
         <value>7</value>
      </interrupt>
      <registers>

        <!-- SPIDATA: SPI Data Register -->
        <register>
          <name>SPIDATA</name>
          <displayName>SPIDATA</displayName>
          <description>SPI Data Register</description>
          <addressOffset>0x00000000</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Data to be written to the TXFIFO or read from the RXFIFO -->
            <field>
              <name>VAL</name>
              <description>Data to be written to the TXFIFO or read from the RXFIFO</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- SPICTL0: SPI Control Register 0 -->
        <register>
          <name>SPICTL0</name>
          <displayName>SPICTL0</displayName>
          <description>SPI Control Register 0</description>
          <addressOffset>0x00000004</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- EN: Synchronous Serial Port Enable -->
            <field>
              <name>EN</name>
              <description>Synchronous Serial Port Enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable SPI</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable SPI</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SLVCKRUN: Slave Clock Free Running\nOnly used for Slave mode. -->
            <field>
              <name>SLVCKRUN</name>
              <description>Slave Clock Free Running\nOnly used for Slave mode.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Clock input to SCLK is only active during data transfers</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Clock input to SCLK is continuously running. Must be enabled for SPI format.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SELSLV: Select Slave Mode -->
            <field>
              <name>SELSLV</name>
              <description>Select Slave Mode</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Master mode, SPI port drives SFRM &amp; SCLK</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Slave mode, SPI port receives SFRM &amp; SCLK</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SPIMODE: SPI Clock Mode Select (Only used for SPI frame format) -->
            <field>
              <name>SPIMODE</name>
              <description>SPI Clock Mode Select (Only used for SPI frame format)</description>
              <bitRange>[4:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PHS_POL_00</name>
                  <description>PHS = 0, POL = 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PHS_POL_01</name>
                  <description>PHS = 0, POL = 1</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PHS_POL_10</name>
                  <description>PHS = 1, POL = 0</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PHS_POL_11</name>
                  <description>PHS = 1, POL = 1</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SFRMINV: Invert Frame Signal -->
            <field>
              <name>SFRMINV</name>
              <description>Invert Frame Signal</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>SFRM polarity is determined by the PSP polarity bit</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>SFRM is inverted from normal SFRM (as defined by the PSP polarity bit)</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXONLY: Receive Without Transmit\nOnly used for Slave mode. -->
            <field>
              <name>RXONLY</name>
              <description>Receive Without Transmit\nOnly used for Slave mode.</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Transmit/Receive mode</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Receive without Transmit mode</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SIZE: Data Size Select -->
            <field>
              <name>SIZE</name>
              <description>Data Size Select</description>
              <bitRange>[11:7]</bitRange>
              <access>read-write</access>
            </field>

            <!-- FRMFMT: Frame Format -->
            <field>
              <name>FRMFMT</name>
              <description>Frame Format</description>
              <bitRange>[13:12]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SPI</name>
                  <description>Motorola Serial Peripheral Interface (SPI)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SSP</name>
                  <description>Texas Instruments Synchronous Serial Protocol(SSP)</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MWIRE</name>
                  <description>National Semiconductor Microwire</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PSP</name>
                  <description>Programmable Serial Protocol (PSP)</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- FPACK: FIFO Packing Enable -->
            <field>
              <name>FPACK</name>
              <description>FIFO Packing Enable</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>FIFO packing mode disabled</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>FIFO packing mode enabled</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TRIEN: STXD Tri-State Enable -->
            <field>
              <name>TRIEN</name>
              <description>STXD Tri-State Enable</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>STXD is not tri-stated</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>STXD is tri-stated when not transmitting data</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TRIPHS: STXD Tri-state Enable On Last Phase -->
            <field>
              <name>TRIPHS</name>
              <description>STXD Tri-state Enable On Last Phase</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ON_MIDDLE_LSB</name>
                  <description>STXD is tri-stated 1/2 clock cycle after the beginning of the LSB.\nNote: Must be 0b0 for SPI/MWIRE frame format.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ON_END_LSB</name>
                  <description>STXD is tri-stated on the clock edge that ends the LSB.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- MODE: Mode Select -->
            <field>
              <name>MODE</name>
              <description>Mode Select</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SPI</name>
                  <description>Normal SPI mode.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NETWORK</name>
                  <description>Network mode, worked with PSP format.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- FRMSLOT: Frame Slot\nOnly used for Network mode.\nSpecifies the number of time slots per frame (the actual number of time slots is this field + 1, so 1 to 8 time slots can be specified). -->
            <field>
              <name>FRMSLOT</name>
              <description>Frame Slot\nOnly used for Network mode.\nSpecifies the number of time slots per frame (the actual number of time slots is this field + 1, so 1 to 8 time slots can be specified).</description>
              <bitRange>[20:18]</bitRange>
              <access>read-write</access>
            </field>

            <!-- MWIREDS: Microwire Transmit Command Data Size\nOnly used for MWIRE. -->
            <field>
              <name>MWIREDS</name>
              <description>Microwire Transmit Command Data Size\nOnly used for MWIRE.</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SIZE_8BIT</name>
                  <description>8-bit command words are transmitted.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SIZE_16BIT</name>
                  <description>16-bit command words are transmitted.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DMARXREQ: DMA Receive Service Request Enable -->
            <field>
              <name>DMARXREQ</name>
              <description>DMA Receive Service Request Enable</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DMATXREQ: DMA Transmit Service Request Enable -->
            <field>
              <name>DMATXREQ</name>
              <description>DMA Transmit Service Request Enable</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SWAPPIN: Swap MOSI and MISO pin -->
            <field>
              <name>SWAPPIN</name>
              <description>Swap MOSI and MISO pin</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ORIGINAL_FUNCTION</name>
                  <description>Trailing bytes are handled by CPU.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SWAP_FUNCTION</name>
                  <description>Trailing bytes are handled by DMA, invaid when FIFO packing mode enabled.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- SPICTL1: SPI Control Register 1 -->
        <register>
          <name>SPICTL1</name>
          <displayName>SPICTL1</displayName>
          <description>SPI Control Register 1</description>
          <addressOffset>0x00000008</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- SFRMLCK: SFRM Lock Enable\nOnly valid for SPI format, Master mode -->
            <field>
              <name>SFRMLCK</name>
              <description>SFRM Lock Enable\nOnly valid for SPI format, Master mode</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable SFRM lock status</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable SFRM lock function. SFRM will be locked at active level after SPI start send data, then need manually clear this bit to release locked SFRM to normal status.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- SPISTS: SPI Status Register -->
        <register>
          <name>SPISTS</name>
          <displayName>SPISTS</displayName>
          <description>SPI Status Register</description>
          <addressOffset>0x0000000C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000003</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- TXNF: Transmit FIFO Not Full -->
            <field>
              <name>TXNF</name>
              <description>Transmit FIFO Not Full</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FULL</name>
                  <description>TXFIFO is full</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NOT_FULL</name>
                  <description>TXFIFO is not full</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXEMPTY: Transmit FIFO Not Full -->
            <field>
              <name>TXEMPTY</name>
              <description>Transmit FIFO Not Full</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_EMPTY</name>
                  <description>Transmit FIFO contains one ore more data entries</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EMPTY</name>
                  <description>Transmit FIFO is completely empty.\nBut there may be still data in the transmit shift out register and the transmit is going on.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXFULL: Receive FIFO full -->
            <field>
              <name>RXFULL</name>
              <description>Receive FIFO full</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_FULL</name>
                  <description>Receive FIFO contains empty locations</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FULL</name>
                  <description>Receive FIFO is completely full</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXNE: Receive FIFO Not Empty -->
            <field>
              <name>RXNE</name>
              <description>Receive FIFO Not Empty</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EMPTY</name>
                  <description>RXFIFO is empty</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NOT_EMPTY</name>
                  <description>RXFIFO is not empty</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- BUSY: SPI busy -->
            <field>
              <name>BUSY</name>
              <description>SPI busy</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PORT_IDLE</name>
                  <description>SPIx port is idle or disabled.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PORT_BUSY</name>
                  <description>SPIx port is currently transmitting or receiving framed data.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SLVCLK: Clock Synchronization Status\nSoftware need only read this bit when the SPIx port is a slave or when the SPIx port is in the special FIFO test mode. \nSoftware should wait until this bit is cleared before allowing an external device to assert the external SFRM or SCLK signals. -->
            <field>
              <name>SLVCLK</name>
              <description>Clock Synchronization Status\nSoftware need only read this bit when the SPIx port is a slave or when the SPIx port is in the special FIFO test mode. \nSoftware should wait until this bit is cleared before allowing an external device to assert the external SFRM or SCLK signals.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>READY</name>
                  <description>The SPIx port is ready for slave clock operations.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BUSY</name>
                  <description>The SPIx port is currently busy synchronizing slave mode signals.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TFEVEN: TXFIFO Even Sample Status\nThis bit must be looked at only when FIFO Packing is enabled. Otherwise, this bit = 0. -->
            <field>
              <name>TFEVEN</name>
              <description>TXFIFO Even Sample Status\nThis bit must be looked at only when FIFO Packing is enabled. Otherwise, this bit = 0.</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ODD_SAMPLES</name>
                  <description>TXFIFO entry has a odd number of samples</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EVEN_SAMPLES</name>
                  <description>TXFIFO entry has an even number of samples</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RFEVEN: RXFIFO Even Sample Status\nThis bit must be looked at only when FIFO Packing is enabled. Otherwise, this bit = 0. -->
            <field>
              <name>RFEVEN</name>
              <description>RXFIFO Even Sample Status\nThis bit must be looked at only when FIFO Packing is enabled. Otherwise, this bit = 0.</description>
              <bitRange>[7:7]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ODD_SAMPLES</name>
                  <description>RXFIFO entry has odd samples</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EVEN_SAMPLES</name>
                  <description>RXFIFO entry has even sample</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- ACTSLOT: Current active time slot.\nBecause of synchronization between the SPI port&apos;s SCLK domain and an internal bus clock domain, the value in this field becomes stable between the beginning and end of the currently active time slot. -->
            <field>
              <name>ACTSLOT</name>
              <description>Current active time slot.\nBecause of synchronization between the SPI port&apos;s SCLK domain and an internal bus clock domain, the value in this field becomes stable between the beginning and end of the currently active time slot.</description>
              <bitRange>[10:8]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SLOT_0</name>
                  <description>Time slot 0 is active</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SLOT_1</name>
                  <description>Time slot 1 is active</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SLOT_2</name>
                  <description>Time slot 2 is active</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SLOT_3</name>
                  <description>Time slot 3 is active</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SLOT_4</name>
                  <description>Time slot 4 is active</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SLOT_5</name>
                  <description>Time slot 5 is active</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SLOT_6</name>
                  <description>Time slot 6 is active</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SLOT_7</name>
                  <description>Time slot 7 is active</description>
                  <value>0x7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- NETBUSY: Network mode busy -->
            <field>
              <name>NETBUSY</name>
              <description>Network mode busy</description>
              <bitRange>[11:11]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NETWORK_IDLE</name>
                  <description>SPI port is in network mode and no frame is currently active</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NETWORK_BUSY</name>
                  <description>SPI port is in network mode and a frame is currently active</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SFRMLCK: SFRM Locked\nOnly valid for SPI format -->
            <field>
              <name>SFRMLCK</name>
              <description>SFRM Locked\nOnly valid for SPI format</description>
              <bitRange>[12:12]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_LOCK</name>
                  <description>SFRM not locked</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOCKED</name>
                  <description>SFRM locked</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- SPIRFLVL: SPI Receive FIFO Level Register -->
        <register>
          <name>SPIRFLVL</name>
          <displayName>SPIRFLVL</displayName>
          <description>SPI Receive FIFO Level Register</description>
          <addressOffset>0x00000010</addressOffset>
