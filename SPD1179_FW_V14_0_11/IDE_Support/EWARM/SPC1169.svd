                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- EPWRTZCLR: ePower Module Latched Trip-Zone Flag Clear Register -->
        <register>
          <name>EPWRTZCLR</name>
          <displayName>EPWRTZCLR</displayName>
