                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write 1 clears the flag. This bit is self cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TO: Receiver Timeout Interrupt Clear -->
            <field>
              <name>TO</name>
              <description>Receiver Timeout Interrupt Clear</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write 1 clears the flag. This bit is self cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXUD: Transmit FIFO Underrun Interrupt Clear -->
            <field>
              <name>TXUD</name>
              <description>Transmit FIFO Underrun Interrupt Clear</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write 1 clears the flag. This bit is self cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXOV: Transmit FIFO overrun interrupt Clear -->
            <field>
              <name>TXOV</name>
              <description>Transmit FIFO overrun interrupt Clear</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write 1 clears the flag. This bit is self cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- BITCNTERR: Bit Count Error Interrupt Clear -->
            <field>
              <name>BITCNTERR</name>
              <description>Bit Count Error Interrupt Clear</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write 1 clears the flag. This bit is self cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- INT: Global Interrupt Clear -->
            <field>
              <name>INT</name>
              <description>Global Interrupt Clear</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write 1 clears the flag. This bit is self cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- SPIIE: SPI Interrupt Enable Register -->
        <register>
          <name>SPIIE</name>
          <displayName>SPIIE</displayName>
          <description>SPI Interrupt Enable Register</description>
          <addressOffset>0x0000002C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- RXUD: Receive FIFO underrun interrupt enable -->
            <field>
              <name>RXUD</name>
              <description>Receive FIFO underrun interrupt enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXOV: Receive FIFO Overrun Interrupt Enable -->
            <field>
              <name>RXOV</name>
              <description>Receive FIFO Overrun Interrupt Enable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXREQ: Receive FIFO Service Request Interrupt Enable -->
            <field>
              <name>RXREQ</name>
              <description>Receive FIFO Service Request Interrupt Enable</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TO: Receiver Timeout Interrupt Enable -->
            <field>
              <name>TO</name>
              <description>Receiver Timeout Interrupt Enable</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXUD: Transmit FIFO Underrun Interrupt Enable -->
            <field>
              <name>TXUD</name>
              <description>Transmit FIFO Underrun Interrupt Enable</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXOV: Transmit FIFO overrun interrupt enable -->
            <field>
              <name>TXOV</name>
              <description>Transmit FIFO overrun interrupt enable</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXREQ: Transmit FIFO Service Request Interrupt Enable -->
            <field>
              <name>TXREQ</name>
              <description>Transmit FIFO Service Request Interrupt Enable</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- BITCNTERR: Bit Count Error Interrupt Enable -->
            <field>
              <name>BITCNTERR</name>
              <description>Bit Count Error Interrupt Enable</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- SPITO: SPI Time Out Register -->
        <register>
          <name>SPITO</name>
          <displayName>SPITO</displayName>
          <description>SPI Time Out Register</description>
          <addressOffset>0x00000030</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Timeout interval defined as 2^VAL+1 SPI clock (CLK_SPI) -->
            <field>
              <name>VAL</name>
              <description>Timeout interval defined as 2^VAL+1 SPI clock (CLK_SPI)</description>
              <bitRange>[23:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- SPIPSP: SPI Programmable Serial Protocol Register -->
        <register>
          <name>SPIPSP</name>
          <displayName>SPIPSP</displayName>
          <description>SPI Programmable Serial Protocol Register</description>
          <addressOffset>0x00000034</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- CLKMODE: Serial Bit-rate Clock Mode\nOnly used in PSP frame format. -->
            <field>
              <name>CLKMODE</name>
              <description>Serial Bit-rate Clock Mode\nOnly used in PSP frame format.</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DF_SR_IL</name>
                  <description>Data Driven (Falling), Data Sampled (Rising), Idle State (Low)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DR_SF_IL</name>
                  <description>Data Driven (Rising), Data Sampled (Falling), Idle State (Low)</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DR_SF_IH</name>
                  <description>Data Driven (Rising), Data Sampled (Falling), Idle State (High)</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DF_SR_IH</name>
                  <description>Data Driven (Falling), Data Sampled (Rising), Idle State (High)</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SFRMPOL: Serial Frame Polarity -->
            <field>
              <name>SFRMPOL</name>
              <description>Serial Frame Polarity</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ACTIVE_LOW</name>
                  <description>SFRM is active low (0b0)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACTIVE_HIGH</name>
                  <description>SFRM is active high (0b1)</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- ETDS: End Of Transfer Data State\nOnly used in PSP frame format. -->
            <field>
              <name>ETDS</name>
              <description>End Of Transfer Data State\nOnly used in PSP frame format.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LOW</name>
                  <description>Level low</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LSB_VALUE</name>
                  <description>Level of LSB value</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- STARTDLY: Start Delay\nOnly used in PSP frame format.\nDo not use in PSP Network mode, and must be 0 when worked in Network mode. -->
            <field>
              <name>STARTDLY</name>
              <description>Start Delay\nOnly used in PSP frame format.\nDo not use in PSP Network mode, and must be 0 when worked in Network mode.</description>
              <bitRange>[6:4]</bitRange>
              <access>read-write</access>
            </field>

            <!-- DMYSTART: Dummy Start\nOnly used in PSP frame format.\nDo not use in PSP Network mode, and must be 0 when worked in Network mode. -->
            <field>
              <name>DMYSTART</name>
              <description>Dummy Start\nOnly used in PSP frame format.\nDo not use in PSP Network mode, and must be 0 when worked in Network mode.</description>
              <bitRange>[10:7]</bitRange>
              <access>read-write</access>
            </field>

            <!-- FRMDLY: Serial Frame Delay\nOnly used in PSP frame format.\nDo not use in PSP Network mode, and must be 0 when worked in Network mode. -->
            <field>
              <name>FRMDLY</name>
              <description>Serial Frame Delay\nOnly used in PSP frame format.\nDo not use in PSP Network mode, and must be 0 when worked in Network mode.</description>
              <bitRange>[17:11]</bitRange>
              <access>read-write</access>
            </field>

            <!-- FRMWIDTH: Serial Frame Width\nOnly used in PSP frame format.\nOnly valid when SPI in Master mode. -->
            <field>
              <name>FRMWIDTH</name>
              <description>Serial Frame Width\nOnly used in PSP frame format.\nOnly valid when SPI in Master mode.</description>
              <bitRange>[23:18]</bitRange>
              <access>read-write</access>
            </field>

            <!-- SYNC: Frame Sync Relative Timing Bit\nOnly used in PSP frame format. -->
            <field>
              <name>SYNC</name>
              <description>Frame Sync Relative Timing Bit\nOnly used in PSP frame format.</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>AFTER_DMYSTOP</name>
                  <description>Next frame is asserted after the end of the DMYSTOP timing.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AFTER_LSB</name>
                  <description>Next frame is asserted with the LSB of the previous frame.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DMYSTOP: Dummy stop\nOnly used in PSP frame format.\nDo not use in PSP Network mode, and must be 0 when worked in Network mode. -->
            <field>
              <name>DMYSTOP</name>
              <description>Dummy stop\nOnly used in PSP frame format.\nDo not use in PSP Network mode, and must be 0 when worked in Network mode.</description>
              <bitRange>[30:26]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- SPITCTL: SPI Test Control Register -->
        <register>
          <name>SPITCTL</name>
          <displayName>SPITCTL</displayName>
          <description>SPI Test Control Register</description>
          <addressOffset>0x00000040</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- LOOP: Loopback mode -->
            <field>
              <name>LOOP</name>
              <description>Loopback mode</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Normal serial port operation is enabled.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Output of TX serial shifter is internally connected to input of RX serial shifter.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- SPIBDCNT: SPI Baud Count Register -->
        <register>
          <name>SPIBDCNT</name>
          <displayName>SPIBDCNT</displayName>
          <description>SPI Baud Count Register</description>
          <addressOffset>0x00000044</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: SPI baud rate will be SPI clock / (SSPBDCNT+1) -->
            <field>
              <name>VAL</name>
              <description>SPI baud rate will be SPI clock / (SSPBDCNT+1)</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- SPIREGKEY: SPI Register Write-Allow Key Register -->
        <register>
          <name>SPIREGKEY</name>
          <displayName>SPIREGKEY</displayName>
          <description>SPI Register Write-Allow Key Register</description>
          <addressOffset>0x00000048</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x1ACCE551</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- KEY: Write 0x1ACCE551 to unlock protected SPI registers -->
            <field>
              <name>KEY</name>
              <description>Write 0x1ACCE551 to unlock protected SPI registers</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral derivedFrom="UART0">
      <name>UART1</name>
      <baseAddress>0x40001600</baseAddress>
      <interrupt>
         <name>UART1</name>
         <description>UART1 Interrupt</description>
         <value>8</value>
      </interrupt>
    </peripheral>

    <peripheral derivedFrom="SPI0">
      <name>SPI1</name>
      <baseAddress>0x40001700</baseAddress>
      <interrupt>
         <name>SPI1</name>
         <description>SPI1 Interrupt</description>
         <value>9</value>
      </interrupt>
    </peripheral>

    <peripheral>
      <name>TIMER0</name>
      <description></description>
      <groupName>TIMER</groupName>
      <baseAddress>0x40001800</baseAddress>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>32</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
         <name>TIMER0</name>
         <description>Timer 0 Interrupt</description>
         <value>50</value>
      </interrupt>
      <registers>

        <!-- TMRLOAD: Timer Load Register -->
        <register>
          <name>TMRLOAD</name>
          <displayName>TMRLOAD</displayName>
          <description>Timer Load Register</description>
          <addressOffset>0x00000000</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Load value from which the counter is to decrease.\nA write to this register sets the current counter value. -->
            <field>
              <name>VAL</name>
              <description>Load value from which the counter is to decrease.\nA write to this register sets the current counter value.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- TMRCNT: Timer Counter Value Register -->
        <register>
          <name>TMRCNT</name>
          <displayName>TMRCNT</displayName>
          <description>Timer Counter Value Register</description>
          <addressOffset>0x00000004</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Current value of timer counter.\nA write to this register sets the current counter value. -->
            <field>
              <name>VAL</name>
              <description>Current value of timer counter.\nA write to this register sets the current counter value.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- TMRCTL: Timer Control Register -->
        <register>
          <name>TMRCTL</name>
          <displayName>TMRCTL</displayName>
          <description>Timer Control Register</description>
          <addressOffset>0x00000008</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- EN: Timer enable -->
            <field>
              <name>EN</name>
              <description>Timer enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable Timer</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable Timer</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- MODE: Operation mode -->
            <field>
              <name>MODE</name>
              <description>Operation mode</description>
              <bitRange>[2:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>GENERAL_TIMER</name>
                  <description>General timer (down count)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GATED_TIMER</name>
                  <description>Down counter timer enabled by external input</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EVENT_COUNTER</name>
                  <description>Down counter for external input event</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EVENT_CAPTURE</name>
                  <description>Capture counter value upon external input event</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- HOLD: Hold counter value upon falling edge of TMRCTL.EN -->
            <field>
              <name>HOLD</name>
              <description>Hold counter value upon falling edge of TMRCTL.EN</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Reset counter to 0 upon falling edge of TMRCTL.EN</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Hold counter value upon falling edge of TMRCTL.EN</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- ADCSOCEN: ADCSOC generation enable -->
            <field>
              <name>ADCSOCEN</name>
              <description>ADCSOC generation enable</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Do not generate ADCSOC</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Generate ADCSOC whenever TMRCNT counts down to 0</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PWMSYNCEN: PWMSYNC generation enable -->
            <field>
              <name>PWMSYNCEN</name>
              <description>PWMSYNC generation enable</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Do not generate PWMSYNC</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Generate PWMSYNC whenever TMRCNT counts down to 0</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- EXTPOL: External input polarity -->
            <field>
              <name>EXTPOL</name>
              <description>External input polarity</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ACTIVE_LOW</name>
                  <description>Active low\nEnable counter when input is low for gated timer mode\nTrigger event upon falling edge of input for eevnt counter and event capture modes</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACTIVE_HIGH</name>
                  <description>Active high\nEnable counter when input is high for gated timer mode\nTrigger event upon rising edge of input for eevnt counter and event capture modes</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- EXTSEL: External input source select (GPIO number) -->
            <field>
              <name>EXTSEL</name>
              <description>External input source select (GPIO number)</description>
              <bitRange>[13:7]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- TMRRAWIF: Timer Raw Interrupt Flag Register -->
        <register>
          <name>TMRRAWIF</name>
          <displayName>TMRRAWIF</displayName>
          <description>Timer Raw Interrupt Flag Register</description>
          <addressOffset>0x0000000C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- INT: Raw timer interrupt flag.\nThis bit is set whenever TMRCNT counts down to 0 and cleared only by writing a 1 to TMRIC -->
            <field>
              <name>INT</name>
              <description>Raw timer interrupt flag.\nThis bit is set whenever TMRCNT counts down to 0 and cleared only by writing a 1 to TMRIC</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Raw interrupt does not occurre</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Raw interrupt occurred</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- TMRIF: Timer Interrupt Flag Register -->
        <register>
          <name>TMRIF</name>
          <displayName>TMRIF</displayName>
          <description>Timer Interrupt Flag Register</description>
          <addressOffset>0x00000010</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- INT: Masked timer interrupt flag\nThis bit is the logic AND of TMRRAWIF and TMRIE -->
            <field>
              <name>INT</name>
              <description>Masked timer interrupt flag\nThis bit is the logic AND of TMRRAWIF and TMRIE</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Masked interrupt does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Masked interrupt occurred and issued to CPU\nNo further interrupt will be issued until the flag is cleared</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- TMRIC: Timer Interrupt Clear Register -->
        <register>
          <name>TMRIC</name>
          <displayName>TMRIC</displayName>
          <description>Timer Interrupt Clear Register</description>
          <addressOffset>0x00000014</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- INT: Timer interrupt clear -->
            <field>
              <name>INT</name>
              <description>Timer interrupt clear</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write a 0 has no effect and always reads back 0.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Writing a 1 clears the TMRRAWIF and TMRIF flag\nThis bit is self-cleared to 0.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- TMRIE: Timer Interrupt Enable Register -->
        <register>
          <name>TMRIE</name>
          <displayName>TMRIE</displayName>
          <description>Timer Interrupt Enable Register</description>
          <addressOffset>0x00000018</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- INT: Timer interrupt enable.\nThis bit does not affect TMRRAWIF and PWMSYNC/ADCSOC generation -->
            <field>
              <name>INT</name>
              <description>Timer interrupt enable.\nThis bit does not affect TMRRAWIF and PWMSYNC/ADCSOC generation</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Do not issue interrupt to CPU</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Issue interrupt to CPU whenever TMRCNT counts down to 0</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- TMRREGKEY: Timer Register Write-Allow Key Register -->
        <register>
          <name>TMRREGKEY</name>
          <displayName>TMRREGKEY</displayName>
          <description>Timer Register Write-Allow Key Register</description>
          <addressOffset>0x0000001C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x1ACCE551</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- KEY: Write 0x1ACCE551 to unlock protected timer registers -->
            <field>
              <name>KEY</name>
              <description>Write 0x1ACCE551 to unlock protected timer registers</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral derivedFrom="TIMER0">
      <name>TIMER1</name>
      <baseAddress>0x40001900</baseAddress>
      <interrupt>
         <name>TIMER1</name>
         <description>Timer 1 Interrupt</description>
         <value>51</value>
      </interrupt>
    </peripheral>

    <peripheral derivedFrom="TIMER0">
      <name>TIMER2</name>
      <baseAddress>0x40001A00</baseAddress>
      <interrupt>
         <name>TIMER2</name>
         <description>Timer 2 Interrupt</description>
         <value>52</value>
      </interrupt>
    </peripheral>

    <peripheral>
      <name>FLASHC</name>
      <description></description>
      <groupName>FLASHC</groupName>
      <baseAddress>0x40001B00</baseAddress>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>100</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>

        <!-- FLASHCTL: Flash Control Register -->
        <register>
          <name>FLASHCTL</name>
          <displayName>FLASHCTL</displayName>
          <description>Flash Control Register</description>
          <addressOffset>0x00000000</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000010</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- COMMAND: Flash command -->
            <field>
              <name>COMMAND</name>
              <description>Flash command</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>POWER_UP</name>
                  <description>Power up</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>READ</name>
                  <description>Read</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PROG_WORD</name>
                  <description>Program word</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PROG_PAGE</name>
                  <description>Program page</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ERASE_SECTOR</name>
                  <description>Erase sector</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ERASE_CHIP</name>
                  <description>Erase chip</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RECALL_READ</name>
                  <description>Recall read</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SET_CONFIG</name>
                  <description>Set configuration</description>
                  <value>0x7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VERIFY_READ</name>
                  <description>Verify read</description>
                  <value>0xE</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>POWER_DOWN</name>
                  <description>Powe down</description>
                  <value>0xF</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DATAACCEPT: FLASHDIN cannot be changed when this bit is 0 -->
            <field>
              <name>DATAACCEPT</name>
              <description>FLASHDIN cannot be changed when this bit is 0</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>

            <!-- EXECUTION: Command is in execution -->
            <field>
              <name>EXECUTION</name>
              <description>Command is in execution</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>IDLE</name>
                  <description>Write a 0 has no effect\nRead a 0 indicates no command execution</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EXECUTION</name>
                  <description>Write a 1 starts a new command execution cycle.\nRead a 1 indicates command is still executing. It will change to 0 after execution is accomplished.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- XIPEN: XIP module enable -->
            <field>
              <name>XIPEN</name>
              <description>XIP module enable</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable XIP module</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable XIP module</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DWCACHE: Enable simple cache if the new address are in the same double-word as the last address -->
            <field>
              <name>DWCACHE</name>
              <description>Enable simple cache if the new address are in the same double-word as the last address</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable double-word cache</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable double-word cache</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DWCACHEWE: DWCACHE bit write enable.\nNeed to write as 1 at the same time when writing DWCACHE bit -->
            <field>
              <name>DWCACHEWE</name>
              <description>DWCACHE bit write enable.\nNeed to write as 1 at the same time when writing DWCACHE bit</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Write 1 enables concurrent write to DWCACHE. This bit is self-cleared to 0</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- FLASHADDR: Flash Address Register -->
        <register>
          <name>FLASHADDR</name>
          <displayName>FLASHADDR</displayName>
          <description>Flash Address Register</description>
          <addressOffset>0x00000008</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- ADDR: Flash address -->
            <field>
              <name>ADDR</name>
              <description>Flash address</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- FLASHDINL: Flash Data Input Low Word Register -->
        <register>
          <name>FLASHDINL</name>
          <displayName>FLASHDINL</displayName>
          <description>Flash Data Input Low Word Register</description>
          <addressOffset>0x00000010</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- DINL: Flash input low word data -->
            <field>
              <name>DINL</name>
              <description>Flash input low word data</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- FLASHDINH: Flash Data Input High Word Register -->
        <register>
          <name>FLASHDINH</name>
          <displayName>FLASHDINH</displayName>
          <description>Flash Data Input High Word Register</description>
          <addressOffset>0x00000014</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- DINH: Flash input high word data -->
            <field>
              <name>DINH</name>
              <description>Flash input high word data</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- FLASHDINE: Flash Data Input ECC Byte Register -->
        <register>
          <name>FLASHDINE</name>
          <displayName>FLASHDINE</displayName>
          <description>Flash Data Input ECC Byte Register</description>
          <addressOffset>0x00000018</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- DINE: Flash input ECC byte data\nIt is only effective when hardware ECC is disabled -->
            <field>
              <name>DINE</name>
              <description>Flash input ECC byte data\nIt is only effective when hardware ECC is disabled</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- FLASHDINP: Flash Data Input Pattern Register -->
        <register>
          <name>FLASHDINP</name>
          <displayName>FLASHDINP</displayName>
          <description>Flash Data Input Pattern Register</description>
          <addressOffset>0x0000001C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- PATTERN: Flash raw input pattern without ECC correction -->
            <field>
              <name>PATTERN</name>
              <description>Flash raw input pattern without ECC correction</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NONE</name>
                  <description>Input is set by FLASHDIN{E|H|L}</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ALL0</name>
                  <description>All 0&apos;s</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CB01</name>
                  <description>All 0x55 checkboard bytes</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CB10</name>
                  <description>All 0xAA checkboard bytes</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ALL1</name>
                  <description>All 1&apos;s</description>
                  <value>0x7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- FLASHDOUTL: Flash Data Output Low Word Register -->
        <register>
          <name>FLASHDOUTL</name>
          <displayName>FLASHDOUTL</displayName>
          <description>Flash Data Output Low Word Register</description>
          <addressOffset>0x00000020</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- DOUTL: Flash output low word data -->
            <field>
              <name>DOUTL</name>
              <description>Flash output low word data</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- FLASHDOUTH: Flash Data Output High Word Register -->
        <register>
          <name>FLASHDOUTH</name>
          <displayName>FLASHDOUTH</displayName>
          <description>Flash Data Output High Word Register</description>
          <addressOffset>0x00000024</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- DOUTH: Flash output high word data -->
            <field>
              <name>DOUTH</name>
              <description>Flash output high word data</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- FLASHDOUTE: Flash Data Output ECC Byte Register -->
        <register>
          <name>FLASHDOUTE</name>
          <displayName>FLASHDOUTE</displayName>
          <description>Flash Data Output ECC Byte Register</description>
          <addressOffset>0x00000028</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- DOUTE: Flash output ECC byte data -->
            <field>
              <name>DOUTE</name>
              <description>Flash output ECC byte data</description>
              <bitRange>[7:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- FLASHDOUTP: Flash Data Output Pattern Register -->
        <register>
          <name>FLASHDOUTP</name>
          <displayName>FLASHDOUTP</displayName>
          <description>Flash Data Output Pattern Register</description>
          <addressOffset>0x0000002C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- PATTERN: Flash raw output pattern without ECC correction -->
            <field>
              <name>PATTERN</name>
              <description>Flash raw output pattern without ECC correction</description>
              <bitRange>[2:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NONE</name>
                  <description>No special pattern recognied</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ALL0</name>
                  <description>All 0&apos;s</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CB01</name>
                  <description>All 0x55 checkboard bytes</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CB10</name>
                  <description>All 0xAA checkboard bytes</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ALL1</name>
                  <description>All 1&apos;s</description>
                  <value>0x7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- FLASHTIMING0: Flash Timing Register 0 -->
        <register>
          <name>FLASHTIMING0</name>
          <displayName>FLASHTIMING0</displayName>
          <description>Flash Timing Register 0</description>
          <addressOffset>0x00000040</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x0164000C</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- TUS:  -->
            <field>
              <name>TUS</name>
              <description></description>
              <bitRange>[8:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- TMS:  -->
            <field>
              <name>TMS</name>
              <description></description>
              <bitRange>[26:16]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- FLASHTIMING1: Flash Timing Register 1 -->
        <register>
          <name>FLASHTIMING1</name>
          <displayName>FLASHTIMING1</displayName>
          <description>Flash Timing Register 1</description>
          <addressOffset>0x00000044</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x03070726</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- TASRECALL:  -->
            <field>
              <name>TASRECALL</name>
              <description></description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- TMH:  -->
            <field>
              <name>TMH</name>
              <description></description>
              <bitRange>[13:8]</bitRange>
              <access>read-write</access>
            </field>

            <!-- TACCRECALL:  -->
            <field>
              <name>TACCRECALL</name>
              <description></description>
              <bitRange>[21:16]</bitRange>
              <access>read-write</access>
            </field>

            <!-- TACC:  -->
            <field>
              <name>TACC</name>
              <description></description>
              <bitRange>[29:24]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- FLASHTIMING2: Flash Timing Register 2 -->
        <register>
          <name>FLASHTIMING2</name>
          <displayName>FLASHTIMING2</displayName>
          <description>Flash Timing Register 2</description>
          <addressOffset>0x00000048</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x0000160B</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- TNVS:  -->
            <field>
              <name>TNVS</name>
              <description></description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>

