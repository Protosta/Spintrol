            <!-- SHSEL: SH select -->
            <field>
              <name>SHSEL</name>
              <description>SH select</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
