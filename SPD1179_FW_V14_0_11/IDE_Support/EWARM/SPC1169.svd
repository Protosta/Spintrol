                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Transfer complete interrupt was generated</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DC: Global destination transfer complete interrupt flag\nThis bit is the logic OR of DMATCIF bits -->
            <field>
