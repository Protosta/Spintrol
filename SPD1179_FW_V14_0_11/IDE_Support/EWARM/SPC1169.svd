                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- IF: Interrupt pending flag.\nNote: always write 0 to this field. -->
            <field>
              <name>IF</name>
              <description>Interrupt pending flag.\nNote: always write 0 to this field.</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCURED</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCURRED</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXREQ: Transmit request. -->
            <field>
              <name>TXREQ</name>
              <description>Transmit request.</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- LOST: Received message lost.\nNote: always write 0 to this field. -->
            <field>
              <name>LOST</name>
              <description>Received message lost.\nNote: always write 0 to this field.</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCURED</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCURRED</name>
                  <description>For reception: old message lost.\nFor transmission: data error occurred during transmission, MBCTL.EN will be cleared for this reason.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- NEW: New message. -->
            <field>
              <name>NEW</name>
              <description>New message.</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>OLD</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NEW</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RMTEN: Enable remote frame auto response. -->
            <field>
              <name>RMTEN</name>
              <description>Enable remote frame auto response.</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>DIR==0: transmit remote frame first, then wait receive data frame.\nDIR==1: wait receive remote frame first, then transmit message in mailbox.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DIR: Message data transfer direction on bus. -->
            <field>
              <name>DIR</name>
              <description>Message data transfer direction on bus.</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>RECEPTION</name>
                  <description>Wait receive data.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRANSMISSION</name>
                  <description>Wait transmit data.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- EN: Enable mailbox -->
            <field>
              <name>EN</name>
              <description>Enable mailbox</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
