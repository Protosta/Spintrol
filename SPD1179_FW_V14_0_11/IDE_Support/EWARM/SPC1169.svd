                  <name>NOT_OCCUR</name>
                  <description>No SOC2 interrupt overflow</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>SOC2 interrupt overflow</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SOC3: SOC3 (Start of Conversion) overflow flag\nThis indicates an SOC3 interrupt was generated while an existing SOC3 interrupt was already pending. This overflow flag can&apos;t stop SOC3 interrupts from being processing. It just show that a trigger was missed.  -->
            <field>
              <name>SOC3</name>
              <description>SOC3 (Start of Conversion) overflow flag\nThis indicates an SOC3 interrupt was generated while an existing SOC3 interrupt was already pending. This overflow flag can&apos;t stop SOC3 interrupts from being processing. It just show that a trigger was missed. </description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
