    <peripheral>
      <name>ECAP</name>
      <description></description>
      <groupName>ECAP</groupName>
      <baseAddress>0x40003400</baseAddress>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>60</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
         <name>ECAP</name>
         <description>ECAP Interrupt</description>
         <value>48</value>
      </interrupt>
      <registers>

        <!-- CAPSRCCTL: Capture Source Input Control Register -->
        <register>
          <name>CAPSRCCTL</name>
          <displayName>CAPSRCCTL</displayName>
          <description>Capture Source Input Control Register</description>
          <addressOffset>0x00000000</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00010001</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- POL: Source input polarity -->
            <field>
              <name>POL</name>
              <description>Source input polarity</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ACTIVE_LOW</name>
                  <description>Active low</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACTIVE_HIGH</name>
                  <description>Active high</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- IOSEL: GPIO number to be selected as capture input -->
            <field>
              <name>IOSEL</name>
              <description>GPIO number to be selected as capture input</description>
              <bitRange>[7:1]</bitRange>
              <access>read-write</access>
            </field>

            <!-- POL1: Source input polarity for the 2nd pin in dual pin mode -->
            <field>
              <name>POL1</name>
              <description>Source input polarity for the 2nd pin in dual pin mode</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ACTIVE_LOW</name>
                  <description>Active low</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACTIVE_HIGH</name>
                  <description>Active high</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- IOSEL1: GPIO number to be selected as 2nd capture input in dual pin mode -->
            <field>
              <name>IOSEL1</name>
              <description>GPIO number to be selected as 2nd capture input in dual pin mode</description>
              <bitRange>[23:17]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- CAPSYNCICTL: Capture Synchronization Source Input Control Register -->
        <register>
          <name>CAPSYNCICTL</name>
          <displayName>CAPSYNCICTL</displayName>
          <description>Capture Synchronization Source Input Control Register</description>
          <addressOffset>0x00000004</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- POL: Source input polarity -->
            <field>
              <name>POL</name>
              <description>Source input polarity</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ACTIVE_LOW</name>
                  <description>Active low</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACTIVE_HIGH</name>
                  <description>Active high</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- IOSEL: GPIO number to be selected as sync input -->
            <field>
              <name>IOSEL</name>
              <description>GPIO number to be selected as sync input</description>
              <bitRange>[7:1]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- CAPTSCNT: Time-Stamp Counter Register -->
        <register>
          <name>CAPTSCNT</name>
          <displayName>CAPTSCNT</displayName>
          <description>Time-Stamp Counter Register</description>
          <addressOffset>0x00000008</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Active 32-bit counter register that is used as the capture time-base. -->
            <field>
              <name>VAL</name>
              <description>Active 32-bit counter register that is used as the capture time-base.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- CAPCNTPHS: Counter Phase Offset Value Register -->
        <register>
          <name>CAPCNTPHS</name>
          <displayName>CAPCNTPHS</displayName>
          <description>Counter Phase Offset Value Register</description>
          <addressOffset>0x0000000C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Counter phase value register that can be programmed for phase lag/lead. -->
            <field>
              <name>VAL</name>
              <description>Counter phase value register that can be programmed for phase lag/lead.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- CAP0: Capture Register 0 -->
        <register>
          <name>CAP0</name>
          <displayName>CAP0</displayName>
          <description>Capture Register 0</description>
          <addressOffset>0x00000010</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: In capture mode\n-This register is loaded from time-stamp counter (CAPTSCNT) upon a capture event 0.\n\nIn APWM mode\n-Writting to this register set the active value of PRD, and also update CAP2 with the same value. This emulates the immediate mode.\n- Upon CAPTSCNT=PRD (CAP0), this register is updated as CAP2. This emulates the shadow mode. -->
            <field>
              <name>VAL</name>
              <description>In capture mode\n-This register is loaded from time-stamp counter (CAPTSCNT) upon a capture event 0.\n\nIn APWM mode\n-Writting to this register set the active value of PRD, and also update CAP2 with the same value. This emulates the immediate mode.\n- Upon CAPTSCNT=PRD (CAP0), this register is updated as CAP2. This emulates the shadow mode.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- CAP1: Capture Register 1 -->
        <register>
          <name>CAP1</name>
          <displayName>CAP1</displayName>
          <description>Capture Register 1</description>
          <addressOffset>0x00000014</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: In capture mode\n-This register is loaded from time-stamp counter (CAPTSCNT) upon a capture event 1.\n\nIn APWM mode\n-Writting to this register set the active value of CMP, and also update CAP3 with the same value. This emulates the immediate mode.\n- Upon CAPTSCNT=PRD (CAP0), this register is updated as CAP3. This emulates the shadow mode. -->
            <field>
              <name>VAL</name>
              <description>In capture mode\n-This register is loaded from time-stamp counter (CAPTSCNT) upon a capture event 1.\n\nIn APWM mode\n-Writting to this register set the active value of CMP, and also update CAP3 with the same value. This emulates the immediate mode.\n- Upon CAPTSCNT=PRD (CAP0), this register is updated as CAP3. This emulates the shadow mode.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- CAP2: Capture Register 2 -->
        <register>
          <name>CAP2</name>
          <displayName>CAP2</displayName>
          <description>Capture Register 2</description>
          <addressOffset>0x00000018</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: In capture mode\n-This register is loaded from time-stamp counter (CAPTSCNT) upon a capture event 2.\n\nIn APWM mode\n-Writting to this register set the shadow value of PRD. Upon CAPTSCNT=PRD (CAP0), CAP0 will be updated to the value of this register. This emulates the shadow mode. -->
            <field>
              <name>VAL</name>
              <description>In capture mode\n-This register is loaded from time-stamp counter (CAPTSCNT) upon a capture event 2.\n\nIn APWM mode\n-Writting to this register set the shadow value of PRD. Upon CAPTSCNT=PRD (CAP0), CAP0 will be updated to the value of this register. This emulates the shadow mode.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- CAP3: Capture Register 3 -->
        <register>
          <name>CAP3</name>
          <displayName>CAP3</displayName>
          <description>Capture Register 3</description>
          <addressOffset>0x0000001C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: In capture mode\n-This register is loaded from time-stamp counter (CAPTSCNT) upon a capture event 3.\n\nIn APWM mode\n-Writting to this register set the shadow value of CMP. Upon CAPTSCNT=PRD (CAP0), CAP1 will be updated to the value of this register. This emulates the shadow mode. -->
            <field>
              <name>VAL</name>
              <description>In capture mode\n-This register is loaded from time-stamp counter (CAPTSCNT) upon a capture event 3.\n\nIn APWM mode\n-Writting to this register set the shadow value of CMP. Upon CAPTSCNT=PRD (CAP0), CAP1 will be updated to the value of this register. This emulates the shadow mode.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- CAPCTL: Capture Control Register -->
        <register>
          <name>CAPCTL</name>
          <displayName>CAPCTL</displayName>
          <description>Capture Control Register</description>
          <addressOffset>0x00000020</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x000C0000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- CAP0POL: Capture event 0 polarity select -->
            <field>
              <name>CAP0POL</name>
              <description>Capture event 0 polarity select</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>TRIG_ON_FALLING_EDGE</name>
                  <description>Triggered on a falling edge</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRIG_ON_RISING_EDGE</name>
                  <description>Triggered on a rising edge</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CNTRST0: Counter reset on capture event 0 -->
            <field>
              <name>CNTRST0</name>
              <description>Counter reset on capture event 0</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Do not reset counter</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Reset counter</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CAP1POL: Capture event 1 polarity select -->
            <field>
              <name>CAP1POL</name>
              <description>Capture event 1 polarity select</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>TRIG_ON_FALLING_EDGE</name>
                  <description>Triggered on a falling edge</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRIG_ON_RISING_EDGE</name>
                  <description>Triggered on a rising edge</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CNTRST1: Counter reset on capture event 1 -->
            <field>
              <name>CNTRST1</name>
              <description>Counter reset on capture event 1</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Do not reset counter</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Reset counter</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CAP2POL: Capture event 2 polarity select -->
            <field>
              <name>CAP2POL</name>
              <description>Capture event 2 polarity select</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>TRIG_ON_FALLING_EDGE</name>
                  <description>Triggered on a falling edge</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRIG_ON_RISING_EDGE</name>
                  <description>Triggered on a rising edge</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CNTRST2: Counter reset on capture event 2 -->
            <field>
              <name>CNTRST2</name>
              <description>Counter reset on capture event 2</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Do not reset counter</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Reset counter</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CAP3POL: Capture event 3 polarity select -->
            <field>
              <name>CAP3POL</name>
              <description>Capture event 3 polarity select</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>TRIG_ON_FALLING_EDGE</name>
                  <description>Triggered on a falling edge</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRIG_ON_RISING_EDGE</name>
                  <description>Triggered on a rising edge</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CNTRST3: Counter reset on capture event 3 -->
            <field>
              <name>CNTRST3</name>
              <description>Counter reset on capture event 3</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Do not reset counter</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Reset counter</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CAPLDEN: Enable CAP0-3 loading on a capture event.\nThis bit does not affect the generation of CEVT0-3 events -->
            <field>
              <name>CAPLDEN</name>
              <description>Enable CAP0-3 loading on a capture event.\nThis bit does not affect the generation of CEVT0-3 events</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- EVTDIV: Event Filter prescale select -->
            <field>
              <name>EVTDIV</name>
              <description>Event Filter prescale select</description>
              <bitRange>[16:9]</bitRange>
              <access>read-write</access>
            </field>

            <!-- ONESHOT: One-shot mode enable (applicable only in capture mode) -->
            <field>
              <name>ONESHOT</name>
              <description>One-shot mode enable (applicable only in capture mode)</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Operate in continuous mode</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Operate in one-shot mode</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- STOPWRAP: Stop value for one-shot mode\nThis is the number (between 0-3) of captures allowed to occur before the CAP(0-3) registers are frozen, i.e., capture sequence is stopped.\nWrap value for continuous mode. This is the number (between 0-3) of the capture register in which the circular buffer wraps around and starts again.\nNotes: Following 2 actions occurs when MOD4=STOPWRAP:\n- MOD4 counter is stopped (frozen)\n- Capture register loads are inhibited. In one-shot mode, further interrupt events are blocked until re-armed. -->
            <field>
              <name>STOPWRAP</name>
              <description>Stop value for one-shot mode\nThis is the number (between 0-3) of captures allowed to occur before the CAP(0-3) registers are frozen, i.e., capture sequence is stopped.\nWrap value for continuous mode. This is the number (between 0-3) of the capture register in which the circular buffer wraps around and starts again.\nNotes: Following 2 actions occurs when MOD4=STOPWRAP:\n- MOD4 counter is stopped (frozen)\n- Capture register loads are inhibited. In one-shot mode, further interrupt events are blocked until re-armed.</description>
              <bitRange>[19:18]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ON_CAPTURE_EVENT0</name>
                  <description>Stop after capture event 0 in one-shot mode.\nWrap after capture event 0 in continuous mode.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ON_CAPTURE_EVENT1</name>
                  <description>Stop after capture event 1 in one-shot mode.\nWrap after capture event 1 in continuous mode.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ON_CAPTURE_EVENT2</name>
                  <description>Stop after capture event 2 in one-shot mode.\nWrap after capture event 2 in continuous mode.</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ON_CAPTURE_EVENT3</name>
                  <description>Stop after capture event 3 in one-shot mode.\nWrap after capture event 3 in continuous mode.</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- REARM: One-shot re-arming control. -->
            <field>
              <name>REARM</name>
              <description>One-shot re-arming control.</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORCE</name>
                  <description>Write 1 forces events below. This bit is self-cleared.\n- Resets the MOD4 counter to zero\n- Unfreezes the MOD4 counter\n- Enables capture register loads\n- Reset event prescaler</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TSCNTRUN: Time stamp counter run/stop control -->
            <field>
              <name>TSCNTRUN</name>
              <description>Time stamp counter run/stop control</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>STOP_COUNTER</name>
                  <description>Stop counting</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>START_COUNTER</name>
                  <description>Free running</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PHSEN: Phase synchronization enable -->
            <field>
              <name>PHSEN</name>
              <description>Phase synchronization enable</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable synchronization</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable counter (CAPTSCNT) to be loaded from CAPCNTPHS register upon either a SYNCI signal or a S/W force event</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SYNCOSEL: Sync-Out Select -->
            <field>
              <name>SYNCOSEL</name>
              <description>Sync-Out Select</description>
              <bitRange>[24:23]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE_SYNC_OUT</name>
                  <description>Disable sync out signal</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SYNC_IN</name>
                  <description>Select sync-in event to be the sync-out signal (pass through)</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CNT_EQU_PRD</name>
                  <description>Select CNT = PRD event to be the sync-out signal</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- FRCSYNC: Software-forced counter synchronizing. -->
            <field>
              <name>FRCSYNC</name>
              <description>Software-forced counter synchronizing.</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORCE</name>
                  <description>Write 1 forces a sync event. This bit is self-cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- APWMMODE: CAP/APWM operating mode select\n -->
            <field>
              <name>APWMMODE</name>
              <description>CAP/APWM operating mode select\n</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CAPTURE_MODE</name>
                  <description>ECAP module operates in capture mode. This mode forces the following configuration:\n- Inhibits counter reset via CNT = PRD event\n- Inhibits shadow load on CAP0 and CAP1 registers\n- Permits user to enable CAP0-3 register load\n- CAPx/APWMx pin operates as a capture input</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>APWM_MODE</name>
                  <description>ECAP module operates in APWM mode. This mode forces the following configuration:\n- Resets counter on CNT = PRD event (period boundary\n- Permits shadow loading on CAP0 and CAP1 registers\n- Disables loading of time-stamps into CAP0-3 registers\n- CAPx/APWMx pin operates as a APWM output</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- APWMPOL: APWM output polarity select. This is applicable only in APWM operating mode. -->
            <field>
              <name>APWMPOL</name>
              <description>APWM output polarity select. This is applicable only in APWM operating mode.</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ACTIVE_LOW</name>
                  <description>Output is active low (i.e., CMP defines duration for output low)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACTIVE_HIGH</name>
                  <description>Output is active high (i.e., CMP defines duration for output high)</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DBGRUN: ECAP counter behaviour when CPU is halted\nNote: Debug operation and CPU fault exceptions both can cause CPU halted. -->
            <field>
              <name>DBGRUN</name>
              <description>ECAP counter behaviour when CPU is halted\nNote: Debug operation and CPU fault exceptions both can cause CPU halted.</description>
              <bitRange>[29:28]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>STOP_IMMEDIATELY</name>
                  <description>Counter stops immediately when CPU is halted</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>STOP_AT_ZERO</name>
                  <description>Counter runs until 0 when CPU is halted</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>KEEP_RUNNING</name>
                  <description>Counter is unaffected when CPU is halted</description>
                  <value>0x2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- EVTDIVRST: Event divider reset -->
            <field>
              <name>EVTDIVRST</name>
              <description>Event divider reset</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RESET</name>
                  <description>Write 1 resets the event divider. This bit is self-cleared</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DUALPIN: Dual pin capture mode -->
            <field>
              <name>DUALPIN</name>
              <description>Dual pin capture mode</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>CAP0 ~ CAP3 are used for capture the single pin</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Use CAP0/CAP2 to capture one pin and CAP1/CAP3 to capture the other</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- CAPRAWIF: Capture Interrupt Raw Flag Register -->
        <register>
          <name>CAPRAWIF</name>
          <displayName>CAPRAWIF</displayName>
          <description>Capture Interrupt Raw Flag Register</description>
          <addressOffset>0x00000024</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- CEVT0: Capture event 0 raw flag.\nThis flag is only active in CAP mode. -->
            <field>
              <name>CEVT0</name>
              <description>Capture event 0 raw flag.\nThis flag is only active in CAP mode.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
