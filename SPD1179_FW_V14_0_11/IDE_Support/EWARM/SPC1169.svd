        <!-- ADCSOCOVFC: ADC SOC Overflow Clear Register -->
        <register>
          <name>ADCSOCOVFC</name>
          <displayName>ADCSOCOVFC</displayName>
          <description>ADC SOC Overflow Clear Register</description>
          <addressOffset>0x00000024</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- SOC0: Clear SOC0 overflow flag\nIf this bit receive a request to set from software and hardware try to set respective SOC0 overflow bit in ADCSOCOVF register simultaneously, then software has priority and ADCSOCOVF register will be cleared.  -->
            <field>
              <name>SOC0</name>
              <description>Clear SOC0 overflow flag\nIf this bit receive a request to set from software and hardware try to set respective SOC0 overflow bit in ADCSOCOVF register simultaneously, then software has priority and ADCSOCOVF register will be cleared. </description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write a 0 has no effect and always read back 0.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write a 1 clears the flag. This bit is self-cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

