          <description>ADC Gain Trim Register [%s]</description>
          <addressOffset>0x000000B8</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00008000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Gain trimming (VAL/32768) for ADCRESULT0 -->
            <field>
              <name>VAL</name>
              <description>Gain trimming (VAL/32768) for ADCRESULT0</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- SHOFFSET: ADC SH0 Offset Trim Register -->
        <register>
          <!-- dimElementGroup -->
          <dim>1</dim>
          <dimIncrement>4</dimIncrement>
