                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORCE_LOW</name>
                  <description>Force SH0 positve input tied low</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORCE_HIGH</name>
                  <description>Force SH0 positve input tied high</description>
