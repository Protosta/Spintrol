          <fields>

            <!-- TZU: Action on output A when a trip event occurs and TBCNT is counting up -->
            <field>
              <name>TZU</name>
              <description>Action on output A when a trip event occurs and TBCNT is counting up</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>TRI_STATE</name>
                  <description>Set output A to high-impedance</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SET_LOW</name>
                  <description>Force output A to low state</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SET_HIGH</name>
                  <description>Force output A to high state</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TOGGLE</name>
                  <description>Force output A to invert current state (high-&amp;gt;low, low-&amp;gt;high)</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DO_NOTHING</name>
                  <description>Do nothing for output A</description>
                  <value>0x7</value>
