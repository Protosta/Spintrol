                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Event does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Event occurred</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- VDD12OV: Latched VDD12 over-volage event flag -->
            <field>
