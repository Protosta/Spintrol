              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>0-byte.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>1-byte.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>2-bytes.</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
                  <description>3-bytes.</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4</name>
                  <description>4-bytes.</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>5</name>
                  <description>5-bytes.</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>6</name>
                  <description>6-bytes.</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>7</name>
                  <description>7-bytes.</description>
                  <value>0x7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>8</name>
                  <description>8-bytes.</description>
                  <value>0x8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>12</name>
                  <description>12-bytes, valid for CANFD only.\nIf set for CAN format, DLC force to 8-bytes.</description>
                  <value>0x9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>16</name>
                  <description>16-bytes, valid for CANFD only.\nIf set for CAN format, DLC force to 8-bytes.</description>
                  <value>0xA</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>20</name>
                  <description>20-bytes, valid for CANFD only.\nIf set for CAN format, DLC force to 8-bytes.</description>
                  <value>0xB</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>24</name>
                  <description>24-bytes, valid for CANFD only.\nIf set for CAN format, DLC force to 8-bytes.</description>
                  <value>0xC</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>32</name>
                  <description>32-bytes, valid for CANFD only.\nIf set for CAN format, DLC force to 8-bytes.</description>
                  <value>0xD</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>48</name>
