                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- IF: Interrupt pending flag.\nNote: always write 0 to this field. -->
            <field>
              <name>IF</name>
