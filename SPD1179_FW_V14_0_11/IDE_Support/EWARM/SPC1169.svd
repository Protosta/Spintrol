            <!-- DBFED: DBFED shadow status -->
            <field>
              <name>DBFED</name>
              <description>DBFED shadow status</description>
              <bitRange>[10:10]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EMPTY</name>
                  <description>A load from DBFED to DBFEDA clears this bit</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
