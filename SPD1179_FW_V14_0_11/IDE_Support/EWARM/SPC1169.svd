                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CARE</name>
                  <description>This bit in the message identifier is used for acceptance filtering.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
