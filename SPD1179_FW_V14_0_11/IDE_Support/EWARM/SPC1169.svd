                  <value>0xB</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>24</name>
                  <description>24-bytes, valid for CANFD only.\nIf set for CAN format, DLC force to 8-bytes.</description>
                  <value>0xC</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>32</name>
