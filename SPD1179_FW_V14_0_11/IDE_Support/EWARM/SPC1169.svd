          <name>PPUIE[%s]</name>
          <displayName>PPUIE[%s]</displayName>
          <description>PPU Interrupt Enable Register [%s]</description>
          <addressOffset>0x00000208</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- TZUV: Enable under-voltage event as interrupt source -->
            <field>
              <name>TZUV</name>
