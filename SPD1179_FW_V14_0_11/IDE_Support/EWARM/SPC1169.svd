          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- COMPL: Latched COMPFLTOUT[COMPL] -->
            <field>
              <name>COMPL</name>
              <description>Latched COMPFLTOUT[COMPL]</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LOW</name>
                  <description>Input has been higher than the low-boundary</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HIGH</name>
                  <description>Input has been lower than the low-boundary</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- COMPH: Latched COMPFLTOUT[COMPH] -->
            <field>
              <name>COMPH</name>
              <description>Latched COMPFLTOUT[COMPH]</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LOW</name>
                  <description>Input has been lower than the high-boundary</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
