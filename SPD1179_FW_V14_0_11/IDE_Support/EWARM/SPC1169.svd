          <fields>

            <!-- BYTE0: Byte (4 * N + 0) of CAN frame, N is CANMBOXFDW index. -->
            <field>
              <name>BYTE0</name>
              <description>Byte (4 * N + 0) of CAN frame, N is CANMBOXFDW index.</description>
              <bitRange>[7:0]</bitRange>
