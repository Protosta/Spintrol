                <enumeratedValue>
                  <name>NEW</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RMTEN: Enable remote frame auto response. -->
            <field>
              <name>RMTEN</name>
              <description>Enable remote frame auto response.</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>DIR==0: transmit remote frame first, then wait receive data frame.\nDIR==1: wait receive remote frame first, then transmit message in mailbox.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DIR: Message data transfer direction on bus. -->
            <field>
              <name>DIR</name>
              <description>Message data transfer direction on bus.</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
