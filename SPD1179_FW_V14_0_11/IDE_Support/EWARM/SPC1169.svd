              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_SWAP</name>
                  <description>Not swap BJT</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SWAP</name>
                  <description>Swap BJT</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
