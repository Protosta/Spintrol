                  <description>Enable event TBCNT=CMPC when TBCNT is counting up</description>
                  <value>0x7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TBCNT_EQU_CMPC_DOWN</name>
                  <description>Enable event TBCNT=CMPC when TBCNT is counting down</description>
