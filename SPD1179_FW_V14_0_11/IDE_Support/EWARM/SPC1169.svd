          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- KEY: Write 0x1ACCE551 to unlock protected I2C registers.\nThe 28 MSBs of this register cannot be 0x5555555 -->
            <field>
              <name>KEY</name>
              <description>Write 0x1ACCE551 to unlock protected I2C registers.\nThe 28 MSBs of this register cannot be 0x5555555</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>CRC</name>
      <description></description>
      <groupName>CRC</groupName>
      <baseAddress>0x40003600</baseAddress>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>40</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
         <name>CRC</name>
         <description>CRC Interrupt </description>
         <value>53</value>
      </interrupt>
      <registers>

        <!-- CRCCTL: CRC Control Register -->
        <register>
          <name>CRCCTL</name>
          <displayName>CRCCTL</displayName>
          <description>CRC Control Register</description>
          <addressOffset>0x00000000</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- EN: CRC calculate enable -->
            <field>
              <name>EN</name>
              <description>CRC calculate enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable CRC calculation</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable CRC calculation</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- MODE: CRC mode select -->
            <field>
              <name>MODE</name>
              <description>CRC mode select</description>
              <bitRange>[3:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>8_AUTOSAR</name>
                  <description>x^8+x^5+x^3+x^2+x+1</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>15_CAN</name>
                  <description>x^15+x^14+x^10+x^8+x^7+x^4+x^3+1 (CRC-15-CAN)</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>16_CCITT</name>
                  <description>x^16+x^12+x^5+1 (CRC-16-CCITT)</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>16_IBM</name>
                  <description>x^16+x^15+x^2+1 (CRC-16-IBM)</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>16_T10_DIF</name>
                  <description>x^16+x^15+x^11+x^9+x^8+x^7+x^5+x^4+x^2+x+1 (CRC-16-T10-DIF)</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>16_DNP</name>
                  <description>x^16+x^13+x^12+x^11+x^10+x^8+x^6+x^5+x^2+1(CRC-16-DNP)</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>17_CAN</name>
                  <description>x^17+x^16+x^14+x^13+x^11+x^6+x^4+x^3+x+1 (CRC-17-CAN)</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>32_IEEE802P3</name>
                  <description>x^32+x^26+x^23+x^22+x^16+x^12+x^11+x^10+x^8+x^7+x^5+x^4+x^2+x+1 (CRC-32-IEEE802.3)</description>
                  <value>0x7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CONTINUOUS: Continuous frame calculation -->
            <field>
              <name>CONTINUOUS</name>
              <description>Continuous frame calculation</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Internal register will be cleared when CRCCTL.EN=0 so next frame calculation is a fresh new start</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Internal register hold the value when CRCCTL.EN=0 so next frame calculation is continous to current one</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- ENDIANIN: Input data endian (per byte) -->
            <field>
              <name>ENDIANIN</name>
              <description>Input data endian (per byte)</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LITTLE_ENDIAN</name>
                  <description>LSB is firstly sent into the LFSR per byte</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BIG_ENDIAN</name>
                  <description>MSB is firstly sent into the LFSR per byte</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- ENDIANOUT: Output result endian -->
            <field>
              <name>ENDIANOUT</name>
              <description>Output result endian</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LITTLE_ENDIAN</name>
                  <description>LSB is last stage in LFSR</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BIG_ENDIAN</name>
                  <description>LSB is first stage in LFSR</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- INVIN: Bitwise NOT of the input data -->
            <field>
              <name>INVIN</name>
              <description>Bitwise NOT of the input data</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Put the original data into LFSR</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Put the bitwise NOT of the data into LFSR</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- INVOUT: Bitwise NOT of the output result -->
            <field>
              <name>INVOUT</name>
              <description>Bitwise NOT of the output result</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Output result is the original value in LFSR</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Output result is the bitwise NOT of value in LFSR</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PERBYTE: Set the data format for each write to the CRCSTRIN register -->
            <field>
              <name>PERBYTE</name>
              <description>Set the data format for each write to the CRCSTRIN register</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PER_WORD</name>
                  <description>CRCSTRIN is written per word (4 bytes)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PER_BYTE</name>
                  <description>CRCSTRIN is written per byte</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- CRCSTRLEN: CRC Stream Length Register -->
        <register>
          <name>CRCSTRLEN</name>
          <displayName>CRCSTRLEN</displayName>
          <description>CRC Stream Length Register</description>
          <addressOffset>0x00000004</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Input stream length minus 1 (in unit of byte)\n -->
            <field>
              <name>VAL</name>
              <description>Input stream length minus 1 (in unit of byte)\n</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- CRCSEED: CRC Seed Register -->
        <register>
          <name>CRCSEED</name>
          <displayName>CRCSEED</displayName>
          <description>CRC Seed Register</description>
          <addressOffset>0x00000008</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Set the LFSR values to the seed -->
            <field>
              <name>VAL</name>
              <description>Set the LFSR values to the seed</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- CRCSTRIN: CRC Stream Input Register -->
        <register>
          <name>CRCSTRIN</name>
          <displayName>CRCSTRIN</displayName>
          <description>CRC Stream Input Register</description>
          <addressOffset>0x0000000C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Stream Input data register\nThe 24 MSBs will be always read as 0 if CRCCTLEN.PERBYTE=1 -->
            <field>
              <name>VAL</name>
              <description>Stream Input data register\nThe 24 MSBs will be always read as 0 if CRCCTLEN.PERBYTE=1</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- CRCRESULT: CRC Result Register -->
        <register>
          <name>CRCRESULT</name>
          <displayName>CRCRESULT</displayName>
          <description>CRC Result Register</description>
          <addressOffset>0x00000010</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: CRC calculation result -->
            <field>
              <name>VAL</name>
              <description>CRC calculation result</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- CRCRAWIF: CRC Raw Interrupt Flag Register -->
        <register>
          <name>CRCRAWIF</name>
          <displayName>CRCRAWIF</displayName>
          <description>CRC Raw Interrupt Flag Register</description>
          <addressOffset>0x00000014</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- DONE: Unmasked CRC calculation done interrupt flag -->
            <field>
              <name>DONE</name>
              <description>Unmasked CRC calculation done interrupt flag</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>CRC calculation is not done</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>CRC calculation is done</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- STROVF: Unmasked CRC stream overflow interrupt flag -->
            <field>
              <name>STROVF</name>
              <description>Unmasked CRC stream overflow interrupt flag</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Input stream does not overflow</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Input stream exceeds the specified length</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- CRCIF: CRC Interrupt Flag Register -->
        <register>
          <name>CRCIF</name>
          <displayName>CRCIF</displayName>
          <description>CRC Interrupt Flag Register</description>
          <addressOffset>0x00000018</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- DONE: Masked CRC calculation done interrupt flag -->
            <field>
              <name>DONE</name>
              <description>Masked CRC calculation done interrupt flag</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Interrupt does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Interrupt occurred.\nFurther event will not generate interrupt until this bit is cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- STROVF: Masked CRC stream overflow interrupt flag -->
            <field>
              <name>STROVF</name>
              <description>Masked CRC stream overflow interrupt flag</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Interrupt does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Interrupt occurred.\nFurther event will not generate interrupt until this bit is cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- INT: Global CRC interrupt flag issued to CPU -->
            <field>
              <name>INT</name>
              <description>Global CRC interrupt flag issued to CPU</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>No interrupt was issued to CPU</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Interrupt was issued to CPU.\nFurther interrupt will not be generated until this bit is cleared</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- CRCIC: CRC Interrupt Clear Register -->
        <register>
          <name>CRCIC</name>
          <displayName>CRCIC</displayName>
          <description>CRC Interrupt Clear Register</description>
          <addressOffset>0x0000001C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- DONE: CRC calculation done interrupt clear -->
            <field>
              <name>DONE</name>
              <description>CRC calculation done interrupt clear</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write a 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write a 1 clears DONE bit in both CRCRAWIF and CRCIF\nThis bit is self-cleared to 0</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- STROVF: CRC stream overflow interrupt clear -->
            <field>
              <name>STROVF</name>
              <description>CRC stream overflow interrupt clear</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write a 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write a 1 clears STROVF bit in both CRCRAWIF and CRCIF\nThis bit is self-cleared to 0</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- INT: Global CRC interrupt clear -->
            <field>
              <name>INT</name>
              <description>Global CRC interrupt clear</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write a 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write a 1 clears both CRCIF.INT\nThis bit is self-cleared to 0</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- CRCIE: CRC Interrupt Enable Register -->
        <register>
          <name>CRCIE</name>
          <displayName>CRCIE</displayName>
          <description>CRC Interrupt Enable Register</description>
          <addressOffset>0x00000020</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- DONE: CRC calculation done interrupt enable -->
            <field>
              <name>DONE</name>
              <description>CRC calculation done interrupt enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- STROVF: CRC stream overflow interrupt enable -->
            <field>
              <name>STROVF</name>
              <description>CRC stream overflow interrupt enable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- CRCREGKEY: CRC Register Write-Allow Key Register -->
        <register>
          <name>CRCREGKEY</name>
          <displayName>CRCREGKEY</displayName>
          <description>CRC Register Write-Allow Key Register</description>
          <addressOffset>0x00000024</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x1ACCE551</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- KEY: Write 0x1ACCE551 to unlock protected CRC registers -->
            <field>
              <name>KEY</name>
              <description>Write 0x1ACCE551 to unlock protected CRC registers</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>CANMBOX0</name>
      <description></description>
      <groupName>CANMBOX</groupName>
      <baseAddress>0X40004000</baseAddress>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>80</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>

        <!-- CANMBOXFDW: Mailbox Data Word Register -->
        <register>
          <!-- dimElementGroup -->
          <dim>16</dim>
          <dimIncrement>4</dimIncrement>
          <!-- end of dimElementGroup -->
          <name>CANMBOXFDW[%s]</name>
          <displayName>CANMBOXFDW[%s]</displayName>
          <description>Mailbox Data Word Register</description>
          <addressOffset>0x00000000</addressOffset>
          <!-- registerPropertiesGroup -->
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- BYTE0: Byte (4 * N + 0) of CAN frame, N is CANMBOXFDW index. -->
            <field>
              <name>BYTE0</name>
              <description>Byte (4 * N + 0) of CAN frame, N is CANMBOXFDW index.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- BYTE1: Byte (4 * N + 1) of CAN frame, N is CANMBOXFDW index. -->
            <field>
              <name>BYTE1</name>
              <description>Byte (4 * N + 1) of CAN frame, N is CANMBOXFDW index.</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>

            <!-- BYTE2: Byte (4 * N + 2) of CAN frame, N is CANMBOXFDW index. -->
            <field>
              <name>BYTE2</name>
              <description>Byte (4 * N + 2) of CAN frame, N is CANMBOXFDW index.</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>

            <!-- BYTE3: Byte (4 * N + 3) of CAN frame, N is CANMBOXFDW index. -->
            <field>
              <name>BYTE3</name>
              <description>Byte (4 * N + 3) of CAN frame, N is CANMBOXFDW index.</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- CANMBOXFMSK: Mailbox Frame Mask Register -->
        <register>
          <name>CANMBOXFMSK</name>
          <displayName>CANMBOXFMSK</displayName>
          <description>Mailbox Frame Mask Register</description>
          <addressOffset>0x00000040</addressOffset>
          <!-- registerPropertiesGroup -->
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- ID: Identifier mask. -->
            <field>
              <name>ID</name>
              <description>Identifier mask.</description>
              <bitRange>[28:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- IDE: Identifier extension bit mask. -->
            <field>
              <name>IDE</name>
              <description>Identifier extension bit mask.</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DONT_CARE</name>
                  <description>This bit in the message identifier is not used for acceptance filtering (don&apos;t care).</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CARE</name>
                  <description>This bit in the message identifier is used for acceptance filtering.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RTR: Remote transmission request bit mask. -->
            <field>
              <name>RTR</name>
              <description>Remote transmission request bit mask.</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DONT_CARE</name>
                  <description>This bit in the message identifier is not used for acceptance filtering (don&apos;t care).</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CARE</name>
                  <description>This bit in the message identifier is used for acceptance filtering.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- CANMBOXFID: Mailbox Frame Identifier Register -->
        <register>
          <name>CANMBOXFID</name>
          <displayName>CANMBOXFID</displayName>
          <description>Mailbox Frame Identifier Register</description>
          <addressOffset>0x00000044</addressOffset>
          <!-- registerPropertiesGroup -->
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- ID: Identifier. -->
            <field>
              <name>ID</name>
              <description>Identifier.</description>
              <bitRange>[28:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- IDE: Identifier extension bit. -->
            <field>
              <name>IDE</name>
              <description>Identifier extension bit.</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>STANDARD</name>
                  <description>Message is standard CAN frame.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EXTENDED</name>
                  <description>Message is extended CAN frame.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RTR: Remote transmission request bit. -->
            <field>
              <name>RTR</name>
              <description>Remote transmission request bit.</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DATA</name>
                  <description>Message is data frame.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>REMOTE</name>
                  <description>Message is remote frame.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- CANMBOXMTS: Mailbox Message Timestamp Register Note: Read only. -->
        <register>
          <name>CANMBOXMTS</name>
          <displayName>CANMBOXMTS</displayName>
          <description>Mailbox Message Timestamp Register\nNote: Read only.</description>
          <addressOffset>0x00000048</addressOffset>
          <!-- registerPropertiesGroup -->
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- TS: Timestamp -->
            <field>
              <name>TS</name>
              <description>Timestamp</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- CANMBOXMCTL: Mailbox Message Control Register -->
        <register>
          <name>CANMBOXMCTL</name>
          <displayName>CANMBOXMCTL</displayName>
          <description>Mailbox Message Control Register</description>
          <addressOffset>0x0000004C</addressOffset>
          <!-- registerPropertiesGroup -->
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- DLC: Data length code. -->
            <field>
              <name>DLC</name>
              <description>Data length code.</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0</name>
                  <description>0-byte.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>1-byte.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>2-bytes.</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
                  <description>3-bytes.</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4</name>
                  <description>4-bytes.</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>5</name>
                  <description>5-bytes.</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>6</name>
                  <description>6-bytes.</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>7</name>
                  <description>7-bytes.</description>
                  <value>0x7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>8</name>
                  <description>8-bytes.</description>
                  <value>0x8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>12</name>
                  <description>12-bytes, valid for CANFD only.\nIf set for CAN format, DLC force to 8-bytes.</description>
                  <value>0x9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>16</name>
                  <description>16-bytes, valid for CANFD only.\nIf set for CAN format, DLC force to 8-bytes.</description>
                  <value>0xA</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>20</name>
                  <description>20-bytes, valid for CANFD only.\nIf set for CAN format, DLC force to 8-bytes.</description>
                  <value>0xB</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>24</name>
                  <description>24-bytes, valid for CANFD only.\nIf set for CAN format, DLC force to 8-bytes.</description>
                  <value>0xC</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>32</name>
                  <description>32-bytes, valid for CANFD only.\nIf set for CAN format, DLC force to 8-bytes.</description>
                  <value>0xD</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>48</name>
                  <description>48-bytes, valid for CANFD only.\nIf set for CAN format, DLC force to 8-bytes.</description>
                  <value>0xE</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>64</name>
                  <description>64-bytes, valid for CANFD only.\nIf set for CAN format, DLC force to 8-bytes.</description>
                  <value>0xF</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- ESI: Error state indicator. -->
            <field>
              <name>ESI</name>
              <description>Error state indicator.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ACTIVE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PASSIVE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- BRS: Bit rate switch. -->
            <field>
              <name>BRS</name>
              <description>Bit rate switch.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- FDF: FD format indicator. -->
            <field>
              <name>FDF</name>
              <description>FD format indicator.</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- ESICTL: Control send error state indicator enable -->
            <field>
              <name>ESICTL</name>
              <description>Control send error state indicator enable</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Send ESI value equal node passive state, node active send dominant bit and passive send recessive bit.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Send ESI valud by MBFCTL.ESI.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- LOCK: Milbox locked flag.\nNote: always write 0 to this field. -->
            <field>
              <name>LOCK</name>
              <description>Milbox locked flag.\nNote: always write 0 to this field.</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCURED</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCURRED</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- OVWR: Enable overWrite mailbox which is end of block. -->
            <field>
              <name>OVWR</name>
              <description>Enable overWrite mailbox which is end of block.</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- EOB: End of block. -->
            <field>
              <name>EOB</name>
              <description>End of block.</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- IE: Enable mailbox transfer interrupt. -->
            <field>
              <name>IE</name>
              <description>Enable mailbox transfer interrupt.</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- IF: Interrupt pending flag.\nNote: always write 0 to this field. -->
            <field>
              <name>IF</name>
              <description>Interrupt pending flag.\nNote: always write 0 to this field.</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCURED</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCURRED</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXREQ: Transmit request. -->
            <field>
              <name>TXREQ</name>
              <description>Transmit request.</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- LOST: Received message lost.\nNote: always write 0 to this field. -->
            <field>
              <name>LOST</name>
              <description>Received message lost.\nNote: always write 0 to this field.</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCURED</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCURRED</name>
                  <description>For reception: old message lost.\nFor transmission: data error occurred during transmission, MBCTL.EN will be cleared for this reason.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- NEW: New message. -->
            <field>
              <name>NEW</name>
              <description>New message.</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>OLD</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NEW</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RMTEN: Enable remote frame auto response. -->
            <field>
              <name>RMTEN</name>
              <description>Enable remote frame auto response.</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>DIR==0: transmit remote frame first, then wait receive data frame.\nDIR==1: wait receive remote frame first, then transmit message in mailbox.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DIR: Message data transfer direction on bus. -->
            <field>
              <name>DIR</name>
              <description>Message data transfer direction on bus.</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>RECEPTION</name>
                  <description>Wait receive data.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRANSMISSION</name>
                  <description>Wait transmit data.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- EN: Enable mailbox -->
            <field>
              <name>EN</name>
              <description>Enable mailbox</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
