                <enumeratedValue>
                  <name>ACTIVE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PASSIVE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- BRS: Bit rate switch. -->
            <field>
              <name>BRS</name>
