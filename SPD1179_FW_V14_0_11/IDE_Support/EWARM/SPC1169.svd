                </enumeratedValue>
                <enumeratedValue>
                  <name>65536_CYCLE</name>
                  <description>Update DAC code every 65536 clock cycles</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>131072_CYCLE</name>
                  <description>Update DAC code every 131072 clock cycles</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>262144_CYCLE</name>
                  <description>Update DAC code every 262144 clock cycles</description>
                  <value>0x7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- INITCODE: Amplitude code (4MSBs) during initial startup -->
            <field>
              <name>INITCODE</name>
              <description>Amplitude code (4MSBs) during initial startup</description>
              <bitRange>[11:8]</bitRange>
              <access>read-write</access>
