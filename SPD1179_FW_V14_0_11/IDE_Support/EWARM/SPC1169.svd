                <enumeratedValue>
                  <name>RELAX</name>
                  <description>Relaxed threhold</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- ACTLPRD: Amplitdue control code update period -->
            <field>
              <name>ACTLPRD</name>
              <description>Amplitdue control code update period</description>
              <bitRange>[7:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>2048_CYCLE</name>
                  <description>Update DAC code every 2048 clock cycles</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4096_CYCLE</name>
                  <description>Update DAC code every 4096 clock cycles</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>8192_CYCLE</name>
                  <description>Update DAC code every 8192 clock cycles</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>16384_CYCLE</name>
                  <description>Update DAC code every 16384 clock cycles</description>
