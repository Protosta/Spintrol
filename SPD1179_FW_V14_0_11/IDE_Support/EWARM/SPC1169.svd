              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORCE</name>
                  <description>Write 1 forces an event. This bit is self-cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CNTOVF: Counter overflow event force -->
            <field>
              <name>CNTOVF</name>
              <description>Counter overflow event force</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORCE</name>
                  <description>Write 1 forces an event. This bit is self-cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PRD: CAPTSCNT=CAP0 (PRD) event force. -->
            <field>
              <name>PRD</name>
              <description>CAPTSCNT=CAP0 (PRD) event force.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORCE</name>
                  <description>Write 1 forces an event. This bit is self-cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CMP: CAPTSCNT=CAP1 (CMP) event force. -->
            <field>
              <name>CMP</name>
              <description>CAPTSCNT=CAP1 (CMP) event force.</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORCE</name>
                  <description>Write 1 forces an event. This bit is self-cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CEVT0WE: CEVT0 bit write enable -->
            <field>
              <name>CEVT0WE</name>
              <description>CEVT0 bit write enable</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CEVT1WE: CEVT1 bit write enable -->
            <field>
              <name>CEVT1WE</name>
              <description>CEVT1 bit write enable</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CEVT2WE: CEVT2 bit write enable -->
            <field>
              <name>CEVT2WE</name>
              <description>CEVT2 bit write enable</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CEVT3WE: CEVT3 bit write enable -->
            <field>
              <name>CEVT3WE</name>
              <description>CEVT3 bit write enable</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CNTOVFWE: CNTOVF bit write enable -->
            <field>
              <name>CNTOVFWE</name>
              <description>CNTOVF bit write enable</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PRDWE: PRD bit write enable -->
            <field>
              <name>PRDWE</name>
              <description>PRD bit write enable</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CMPWE: CMP bit write enable -->
            <field>
              <name>CMPWE</name>
              <description>CMP bit write enable</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- CAPREGKEY: Capture Register Write-Allow Key Register -->
        <register>
          <name>CAPREGKEY</name>
          <displayName>CAPREGKEY</displayName>
          <description>Capture Register Write-Allow Key Register</description>
          <addressOffset>0x00000038</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x1ACCE551</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- KEY: Write 0x1ACCE551 to unlock protected capture registers -->
            <field>
              <name>KEY</name>
              <description>Write 0x1ACCE551 to unlock protected capture registers</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>I2C</name>
      <description></description>
      <groupName>I2C</groupName>
      <baseAddress>0x40003500</baseAddress>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>112</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
         <name>I2C</name>
         <description>I2C Interrupt</description>
         <value>19</value>
      </interrupt>
      <registers>

        <!-- I2CCTL: I2C Control Register -->
        <register>
          <name>I2CCTL</name>
          <displayName>I2CCTL</displayName>
          <description>I2C Control Register</description>
          <addressOffset>0x00000000</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000062</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- EN: I2C enable (There are two I2C clock delay when enable or disable the I2C).\nWhen I2C is disabled, the following occurs:\n- The TX FIFO and RX FIFO get flushed.\n- Status bits in the I2CIF register are still active until I2C goes into IDLE state.\n- If the module is transmitting, it stops as well as deletes the contents of the transmit FIFO after the current transfer is complete.\n- If the module is receiving, the I2C stops the current transfer at the end of the current byte and does not acknowledge the transfer. -->
            <field>
              <name>EN</name>
              <description>I2C enable (There are two I2C clock delay when enable or disable the I2C).\nWhen I2C is disabled, the following occurs:\n- The TX FIFO and RX FIFO get flushed.\n- Status bits in the I2CIF register are still active until I2C goes into IDLE state.\n- If the module is transmitting, it stops as well as deletes the contents of the transmit FIFO after the current transfer is complete.\n- If the module is receiving, the I2C stops the current transfer at the end of the current byte and does not acknowledge the transfer.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable I2C (Hold FIFOs in an erased state). Software can disable I2C while it is active. However, it is important that care be taken to ensure that i2c is disabled properly.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable I2C</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- MODE: I2C mode -->
            <field>
              <name>MODE</name>
              <description>I2C mode</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SLAVE</name>
                  <description>Set I2C in slave mode</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MASTER</name>
                  <description>Set I2C in master mode</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SPEED: Speed in master mode -->
            <field>
              <name>SPEED</name>
              <description>Speed in master mode</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>STANDARD</name>
                  <description>Standard mode (100 kbit/s)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FAST</name>
                  <description>Fast mode (400 kbit/s)</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HIGH</name>
                  <description>High speed mode (3.4 Mbit/s)</description>
                  <value>0x2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- ADDRMODE: Addressing mode -->
            <field>
              <name>ADDRMODE</name>
              <description>Addressing mode</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>7BIT_ADDR</name>
                  <description>7-bit addressing\nThe I2C ignores transactions that involve 10-bit addressing; for 7-bit addressing, only the lower 7 bits of the I2CSLVADDR register are compared.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>10BIT_ADDR</name>
                  <description>10-bit addressing\nThe I2C responds to only 10-bit addressing transfers that match the full 10 bits of the I2CSLVADDR register.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RESTARTEN: Determines whether RESTART conditions may be sent when acting as a master. Some older slaves do not support handling RESTART conditions; however, RESTART conditions are used in several I2C operations.\nWhen RESTART is disabled, the master is prohibited from performing the following functions:\n- Change direction within a transfer (split)\n- Send a START BYTE\n- High-speed mode operation\n- Combined format transfers in 7-bit addressing modes\n- Read operation with a 10-bit address\n- Send multiple bytes per transfer By replacing RESTART condition followed by a STOP and a subsequent START condition, split operations are broken down into multiple I2C transfers. If the above operations are performed, it will result in setting bit 6 (TXABRT) of the I2CRAWIF register. -->
            <field>
              <name>RESTARTEN</name>
              <description>Determines whether RESTART conditions may be sent when acting as a master. Some older slaves do not support handling RESTART conditions; however, RESTART conditions are used in several I2C operations.\nWhen RESTART is disabled, the master is prohibited from performing the following functions:\n- Change direction within a transfer (split)\n- Send a START BYTE\n- High-speed mode operation\n- Combined format transfers in 7-bit addressing modes\n- Read operation with a 10-bit address\n- Send multiple bytes per transfer By replacing RESTART condition followed by a STOP and a subsequent START condition, split operations are broken down into multiple I2C transfers. If the above operations are performed, it will result in setting bit 6 (TXABRT) of the I2CRAWIF register.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- ACKGC: Respond upon General Call.\nThis bit is applicable only for slave mode -->
            <field>
              <name>ACKGC</name>
              <description>Respond upon General Call.\nThis bit is applicable only for slave mode</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NACK</name>
                  <description>Responds General Call with an NACK</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACK</name>
                  <description>Responds General Call with an ACK</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CLKSTRETCH: Clock stretch on RX FIFO full -->
            <field>
              <name>CLKSTRETCH</name>
              <description>Clock stretch on RX FIFO full</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- I2CMADDR: I2C Master Address Register -->
        <register>
          <name>I2CMADDR</name>
          <displayName>I2CMADDR</displayName>
          <description>I2C Master Address Register</description>
          <addressOffset>0x00000004</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00090055</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- TARADDR: Target address for any master transaction.\nThese bits are ignored for issuing a General Call.\nTo generate a START BYTE, the CPU needs to write only once into these bits.\nIt should not be the same as I2CSLVADDR. -->
            <field>
              <name>TARADDR</name>
              <description>Target address for any master transaction.\nThese bits are ignored for issuing a General Call.\nTo generate a START BYTE, the CPU needs to write only once into these bits.\nIt should not be the same as I2CSLVADDR.</description>
              <bitRange>[9:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- SPECIALCMD: Special command -->
            <field>
              <name>SPECIALCMD</name>
              <description>Special command</description>
              <bitRange>[11:10]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable special command</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GENERAL_CALL</name>
                  <description>General Call\nAfter issuing a General Call, only writes may be performed. Attempting to issue a read command results in setting bit 6 (TXABRT) of the I2CRAWIF register. The I2C remains in General Call mode until the SPECIAL bit is cleared</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>START_BYTE</name>
                  <description>Start Byte</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- HSMCODE: 8-bit high-speed mode master code in format of (0x00001xxx)\nThis register can be written only when the I2C interface is disabled (I2CCTL_EN=0) and the value to write is in valid format (00001xxx)\nWrites at other times have no effect. -->
            <field>
              <name>HSMCODE</name>
              <description>8-bit high-speed mode master code in format of (0x00001xxx)\nThis register can be written only when the I2C interface is disabled (I2CCTL_EN=0) and the value to write is in valid format (00001xxx)\nWrites at other times have no effect.</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- I2CSADDR: I2C Slave Address Register -->
        <register>
          <name>I2CSADDR</name>
          <displayName>I2CSADDR</displayName>
          <description>I2C Slave Address Register</description>
          <addressOffset>0x00000008</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000055</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Slave address when I2C acts as a slave\nThis register can be written only when I2CCTL_EN=0. Writes at other times have no effect.\nNote: The default values cannot be any of the reserved address locations: that is, 0x00 to 0x07, or 0x78 to 0x7f. The correct operation of the device is not guaranteed if you program the I2CSLVADDR or I2CMASTERADDR to a reserved value. -->
            <field>
              <name>VAL</name>
              <description>Slave address when I2C acts as a slave\nThis register can be written only when I2CCTL_EN=0. Writes at other times have no effect.\nNote: The default values cannot be any of the reserved address locations: that is, 0x00 to 0x07, or 0x78 to 0x7f. The correct operation of the device is not guaranteed if you program the I2CSLVADDR or I2CMASTERADDR to a reserved value.</description>
              <bitRange>[9:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- I2CDATACMD: I2C Data and Command Register -->
        <register>
          <name>I2CDATACMD</name>
          <displayName>I2CDATACMD</displayName>
          <description>I2C Data and Command Register</description>
          <addressOffset>0x0000000C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- DATA: Data transmitted or received on the I2C bus.\nA write to the register sets the data to be transmitted.\nA read to the register gets the received data. -->
            <field>
              <name>DATA</name>
              <description>Data transmitted or received on the I2C bus.\nA write to the register sets the data to be transmitted.\nA read to the register gets the received data.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- CMD: Read or write control -->
            <field>
              <name>CMD</name>
              <description>Read or write control</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>WRITE</name>
                  <description>Write</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>READ</name>
                  <description>Read</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- I2CSSLCNT: Standard Speed I2C Clock SCL Low Count Register -->
        <register>
          <name>I2CSSLCNT</name>
          <displayName>I2CSSLCNT</displayName>
          <description>Standard Speed I2C Clock SCL Low Count Register</description>
          <addressOffset>0x00000010</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x0000024C</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Duration for SCL low in standard speed mode.\ni.e. SCL is low for I2CSSLCNT clock cycles\nThe minimum valid value is 4. Write a value below 4 will be reset as 4 by the hardware.\nThis register can be written only when I2CCTL_EN=0. Writes at other times have no effect. -->
            <field>
              <name>VAL</name>
              <description>Duration for SCL low in standard speed mode.\ni.e. SCL is low for I2CSSLCNT clock cycles\nThe minimum valid value is 4. Write a value below 4 will be reset as 4 by the hardware.\nThis register can be written only when I2CCTL_EN=0. Writes at other times have no effect.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- I2CSSHCNT: Standard Speed I2C Clock SCL High Count Register -->
        <register>
          <name>I2CSSHCNT</name>
          <displayName>I2CSSHCNT</displayName>
          <description>Standard Speed I2C Clock SCL High Count Register</description>
          <addressOffset>0x00000014</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x000001F4</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Duration for SCL high in standard speed mode.\ni.e. SCL is high for I2CSSHCNT clock cycles\nThe minimum valid value is 5. Write a value below 5 will be reset as 5 by the hardware.\nThis register can be written only when I2CCTL_EN=0. Writes at other times have no effect. -->
            <field>
              <name>VAL</name>
              <description>Duration for SCL high in standard speed mode.\ni.e. SCL is high for I2CSSHCNT clock cycles\nThe minimum valid value is 5. Write a value below 5 will be reset as 5 by the hardware.\nThis register can be written only when I2CCTL_EN=0. Writes at other times have no effect.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- I2CFSLCNT: Fast Speed I2C Clock SCL Low Count Register -->
        <register>
          <name>I2CFSLCNT</name>
          <displayName>I2CFSLCNT</displayName>
          <description>Fast Speed I2C Clock SCL Low Count Register</description>
          <addressOffset>0x00000018</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x000000A3</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Duration for SCL low in fast speed mode.\ni.e. SCL is low for I2CFSLCNT clock cycles\nThe minimum valid value is 4. Write a value below 4 will be reset as 4 by the hardware.\nThis register can be written only when I2CCTL_EN=0. Writes at other times have no effect. -->
            <field>
              <name>VAL</name>
              <description>Duration for SCL low in fast speed mode.\ni.e. SCL is low for I2CFSLCNT clock cycles\nThe minimum valid value is 4. Write a value below 4 will be reset as 4 by the hardware.\nThis register can be written only when I2CCTL_EN=0. Writes at other times have no effect.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- I2CFSHCNT: Fast Speed I2C Clock SCL High Count Register -->
        <register>
          <name>I2CFSHCNT</name>
          <displayName>I2CFSHCNT</displayName>
          <description>Fast Speed I2C Clock SCL High Count Register</description>
          <addressOffset>0x0000001C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x0000004B</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Duration for SCL high in fast speed mode.\ni.e. SCL is high for I2CFSHCNT clock cycles\nThe minimum valid value is 5. Write a value below 5 will be reset as 5 by the hardware.\nThis register can be written only when I2CCTL_EN=0. Writes at other times have no effect. -->
            <field>
              <name>VAL</name>
              <description>Duration for SCL high in fast speed mode.\ni.e. SCL is high for I2CFSHCNT clock cycles\nThe minimum valid value is 5. Write a value below 5 will be reset as 5 by the hardware.\nThis register can be written only when I2CCTL_EN=0. Writes at other times have no effect.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- I2CHSLCNT: High Speed I2C Clock SCL Low Count Register -->
        <register>
          <name>I2CHSLCNT</name>
          <displayName>I2CHSLCNT</displayName>
          <description>High Speed I2C Clock SCL Low Count Register</description>
          <addressOffset>0x00000020</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000014</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Duration for SCL low in high speed mode.\ni.e. SCL is low for I2CHSLCNT clock cycles\nThe minimum valid value is 4. Write a value below 4 will be reset as 4 by the hardware.\nThis register can be written only when I2CCTL_EN=0. Writes at other times have no effect. -->
            <field>
              <name>VAL</name>
              <description>Duration for SCL low in high speed mode.\ni.e. SCL is low for I2CHSLCNT clock cycles\nThe minimum valid value is 4. Write a value below 4 will be reset as 4 by the hardware.\nThis register can be written only when I2CCTL_EN=0. Writes at other times have no effect.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- I2CHSHCNT: High Speed I2C Clock SCL High Count Register -->
        <register>
          <name>I2CHSHCNT</name>
          <displayName>I2CHSHCNT</displayName>
          <description>High Speed I2C Clock SCL High Count Register</description>
          <addressOffset>0x00000024</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000008</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Duration for SCL high in high speed mode.\ni.e. SCL is high for I2CHSHCNT clock cycles\nThe minimum valid value is 1. Write a 0 will be reset as 1 by the hardware.\nThis register can be written only when I2CCTL_EN=0. Writes at other times have no effect. -->
            <field>
              <name>VAL</name>
              <description>Duration for SCL high in high speed mode.\ni.e. SCL is high for I2CHSHCNT clock cycles\nThe minimum valid value is 1. Write a 0 will be reset as 1 by the hardware.\nThis register can be written only when I2CCTL_EN=0. Writes at other times have no effect.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- I2CFSSPKLEN: Fast Speed I2C Spike Suppresion Limit Register -->
        <register>
          <name>I2CFSSPKLEN</name>
          <displayName>I2CFSSPKLEN</displayName>
          <description>Fast Speed I2C Spike Suppresion Limit Register</description>
          <addressOffset>0x00000028</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000006</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Duration in fast speed mode of the longest spike in the SCL or SDA lines that are filtered out by the spike suppression logic.\nThe minimum value is 1 and write a 0 will be reset as 1 by the hardware.\nThis register can be written only when I2CCTL_EN=0. Writes at other times have no effect. -->
            <field>
              <name>VAL</name>
              <description>Duration in fast speed mode of the longest spike in the SCL or SDA lines that are filtered out by the spike suppression logic.\nThe minimum value is 1 and write a 0 will be reset as 1 by the hardware.\nThis register can be written only when I2CCTL_EN=0. Writes at other times have no effect.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- I2CHSSPKLEN: High Speed I2C Spike Suppresion Limit Register -->
        <register>
          <name>I2CHSSPKLEN</name>
          <displayName>I2CHSSPKLEN</displayName>
          <description>High Speed I2C Spike Suppresion Limit Register</description>
          <addressOffset>0x0000002C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000002</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Duration in high speed mode of the longest spike in the SCL or SDA lines that are filtered out by the spike suppression logic.\nThe minimum value is 1 and write a 0 will be reset as 1 by the hardware.\nThis register can be written only when I2CCTL_EN=0. Writes at other times have no effect. -->
            <field>
              <name>VAL</name>
              <description>Duration in high speed mode of the longest spike in the SCL or SDA lines that are filtered out by the spike suppression logic.\nThe minimum value is 1 and write a 0 will be reset as 1 by the hardware.\nThis register can be written only when I2CCTL_EN=0. Writes at other times have no effect.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- I2CSDASETUP: I2C SDA Setup Time Register -->
        <register>
          <name>I2CSDASETUP</name>
          <displayName>I2CSDASETUP</displayName>
          <description>I2C SDA Setup Time Register</description>
          <addressOffset>0x00000030</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000064</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Configure SDA setup time as VAL CLK_I2C cycles\ni.e. If the required setup delay is 1000ns, then for an CLK_I2C frequency of 10 MHz, this register is recommended to be programmed as 11.\nThe minimum value is 2 and write a value below 2 will be reset as 2 by the hardware.\nThis register can be written only when I2CCTL_EN=0. Writes at other times have no effect. -->
            <field>
              <name>VAL</name>
              <description>Configure SDA setup time as VAL CLK_I2C cycles\ni.e. If the required setup delay is 1000ns, then for an CLK_I2C frequency of 10 MHz, this register is recommended to be programmed as 11.\nThe minimum value is 2 and write a value below 2 will be reset as 2 by the hardware.\nThis register can be written only when I2CCTL_EN=0. Writes at other times have no effect.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- I2CSDAHOLD: I2C SDA Hold Time Register -->
        <register>
          <name>I2CSDAHOLD</name>
          <displayName>I2CSDAHOLD</displayName>
          <description>I2C SDA Hold Time Register</description>
          <addressOffset>0x00000034</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Configure SDA hold time as VAL CLK_I2C cycles\ni.e. If the required hold delay is 1000ns, then for an CLK_I2C frequency of 10 MHz, this register is recommended to be programmed as 11.\nThis register can be written only when I2CCTL_EN=0. Writes at other times have no effect. -->
            <field>
              <name>VAL</name>
              <description>Configure SDA hold time as VAL CLK_I2C cycles\ni.e. If the required hold delay is 1000ns, then for an CLK_I2C frequency of 10 MHz, this register is recommended to be programmed as 11.\nThis register can be written only when I2CCTL_EN=0. Writes at other times have no effect.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- I2CTXLVL: I2C Transmit FIFO Level Register -->
        <register>
          <name>I2CTXLVL</name>
          <displayName>I2CTXLVL</displayName>
          <description>I2C Transmit FIFO Level Register</description>
          <addressOffset>0x00000038</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Number of valid data entries in the transmit FIFO. -->
            <field>
              <name>VAL</name>
              <description>Number of valid data entries in the transmit FIFO.</description>
              <bitRange>[4:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- I2CRXLVL: I2C Receive FIFO Level Register -->
        <register>
          <name>I2CRXLVL</name>
          <displayName>I2CRXLVL</displayName>
          <description>I2C Receive FIFO Level Register</description>
          <addressOffset>0x0000003C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Number of valid data entries in the receive FIFO. -->
            <field>
              <name>VAL</name>
              <description>Number of valid data entries in the receive FIFO.</description>
              <bitRange>[4:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- I2CTXTH: I2C Transmit FIFO Threshold Register -->
        <register>
          <name>I2CTXTH</name>
          <displayName>I2CTXTH</displayName>
          <description>I2C Transmit FIFO Threshold Register</description>
          <addressOffset>0x00000040</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Transmit FIFO threshold level to trigger the TFEMPTY interrupt -->
            <field>
              <name>VAL</name>
              <description>Transmit FIFO threshold level to trigger the TFEMPTY interrupt</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- I2CRXTH: I2C Receive FIFO Threshold Register -->
        <register>
          <name>I2CRXTH</name>
          <displayName>I2CRXTH</displayName>
          <description>I2C Receive FIFO Threshold Register</description>
          <addressOffset>0x00000044</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Receive FIFO threshold level to trigger the RFFULL interrupt -->
            <field>
              <name>VAL</name>
              <description>Receive FIFO threshold level to trigger the RFFULL interrupt</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- I2CSTS: I2C Status Register -->
        <register>
          <name>I2CSTS</name>
          <displayName>I2CSTS</displayName>
          <description>I2C Status Register</description>
          <addressOffset>0x00000054</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000018</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- ACT: I2C activity status (Logic OR of SACT and MACT) -->
            <field>
              <name>ACT</name>
              <description>I2C activity status (Logic OR of SACT and MACT)</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>IDLE</name>
                  <description>Both master and slave FSM are in idle state</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACTIVE</name>
                  <description>Either master or slave FSM is active</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- MACT: Master FSM activity status -->
            <field>
              <name>MACT</name>
              <description>Master FSM activity status</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>IDLE</name>
                  <description>Master FSM is in IDLE state (Inactive)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACTIVE</name>
                  <description>Master FSM is not in IDLE state (Active)</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SACT: Slave FSM (Finite State Machine) activity status -->
            <field>
              <name>SACT</name>
              <description>Slave FSM (Finite State Machine) activity status</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>IDLE</name>
                  <description>Slave FSM is in IDLE state (Inactive)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACTIVE</name>
                  <description>Slave FSM is not in IDLE state (Active)</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXEMPTY: Transmit FIFO completely empty -->
            <field>
              <name>TXEMPTY</name>
              <description>Transmit FIFO completely empty</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_EMPTY</name>
                  <description>Transmit FIFO contains one or more entries</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EMPTY</name>
                  <description>Transmit FIFO is empty</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXNF: Transmit FIFO not full (so can write data to it) -->
            <field>
              <name>TXNF</name>
              <description>Transmit FIFO not full (so can write data to it)</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FULL</name>
                  <description>Transmit FIFO is full</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NOT_FULL</name>
                  <description>Transmit FIFO contains empty locations</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXNE: Receive FIFO not empty (so can read data from it) -->
            <field>
              <name>RXNE</name>
              <description>Receive FIFO not empty (so can read data from it)</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EMPTY</name>
                  <description>Receive FIFO is empty</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NOT_EMPTY</name>
                  <description>Receive FIFO contains one or more entries</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXFULL: Receive FIFO completely full -->
            <field>
              <name>RXFULL</name>
              <description>Receive FIFO completely full</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_FULL</name>
                  <description>Receive FIFO contains empty location</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FULL</name>
                  <description>Receive FIFO is completely full</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- EN: I2C enabled status -->
            <field>
              <name>EN</name>
              <description>I2C enabled status</description>
              <bitRange>[7:7]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>I2C is deemed completely inactive\nSLVRDLOST and SLVDISONBUSY bits can be read safely</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>I2C is deemed to be in an enabled state</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SRXABRT: Slave disabled while it is busy -->
            <field>
              <name>SRXABRT</name>
              <description>Slave disabled while it is busy</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>I2CENABLE is stable during slave operation</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>I2CENABLE is changed from 1 to 0 when I2C slave is receiving from a remote mater on\n(a) The address byte of the slave transmitter\n(b) The address and data bytes of the slave receiver</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SRXDLOST: Slave received data lost upon disable I2C -->
            <field>
              <name>SRXDLOST</name>
              <description>Slave received data lost upon disable I2C</description>
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Slave receiver operation is done before I2CENABLE is changed from 1 to 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Slave receiver operation is aborted with at least one data byte received from an I2C transfer when I2CENABLE is changed from 1 to 0</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- I2CTXABRTSRC: I2C Transmit Abort Source Register -->
        <register>
          <name>I2CTXABRTSRC</name>
          <displayName>I2CTXABRTSRC</displayName>
          <description>I2C Transmit Abort Source Register</description>
          <addressOffset>0x00000058</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- ADDR7BNACK: Role of I2C: Master transmitter/receiver\nThis bit is set when master is in 7-bit addressing mode and the address sent was not acknowledged by any slave. -->
            <field>
              <name>ADDR7BNACK</name>
              <description>Role of I2C: Master transmitter/receiver\nThis bit is set when master is in 7-bit addressing mode and the address sent was not acknowledged by any slave.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- ADDR10B1NACK: Role of I2C: Master transmitter/receiver\nThis bit is set when master is in 10-bit address mode and the first 10-bit address byte was not acknowledged by any slave. -->
            <field>
              <name>ADDR10B1NACK</name>
              <description>Role of I2C: Master transmitter/receiver\nThis bit is set when master is in 10-bit address mode and the first 10-bit address byte was not acknowledged by any slave.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- ADDR10B2NACK: Role of I2C: Master transmitter/receiver\nThis bit is set when master is in 10-bit address mode and the second address byte of the 10-bit address was not acknowledged by any slave. -->
            <field>
              <name>ADDR10B2NACK</name>
              <description>Role of I2C: Master transmitter/receiver\nThis bit is set when master is in 10-bit address mode and the second address byte of the 10-bit address was not acknowledged by any slave.</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXDNACK: Role of I2C: Master transmitter\nThis bit is set when master has received an acknowledgement for the address, but when it sent data byte(s) following the address, it did not receive an acknowledge from the remote slave(s). -->
            <field>
              <name>TXDNACK</name>
              <description>Role of I2C: Master transmitter\nThis bit is set when master has received an acknowledgement for the address, but when it sent data byte(s) following the address, it did not receive an acknowledge from the remote slave(s).</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- GCNACK: Role of I2C: Master transmitter\nThis bit is set when master sent a General Call and no slave on the bus acknowledged the General Call. -->
            <field>
              <name>GCNACK</name>
              <description>Role of I2C: Master transmitter\nThis bit is set when master sent a General Call and no slave on the bus acknowledged the General Call.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- GCREAD: Role of I2C: Master transmitter\nThis bit is set when master sent a General Call but the user programmed the byte following the General Call to be a read from the bus (I2CDATACMD_CMD=1). -->
            <field>
              <name>GCREAD</name>
              <description>Role of I2C: Master transmitter\nThis bit is set when master sent a General Call but the user programmed the byte following the General Call to be a read from the bus (I2CDATACMD_CMD=1).</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- HSMCACK: Role of I2C: Master transmitter/receiver\nThis bit is set when master is in high speed mode and the high speed master code was acknowledged (wrong behavior). -->
            <field>
              <name>HSMCACK</name>
              <description>Role of I2C: Master transmitter/receiver\nThis bit is set when master is in high speed mode and the high speed master code was acknowledged (wrong behavior).</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- STARTACK: Role of I2C: Master transmitter/receiver \nThis bit is set when master has sent a START Byte and the START Byte was acknowledged (wrong behavior). -->
            <field>
              <name>STARTACK</name>
              <description>Role of I2C: Master transmitter/receiver \nThis bit is set when master has sent a START Byte and the START Byte was acknowledged (wrong behavior).</description>
              <bitRange>[7:7]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- HSNORESTART: Role of I2C: Master transmitter/receiver\nThis bit is set when the restart is disabled (I2CCTL.RESTARTEN=0) and the user is trying to use the master to transfer data in high speed mode. -->
            <field>
              <name>HSNORESTART</name>
              <description>Role of I2C: Master transmitter/receiver\nThis bit is set when the restart is disabled (I2CCTL.RESTARTEN=0) and the user is trying to use the master to transfer data in high speed mode.</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- STARTNORESTART: Role of I2C: Master transmitter/receiver\nThis bit is set when the restart is disabled (I2CCTL.RESTARTEN=0) and the user is trying to send a START Byte.\nFollow configurations below to avoid this error\n(1) I2CCTL.RESTARTEN=1\n(2) I2CMASTERADDR.SPECIAL=0 or I2CMASTERADDR.GCORSTART=0\nOtherwise, this bit is set again at next clock after it is cleared by writing a 1 to I2CIC_TXABRT -->
            <field>
              <name>STARTNORESTART</name>
              <description>Role of I2C: Master transmitter/receiver\nThis bit is set when the restart is disabled (I2CCTL.RESTARTEN=0) and the user is trying to send a START Byte.\nFollow configurations below to avoid this error\n(1) I2CCTL.RESTARTEN=1\n(2) I2CMASTERADDR.SPECIAL=0 or I2CMASTERADDR.GCORSTART=0\nOtherwise, this bit is set again at next clock after it is cleared by writing a 1 to I2CIC_TXABRT</description>
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RD10BNORESTART: Role of I2C: Master receiver\nThis bit is set when the restart is disabled (I2CCTL.RESTARTEN=0) and the master sends a read command in 10-bit addressing mode. -->
            <field>
              <name>RD10BNORESTART</name>
              <description>Role of I2C: Master receiver\nThis bit is set when the restart is disabled (I2CCTL.RESTARTEN=0) and the master sends a read command in 10-bit addressing mode.</description>
              <bitRange>[10:10]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- MDISABLED: Role of I2C: Master transmitter/receiver\nThis bit is set when user tries to initiate a master operation with the master mode is disabled. -->
            <field>
              <name>MDISABLED</name>
              <description>Role of I2C: Master transmitter/receiver\nThis bit is set when user tries to initiate a master operation with the master mode is disabled.</description>
              <bitRange>[11:11]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- MARBLOST: Role of I2C: Master/slave transmitter\nThis bit is set when master has lost arbitration, or if I2CTXABRTSRC.SARBLOST is also set, then the slave transmitter has lost arbitration. -->
            <field>
              <name>MARBLOST</name>
              <description>Role of I2C: Master/slave transmitter\nThis bit is set when master has lost arbitration, or if I2CTXABRTSRC.SARBLOST is also set, then the slave transmitter has lost arbitration.</description>
              <bitRange>[12:12]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- STFIFOCLR: Role of I2C: Slave transmitter\nThis bis is set when slave has received a read command and some data exists in the TX FIFO so the slave issues a TXABRT interrupt to clear old data in TX FIFO. -->
            <field>
              <name>STFIFOCLR</name>
              <description>Role of I2C: Slave transmitter\nThis bis is set when slave has received a read command and some data exists in the TX FIFO so the slave issues a TXABRT interrupt to clear old data in TX FIFO.</description>
              <bitRange>[13:13]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SARBLOST: Role of I2C: Slave transmitter\nThis bit is set when slave lost the bus while transmitting data to a remote master. I2CTXABRTSRC.MARBLOST is set at the same time.\nNote: Even though the slave never &apos;owns&apos; the bus, something could go wrong on the bus. This is a failsafe check. For instance, during a data transmission at the low-to-high transition of SCL, if what is on the data bus is not what is supposed to be transmitted, then I2C no longer own the bus. -->
            <field>
              <name>SARBLOST</name>
              <description>Role of I2C: Slave transmitter\nThis bit is set when slave lost the bus while transmitting data to a remote master. I2CTXABRTSRC.MARBLOST is set at the same time.\nNote: Even though the slave never &apos;owns&apos; the bus, something could go wrong on the bus. This is a failsafe check. For instance, during a data transmission at the low-to-high transition of SCL, if what is on the data bus is not what is supposed to be transmitted, then I2C no longer own the bus.</description>
              <bitRange>[14:14]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SCMDERR: Role of I2C: Slave transmitter\nThis bit is set when the processor side responds to a slave mode request for data to be transmitted to a remote master and user writes a 1 in CMD (bit 8) of I2CDATACMD register. -->
            <field>
              <name>SCMDERR</name>
              <description>Role of I2C: Slave transmitter\nThis bit is set when the processor side responds to a slave mode request for data to be transmitted to a remote master and user writes a 1 in CMD (bit 8) of I2CDATACMD register.</description>
              <bitRange>[15:15]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- I2CRAWIF: I2C Raw Interrupt Flag Register -->
        <register>
          <name>I2CRAWIF</name>
          <displayName>I2CRAWIF</displayName>
          <description>I2C Raw Interrupt Flag Register</description>
          <addressOffset>0x0000005C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- RXUDF: Flag to indicate the processor attempts to read the receive FIFO via I2CDATACMD register when it is empty -->
            <field>
              <name>RXUDF</name>
              <description>Flag to indicate the processor attempts to read the receive FIFO via I2CDATACMD register when it is empty</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Receive FIFO does not underflow</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Receive FIFO underflows</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXOVF: Flag to indicate the receive FIFO is completely filled to 16 and an additional byte is received from an external I2C device. The I2C acknowledges this, but any data bytes received after the FIFO is full are lost. -->
            <field>
              <name>RXOVF</name>
              <description>Flag to indicate the receive FIFO is completely filled to 16 and an additional byte is received from an external I2C device. The I2C acknowledges this, but any data bytes received after the FIFO is full are lost.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Receive FIFO does not overflow</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Receive FIFO overflows</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXDAV: Flag to indicate there is enough data in the receive FIFO and available for read -->
            <field>
              <name>RXDAV</name>
              <description>Flag to indicate there is enough data in the receive FIFO and available for read</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>I2CRXLVL&amp;lt;= I2CRXTH</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>I2CRXLVL&amp;gt;I2CRXTH\nThis bit is self-cleared when I2CRXLVL&amp;lt;=I2CRXTH</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXOVF: Flag to indicate an attempt to write I2CDATACMD register when transmit FIFO is full -->
            <field>
              <name>TXOVF</name>
              <description>Flag to indicate an attempt to write I2CDATACMD register when transmit FIFO is full</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Transmit FIFO does not overflow</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Transmit FIFO overflows</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXDREQ: Flag to indicate there is not enough data in the transmit FIFO and request for more data -->
            <field>
              <name>TXDREQ</name>
              <description>Flag to indicate there is not enough data in the transmit FIFO and request for more data</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>I2CTXLVL&amp;gt;I2CTXTH</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>I2CTXLVL&amp;lt;=I2CTXTH\nThis bit is self-cleared when I2CTXLVL&amp;gt;I2CTXTH</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RDREQ: Latched external master read request flag when the I2C is acting as a slave -->
            <field>
              <name>RDREQ</name>
              <description>Latched external master read request flag when the I2C is acting as a slave</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>No read request is received from another master</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Read request was received from another master.\nThe processor must respond to this interrupt and then write the requested data to the I2CDATACMD register.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXABRT: Latched transmission abort flag -->
            <field>
              <name>TXABRT</name>
              <description>Latched transmission abort flag</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>No transmission abortion occurred</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Transimission aborted and TX FIFO remains in flushed state until write a 1 to I2CIC_TXABRT</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXDONE: Flag to indicate external master receive is done when I2C acts as a slave transmitter -->
            <field>
              <name>RXDONE</name>
              <description>Flag to indicate external master receive is done when I2C acts as a slave transmitter</description>
              <bitRange>[7:7]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Slave transmission is acknowledged by the other master, which continues data receiving.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Slave transmission is not acknowledge by the other master, which finishes the data receiving</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- ACT: Latched I2C activity status flag -->
            <field>
              <name>ACT</name>
              <description>Latched I2C activity status flag</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>There is no activity detected on I2C interface</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Activity has been detected on I2C interface</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- ACKDET: Latched flag for detected ACK from external receiver -->
            <field>
              <name>ACKDET</name>
              <description>Latched flag for detected ACK from external receiver</description>
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>ACK is not detected</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>ACK is detected</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- STOPDET: STOP condition flag -->
            <field>
              <name>STOPDET</name>
              <description>STOP condition flag</description>
              <bitRange>[10:10]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Condition is not detected</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Condition is detected</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- STARTDET: START or RESTART condition flag -->
            <field>
              <name>STARTDET</name>
              <description>START or RESTART condition flag</description>
              <bitRange>[11:11]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Condition is not detected</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Condition is detected</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- GENCALL: General Call address received and acknowledged flag -->
            <field>
              <name>GENCALL</name>
              <description>General Call address received and acknowledged flag</description>
              <bitRange>[12:12]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Occurred</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- I2CIF: I2C Interrupt Flag Register -->
        <register>
          <name>I2CIF</name>
          <displayName>I2CIF</displayName>
          <description>I2C Interrupt Flag Register</description>
          <addressOffset>0x00000060</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- RXUDF: Flag to indicate the processor attempts to read the receive FIFO via I2CDATACMD register when it is empty -->
            <field>
              <name>RXUDF</name>
              <description>Flag to indicate the processor attempts to read the receive FIFO via I2CDATACMD register when it is empty</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Receive FIFO does not underflow</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Receive FIFO underflows</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXOVF: Flag to indicate the receive FIFO is completely filled to 16 and an additional byte is received from an external I2C device. The I2C acknowledges this, but any data bytes received after the FIFO is full are lost. -->
            <field>
              <name>RXOVF</name>
              <description>Flag to indicate the receive FIFO is completely filled to 16 and an additional byte is received from an external I2C device. The I2C acknowledges this, but any data bytes received after the FIFO is full are lost.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Receive FIFO does not overflow</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Receive FIFO overflows</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXDAV: Flag to indicate there is enough data in the receive FIFO and available for read -->
            <field>
              <name>RXDAV</name>
              <description>Flag to indicate there is enough data in the receive FIFO and available for read</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>I2CRXLVL&amp;lt;= I2CRXTH</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>I2CRXLVL&amp;gt;I2CRXTH\nThis bit is self-cleared when I2CRXLVL&amp;lt;=I2CRXTH</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXOVF: Flag to indicate an attempt to write I2CDATACMD register when transmit FIFO is full -->
            <field>
              <name>TXOVF</name>
              <description>Flag to indicate an attempt to write I2CDATACMD register when transmit FIFO is full</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Transmit FIFO does not overflow</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Transmit FIFO overflows</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXDREQ: Flag to indicate there is not enough data in the transmit FIFO and request for more data -->
            <field>
              <name>TXDREQ</name>
              <description>Flag to indicate there is not enough data in the transmit FIFO and request for more data</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>I2CTXLVL&amp;gt;I2CTXTH</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>I2CTXLVL&amp;lt;=I2CTXTH\nThis bit is self-cleared when I2CTXLVL&amp;gt;I2CTXTH</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RDREQ: Latched external master read request flag when the I2C is acting as a slave -->
            <field>
              <name>RDREQ</name>
              <description>Latched external master read request flag when the I2C is acting as a slave</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>No read request is received from another master</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Read request was received from another master.\nThe processor must respond to this interrupt and then write the requested data to the I2CDATACMD register.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXABRT: Latched transmission abort flag -->
            <field>
              <name>TXABRT</name>
              <description>Latched transmission abort flag</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>No transmission abortion occurred</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Transimission aborted and TX FIFO remains in flushed state until write a 1 to I2CIC_TXABRT</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXDONE: Flag to indicate external master receive is done when I2C acts as a slave transmitter -->
            <field>
              <name>RXDONE</name>
              <description>Flag to indicate external master receive is done when I2C acts as a slave transmitter</description>
              <bitRange>[7:7]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Slave transmission is acknowledged by the other master, which continues data receiving.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Slave transmission is not acknowledge by the other master, which finishes the data receiving</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- ACT: Latched I2C activity status flag -->
            <field>
              <name>ACT</name>
              <description>Latched I2C activity status flag</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>There is no activity detected on I2C interface</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Activity has been detected on I2C interface</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- ACKDET: Latched flag for detected ACK from external receiver -->
            <field>
              <name>ACKDET</name>
              <description>Latched flag for detected ACK from external receiver</description>
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>ACK is not detected</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>ACK is detected</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- STOPDET: STOP condition flag -->
            <field>
              <name>STOPDET</name>
              <description>STOP condition flag</description>
              <bitRange>[10:10]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
