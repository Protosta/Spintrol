<device schemaVersion="1.1" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD_Schema_1_1.xsd" >
  <name>SPC1169</name>                                            <!-- name of part-->
  <version>2022071043481212</version>                             <!-- version of this description, adding CMSIS-SVD 1.1 tags -->
  <description></description>

  <licenseText>                                                   <!-- this license text will appear in header file. \n force line breaks -->
    ARM Limited (ARM) is supplying this software for use with Cortex-M\n
    processor based microcontroller, but can be equally used for other\n
    suitable  processor architectures. This file can be freely distributed.\n
    Modifications to this file shall be clearly marked.\n
    \n
    THIS SOFTWARE IS PROVIDED "AS IS".  NO WARRANTIES, WHETHER EXPRESS, IMPLIED\n
    OR STATUTORY, INCLUDING, BUT NOT LIMITED TO, IMPLIED WARRANTIES OF\n
    MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE APPLY TO THIS SOFTWARE.\n
    ARM SHALL NOT, IN ANY CIRCUMSTANCES, BE LIABLE FOR SPECIAL, INCIDENTAL, OR\n
    CONSEQUENTIAL DAMAGES, FOR ANY REASON WHATSOEVER.
  </licenseText>
  <cpu>                                                           <!-- details about the cpu embedded in the device -->
    <name>cm4</name>
    <revision>r1p0</revision>
    <endian>little     </endian>
    <mpuPresent>false</mpuPresent>
    <fpuPresent>true</fpuPresent>
    <nvicPrioBits>4</nvicPrioBits>
    <vendorSystickConfig>false</vendorSystickConfig>
  </cpu>

  <!--Bus Interface Properties-->
  <!--Cortex-CM4 is byte addressable-->
  <addressUnitBits>8</addressUnitBits>                            <!-- byte addressable memory -->
  <!--the maximum data bit width accessible within a single transfer-->
  <width>32</width>                                               <!-- bus width is 32 bits -->

  <!--Register Default Properties-->
  <size>32</size>                                                 <!-- this is the default size (number of bits) of all peripherals
                                                                       and register that do not define "size" themselves -->
  <access>read-write</access>                                     <!-- default access permission for all subsequent registers -->
  <resetValue>0x00000000</resetValue>                             <!-- by default all bits of the registers are initialized to 0 on reset -->
  <resetMask>0xFFFFFFFF</resetMask>                               <!-- by default all 32Bits of the registers are used -->

  <peripherals>

    <peripheral>
      <name>SYSTEM</name>
      <description></description>
      <groupName>SYSTEM</groupName>
      <baseAddress>0x40000000</baseAddress>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>256</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
         <name>MEM</name>
         <description>MEM Interrupt</description>
         <value>1</value>
      </interrupt>
      <registers>

        <!-- CID0: Chip ID Register 0 -->
        <register>
          <name>CID0</name>
          <displayName>CID0</displayName>
          <description>Chip ID Register 0</description>
          <addressOffset>0x00000000</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: 32 LSBs of the 64-bit chip ID -->
            <field>
              <name>VAL</name>
              <description>32 LSBs of the 64-bit chip ID</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- CID1: Chip ID Register 1 -->
        <register>
          <name>CID1</name>
          <displayName>CID1</displayName>
          <description>Chip ID Register 1</description>
          <addressOffset>0x00000004</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: 32 MSBs of the 64-bit chip ID -->
            <field>
              <name>VAL</name>
              <description>32 MSBs of the 64-bit chip ID</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- UID0: Unique ID Register 0 -->
        <register>
          <name>UID0</name>
          <displayName>UID0</displayName>
          <description>Unique ID Register 0</description>
          <addressOffset>0x00000008</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: 32 LSBs of the 64-bit unique ID -->
            <field>
              <name>VAL</name>
              <description>32 LSBs of the 64-bit unique ID</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- UID1: Unique ID Register 1 -->
        <register>
          <name>UID1</name>
          <displayName>UID1</displayName>
          <description>Unique ID Register 1</description>
          <addressOffset>0x0000000C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: 32 MSBs of the 64-bit unique ID -->
            <field>
              <name>VAL</name>
              <description>32 MSBs of the 64-bit unique ID</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- RND0: Random Number Register 0 -->
        <register>
          <name>RND0</name>
          <displayName>RND0</displayName>
          <description>Random Number Register 0</description>
          <addressOffset>0x00000010</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: 32 LSBs of the 64-bit random number -->
            <field>
              <name>VAL</name>
              <description>32 LSBs of the 64-bit random number</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- RND1: Random Number Register 1 -->
        <register>
          <name>RND1</name>
          <displayName>RND1</displayName>
          <description>Random Number Register 1</description>
          <addressOffset>0x00000014</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: 32 MSBs of the 64-bit random number -->
            <field>
              <name>VAL</name>
              <description>32 MSBs of the 64-bit random number</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- REV0: Revision Information Register 0 -->
        <register>
          <name>REV0</name>
          <displayName>REV0</displayName>
          <description>Revision Information Register 0</description>
          <addressOffset>0x00000018</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x63681010</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: 32 LSBs of the 64-bit revision number -->
            <field>
              <name>VAL</name>
              <description>32 LSBs of the 64-bit revision number</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- REV1: Revision Information Register 1 -->
        <register>
          <name>REV1</name>
          <displayName>REV1</displayName>
          <description>Revision Information Register 1</description>
          <addressOffset>0x0000001C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x20200200</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: 32 MSBs of the 64-bit revision number -->
            <field>
              <name>VAL</name>
              <description>32 MSBs of the 64-bit revision number</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- SYSMONCTL: System Monitor Control Register -->
        <register>
          <name>SYSMONCTL</name>
          <displayName>SYSMONCTL</displayName>
          <description>System Monitor Control Register</description>
          <addressOffset>0x00000020</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0xF800FFFF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- MONPRD: System monitor interval. i.e. Wait for (MONPRD*8+1) HCLK cycles to measure the next item -->
            <field>
              <name>MONPRD</name>
              <description>System monitor interval. i.e. Wait for (MONPRD*8+1) HCLK cycles to measure the next item</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- VADCREFEN: 13-bit ADC reference voltage monitor enable -->
            <field>
              <name>VADCREFEN</name>
              <description>13-bit ADC reference voltage monitor enable</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- VDD12EN: VDD12 monitor enable -->
            <field>
              <name>VDD12EN</name>
              <description>VDD12 monitor enable</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- VDD33EN: VDD33 monitor enable -->
            <field>
              <name>VDD33EN</name>
              <description>VDD33 monitor enable</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TMCUEN: Controller temperature monitor enable -->
            <field>
              <name>TMCUEN</name>
              <description>Controller temperature monitor enable</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TLINEN: LIN PHY temperature monitor enable -->
            <field>
              <name>TLINEN</name>
              <description>LIN PHY temperature monitor enable</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TPMUEN: Power temperature monitor enable -->
            <field>
              <name>TPMUEN</name>
              <description>Power temperature monitor enable</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- VBGEN: Power bandgap monitor enable -->
            <field>
              <name>VBGEN</name>
              <description>Power bandgap monitor enable</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- VDD5EN: VDD5 monitor enable -->
            <field>
              <name>VDD5EN</name>
              <description>VDD5 monitor enable</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- VMONEN: VMON monitor enable -->
            <field>
              <name>VMONEN</name>
              <description>VMON monitor enable</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- VCPEN: VCP monitor enable -->
            <field>
              <name>VCPEN</name>
              <description>VCP monitor enable</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- VBATEN: VBAT monitor enable -->
            <field>
              <name>VBATEN</name>
              <description>VBAT monitor enable</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SCWIN: Both sample and convert time is set to (SCWIN + 1)*4 HCLK cycles -->
            <field>
              <name>SCWIN</name>
              <description>Both sample and convert time is set to (SCWIN + 1)*4 HCLK cycles</description>
              <bitRange>[31:27]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- VBATTH: VBAT Monitor Threshold Register -->
        <register>
          <name>VBATTH</name>
          <displayName>VBATTH</displayName>
          <description>VBAT Monitor Threshold Register</description>
          <addressOffset>0x00000024</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x0FFF0000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- MIN: Minimum allowed VBAT monitor code -->
            <field>
              <name>MIN</name>
              <description>Minimum allowed VBAT monitor code</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- MAX: Maximum allowed VBAT monitor code -->
            <field>
              <name>MAX</name>
              <description>Maximum allowed VBAT monitor code</description>
              <bitRange>[27:16]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- VCPTH: VCP Monitor Threshold Register -->
        <register>
          <name>VCPTH</name>
          <displayName>VCPTH</displayName>
          <description>VCP Monitor Threshold Register</description>
          <addressOffset>0x00000028</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x0FFF0000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- MIN: Minimum allowed VCP monitor code -->
            <field>
              <name>MIN</name>
              <description>Minimum allowed VCP monitor code</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- MAX: Maximum allowed VCP monitor code -->
            <field>
              <name>MAX</name>
              <description>Maximum allowed VCP monitor code</description>
              <bitRange>[27:16]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- VMONTH: VMON Monitor Threshold Register -->
        <register>
          <name>VMONTH</name>
          <displayName>VMONTH</displayName>
          <description>VMON Monitor Threshold Register</description>
          <addressOffset>0x0000002C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x0FFF0000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- MIN: Minimum allowed VMON monitor code -->
            <field>
              <name>MIN</name>
              <description>Minimum allowed VMON monitor code</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- MAX: Maximum allowed VMON monitor code -->
            <field>
              <name>MAX</name>
              <description>Maximum allowed VMON monitor code</description>
              <bitRange>[27:16]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- VDD5TH: VDD5 Monitor Threshold Register -->
        <register>
          <name>VDD5TH</name>
          <displayName>VDD5TH</displayName>
          <description>VDD5 Monitor Threshold Register</description>
          <addressOffset>0x00000030</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x0FFF0000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- MIN: Minimum allowed VDD5 monitor code -->
            <field>
              <name>MIN</name>
              <description>Minimum allowed VDD5 monitor code</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- MAX: Maximum allowed VDD5 monitor code -->
            <field>
              <name>MAX</name>
              <description>Maximum allowed VDD5 monitor code</description>
              <bitRange>[27:16]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- VBGTH: Power Bandgap Monitor Threshold Register -->
        <register>
          <name>VBGTH</name>
          <displayName>VBGTH</displayName>
          <description>Power Bandgap Monitor Threshold Register</description>
          <addressOffset>0x00000034</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x0FFF0000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- MIN: Minimum allowed power bandgap monitor code -->
            <field>
              <name>MIN</name>
              <description>Minimum allowed power bandgap monitor code</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- MAX: Maximum allowed power bandgap monitor code -->
            <field>
              <name>MAX</name>
              <description>Maximum allowed power bandgap monitor code</description>
              <bitRange>[27:16]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- TPMUTH: Power Module Temperature Monitor Threshold Register -->
        <register>
          <name>TPMUTH</name>
          <displayName>TPMUTH</displayName>
          <description>Power Module Temperature Monitor Threshold Register</description>
          <addressOffset>0x00000038</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x0FFF0000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- MIN: Minimum allowed power module temperature code -->
            <field>
              <name>MIN</name>
              <description>Minimum allowed power module temperature code</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- MAX: Maximum allowed power module temperature code -->
            <field>
              <name>MAX</name>
              <description>Maximum allowed power module temperature code</description>
              <bitRange>[27:16]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- TLINTH: LIN PHY Temperature Monitor Threshold Register -->
        <register>
          <name>TLINTH</name>
          <displayName>TLINTH</displayName>
          <description>LIN PHY Temperature Monitor Threshold Register</description>
          <addressOffset>0x0000003C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x0FFF0000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- MIN: Minimum allowed LIN PHY temperature code -->
            <field>
              <name>MIN</name>
              <description>Minimum allowed LIN PHY temperature code</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- MAX: Maximum allowed LIN PHY temperature code -->
            <field>
              <name>MAX</name>
              <description>Maximum allowed LIN PHY temperature code</description>
              <bitRange>[27:16]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- TMCUTH: Controller Temperature Monitor Threshold Register -->
        <register>
          <name>TMCUTH</name>
          <displayName>TMCUTH</displayName>
          <description>Controller Temperature Monitor Threshold Register</description>
          <addressOffset>0x00000040</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
