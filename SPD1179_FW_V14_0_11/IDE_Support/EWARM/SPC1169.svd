                  <description>1-byte.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>2-bytes.</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
