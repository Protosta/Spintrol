            <field>
              <name>CH6WE</name>
              <description>CH6 bit write enable</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable. This bit is self-cleared to 0.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CH7WE: CH7 bit write enable -->
            <field>
              <name>CH7WE</name>
              <description>CH7 bit write enable</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable. This bit is self-cleared to 0.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>DMACH0</name>
      <description></description>
      <groupName>DMACH</groupName>
      <baseAddress>0x40001C00</baseAddress>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>88</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>

        <!-- DMACHSA: DMA Channel Source Address Register -->
        <register>
          <name>DMACHSA</name>
          <displayName>DMACHSA</displayName>
          <description>DMA Channel Source Address Register</description>
          <addressOffset>0x00000000</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- ADDR: Current source address of DMA transfer.\nThis register must be written with a 32-bit aligned address.\nIt is updated after each source transfer according to DMACHCTL0.SINC -->
            <field>
              <name>ADDR</name>
              <description>Current source address of DMA transfer.\nThis register must be written with a 32-bit aligned address.\nIt is updated after each source transfer according to DMACHCTL0.SINC</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- DMACHDA: DMA Channel Destination Address Register -->
        <register>
          <name>DMACHDA</name>
          <displayName>DMACHDA</displayName>
          <description>DMA Channel Destination Address Register</description>
          <addressOffset>0x00000008</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- ADDR: Current Destination address of DMA transfer. \nThis register must be written with a 32-bit aligned address.\nIt is updated after each source transfer according to DMACHCTL0.DINC -->
            <field>
              <name>ADDR</name>
              <description>Current Destination address of DMA transfer. \nThis register must be written with a 32-bit aligned address.\nIt is updated after each source transfer according to DMACHCTL0.DINC</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- DMACHCTL0: DMA Channel Control Register 0 -->
        <register>
          <name>DMACHCTL0</name>
          <displayName>DMACHCTL0</displayName>
          <description>DMA Channel Control Register 0</description>
          <addressOffset>0x00000018</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00304801</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- IE: Interrupt enable\nThis bit does not affect the raw interrupt flag generation -->
            <field>
              <name>IE</name>
              <description>Interrupt enable\nThis bit does not affect the raw interrupt flag generation</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable interrupt</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable interrupt</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DWIDTH: Destination transfer width.\nIt should not exceed AHB bus HDATA width (32-bits).\nFor a non-memory peripheral, typically the peripheral (destination) FIFO width. -->
            <field>
              <name>DWIDTH</name>
              <description>Destination transfer width.\nIt should not exceed AHB bus HDATA width (32-bits).\nFor a non-memory peripheral, typically the peripheral (destination) FIFO width.</description>
              <bitRange>[3:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>U8</name>
                  <description>Byte (8-bits)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>U16</name>
                  <description>Half-word (16-bits)</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>U32</name>
                  <description>Word (32-bits)</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>U64</name>
                  <description>Double-word (64-bits)</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>U128</name>
                  <description>Four-word (128-bits)</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>U256</name>
                  <description>Eight-word (256-bits)</description>
                  <value>0x5</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SWIDTH: Source transfer width.\nIt should not exceed AHB bus HDATA width (32-bits).\nFor a non-memory peripheral, typically the peripheral (source) FIFO width. -->
            <field>
              <name>SWIDTH</name>
              <description>Source transfer width.\nIt should not exceed AHB bus HDATA width (32-bits).\nFor a non-memory peripheral, typically the peripheral (source) FIFO width.</description>
              <bitRange>[6:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>U8</name>
                  <description>Byte (8-bits)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>U16</name>
                  <description>Half-word (16-bits)</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>U32</name>
                  <description>Word (32-bits)</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>U64</name>
                  <description>Double-word (64-bits)</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>U128</name>
                  <description>Four-word (128-bits)</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>U256</name>
                  <description>Eight-word (256-bits)</description>
                  <value>0x5</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DINC: Destination address increment after each transfer.\nIncrementing or decrementing is done for alignment to the next DWIDTH boundary. -->
            <field>
              <name>DINC</name>
              <description>Destination address increment after each transfer.\nIncrementing or decrementing is done for alignment to the next DWIDTH boundary.</description>
              <bitRange>[8:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>INCREASE</name>
                  <description>Increase to next word aligned address</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DECREASE</name>
                  <description>Decrease to next word aligned address</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NO_CHANGE</name>
                  <description>Freeze the address</description>
                  <value>0x2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SINC: Source address increment after each transfer.\nIncrementing or decrementing is done for alignment to the next SWIDTH boundary. -->
            <field>
              <name>SINC</name>
              <description>Source address increment after each transfer.\nIncrementing or decrementing is done for alignment to the next SWIDTH boundary.</description>
              <bitRange>[10:9]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>INCREASE</name>
                  <description>Increase to next word aligned address</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DECREASE</name>
                  <description>Decrease to next word aligned address</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NO_CHANGE</name>
                  <description>Freeze the address</description>
                  <value>0x2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DSIZE: Destination burst transaction length.\nNumber of data items, each of width DWIDTH, to be written to the destination every time a destination burst transaction request is made from the corresponding handshaking interface.\nNote: This value is not related to the AHB master HBURST signal. -->
            <field>
              <name>DSIZE</name>
              <description>Destination burst transaction length.\nNumber of data items, each of width DWIDTH, to be written to the destination every time a destination burst transaction request is made from the corresponding handshaking interface.\nNote: This value is not related to the AHB master HBURST signal.</description>
              <bitRange>[13:11]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>1_WORD</name>
                  <description>1 word (32-bit)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4_WORD</name>
                  <description>4 words</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>8_WORD</name>
                  <description>8 words</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>16_WORD</name>
                  <description>16 words</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>32_WORD</name>
                  <description>32 words</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>64_WORD</name>
                  <description>64 words</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>128_WORD</name>
                  <description>128 words</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>256_WORD</name>
                  <description>256 words</description>
                  <value>0x7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SSIZE: Source burst transaction length.\nNumber of data items, each of width SWIDTH, to be read from the source every time a source burst transaction request is made the corresponding handshaking interface.\nNote: This value is not related to the AHB master HBURST signal. -->
            <field>
              <name>SSIZE</name>
              <description>Source burst transaction length.\nNumber of data items, each of width SWIDTH, to be read from the source every time a source burst transaction request is made the corresponding handshaking interface.\nNote: This value is not related to the AHB master HBURST signal.</description>
              <bitRange>[16:14]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>1_WORD</name>
                  <description>1 word (32-bit)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4_WORD</name>
                  <description>4 words</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>8_WORD</name>
                  <description>8 words</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>16_WORD</name>
                  <description>16 words</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>32_WORD</name>
                  <description>32 words</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>64_WORD</name>
                  <description>64 words</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>128_WORD</name>
                  <description>128 words</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>256_WORD</name>
                  <description>256 words</description>
                  <value>0x7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TT: Transfer type.\nFor multi-block transfers using linked list operation, TT must be\nconstant for all blocks of this multi-block transfer. -->
            <field>
              <name>TT</name>
              <description>Transfer type.\nFor multi-block transfers using linked list operation, TT must be\nconstant for all blocks of this multi-block transfer.</description>
              <bitRange>[22:20]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>MEM_TO_MEM</name>
                  <description>Memory to memory, DMAC is flow controller</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MEM_TO_PER</name>
                  <description>Memory to peripheral, DMAC is flow controller</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PER_TO_MEM</name>
                  <description>Peripheral to memory, DMAC is flow controller</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PER_TO_PER</name>
                  <description>Peripheral to peripheral, DMAC is flow controller</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PER_TO_MEM_SFC</name>
                  <description>Peripheral to memory, source peripheral is flow controller</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PER_TO_PER_SFC</name>
                  <description>Peripheral to peripheral, source peripheral is flow controller</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MEM_TO_PER_DFC</name>
                  <description>Memory to peripheral, destination peripheral is flow controller</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PER_TO_PER_DFC</name>
                  <description>Peripheral to peripheral, destination peripheral is flow controller</description>
                  <value>0x7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- DMACHCTL1: DMA Channel Control Register 1 -->
        <register>
          <name>DMACHCTL1</name>
          <displayName>DMACHCTL1</displayName>
          <description>DMA Channel Control Register 1</description>
          <addressOffset>0x0000001C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000002</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- BLKTS: Block transfer size.\nWhich is the total number of single transactions to perform for every block transfer; a single transaction is mapped to a single AMBA beat.\nThe width of the single transaction is determined by DMACHCTL0.SWIDTH.\nThis field must be written before the channel is enabled in order to indicate the block size. -->
            <field>
              <name>BLKTS</name>
              <description>Block transfer size.\nWhich is the total number of single transactions to perform for every block transfer; a single transaction is mapped to a single AMBA beat.\nThe width of the single transaction is determined by DMACHCTL0.SWIDTH.\nThis field must be written before the channel is enabled in order to indicate the block size.</description>
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- DMACHCFG0: DMA Channel Configure Register 0 -->
        <register>
          <name>DMACHCFG0</name>
          <displayName>DMACHCFG0</displayName>
          <description>DMA Channel Configure Register 0</description>
          <addressOffset>0x00000040</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000E00</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- PRIORITY: Channel priority.\nThis field must be written as a value within 0 to 7 while 0 is the lowest priority -->
            <field>
              <name>PRIORITY</name>
              <description>Channel priority.\nThis field must be written as a value within 0 to 7 while 0 is the lowest priority</description>
              <bitRange>[7:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>8TH_PRIORITY</name>
                  <description>8th priority (Lowest)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>7TH_PRIORITY</name>
                  <description>7th priority</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>6TH_PRIORITY</name>
                  <description>6th priority</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>5TH_PRIORITY</name>
                  <description>5th priority</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4TH_PRIORITY</name>
                  <description>4th priority</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3RD_PRIORITY</name>
                  <description>3rd priority</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2ND_PRIORITY</name>
                  <description>2nd priority</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1ST_PRIORITY</name>
                  <description>1st priority (Highest)</description>
                  <value>0x7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SUSPEND: Channel suspend.\nSuspends all DMA data transfers from the source until this bit is cleared. There is no guarantee that the current transaction will complete. Can also be used in conjunction with FIFODAV bit to cleanly disable a channel without losing any data. -->
            <field>
              <name>SUSPEND</name>
              <description>Channel suspend.\nSuspends all DMA data transfers from the source until this bit is cleared. There is no guarantee that the current transaction will complete. Can also be used in conjunction with FIFODAV bit to cleanly disable a channel without losing any data.</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Not suspended.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Suspend DMA transfer from the source.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- FIFOEMPTY: Indicates if there is data left in the channel FIFO.\nCan be used in conjunction with SUSPEND bit to cleanly disable a channel. -->
            <field>
              <name>FIFOEMPTY</name>
              <description>Indicates if there is data left in the channel FIFO.\nCan be used in conjunction with SUSPEND bit to cleanly disable a channel.</description>
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_EMPTY</name>
                  <description>There is data left in the FIFO</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EMPTY</name>
                  <description>FIFO is fully empty</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DSWHS: Destination software handshaking select.\nThis bit is ignored if the destination is memory -->
            <field>
              <name>DSWHS</name>
              <description>Destination software handshaking select.\nThis bit is ignored if the destination is memory</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>HARDWARE</name>
                  <description>Hardware handshaking</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SOFTWARE</name>
                  <description>Software handshaking</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SSWHS: Source software handshaking select.\nThis bit is ignored if the source is memory -->
            <field>
              <name>SSWHS</name>
              <description>Source software handshaking select.\nThis bit is ignored if the source is memory</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>HARDWARE</name>
                  <description>Hardware handshaking</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SOFTWARE</name>
                  <description>Software handshaking</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DHSPOL: Destination handshaking interface polarity. -->
            <field>
              <name>DHSPOL</name>
              <description>Destination handshaking interface polarity.</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ACTIVE_LOW</name>
                  <description>Active low</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACTIVE_HIGH</name>
                  <description>Active high</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SHSPOL: Source handshaking interface polarity. -->
            <field>
              <name>SHSPOL</name>
              <description>Source handshaking interface polarity.</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ACTIVE_LOW</name>
                  <description>Active low</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACTIVE_HIGH</name>
                  <description>Active high</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SRLD: Automatic source reload.\nThe DMACHSA register can be automatically reloaded from its initial value at the end of every block for multi-block transfers. A new block transfer is then initiated. -->
            <field>
              <name>SRLD</name>
              <description>Automatic source reload.\nThe DMACHSA register can be automatically reloaded from its initial value at the end of every block for multi-block transfers. A new block transfer is then initiated.</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DRLD: Automatic destination reload.\nThe DMACHDA register can be automatically reloaded from its initial value at the end of every block for multi-block transfers. A new block transfer is then initiated. -->
            <field>
              <name>DRLD</name>
              <description>Automatic destination reload.\nThe DMACHDA register can be automatically reloaded from its initial value at the end of every block for multi-block transfers. A new block transfer is then initiated.</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
