              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DATA</name>
                  <description>Message is data frame.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>REMOTE</name>
                  <description>Message is remote frame.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- CANMBOXMTS: Mailbox Message Timestamp Register Note: Read only. -->
        <register>
          <name>CANMBOXMTS</name>
          <displayName>CANMBOXMTS</displayName>
          <description>Mailbox Message Timestamp Register\nNote: Read only.</description>
          <addressOffset>0x00000048</addressOffset>
          <!-- registerPropertiesGroup -->
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
