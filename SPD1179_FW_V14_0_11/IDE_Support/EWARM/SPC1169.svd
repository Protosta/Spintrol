                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- ADCOFFSET: ADC Offset Trim Register [%s] -->
        <register>
          <!-- dimElementGroup -->
          <dim>16</dim>
          <dimIncrement>4</dimIncrement>
          <!-- end of dimElementGroup -->
          <name>ADCOFFSET[%s]</name>
          <displayName>ADCOFFSET[%s]</displayName>
          <description>ADC Offset Trim Register [%s]</description>
          <addressOffset>0x00000078</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Offset trimming (signed number) for ADCRESULT0\nShould be within [-4096, 4095] -->
            <field>
              <name>VAL</name>
              <description>Offset trimming (signed number) for ADCRESULT0\nShould be within [-4096, 4095]</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- ADCGAIN: ADC Gain Trim Register [%s] -->
        <register>
          <!-- dimElementGroup -->
          <dim>16</dim>
          <dimIncrement>4</dimIncrement>
          <!-- end of dimElementGroup -->
          <name>ADCGAIN[%s]</name>
