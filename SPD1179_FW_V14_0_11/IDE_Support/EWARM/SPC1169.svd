                  <name>OCCUR</name>
                  <description>SOC1 interrupt overflow</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SOC2: SOC2 (Start of Conversion) overflow flag\nThis indicates an SOC2 interrupt was generated while an existing SOC2 interrupt was already pending. This overflow flag can&apos;t stop SOC2 interrupts from being processing. It just show that a trigger was missed.  -->
