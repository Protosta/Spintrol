                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>5</name>
                  <description>5-bytes.</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>6</name>
                  <description>6-bytes.</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>7</name>
                  <description>7-bytes.</description>
                  <value>0x7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>8</name>
                  <description>8-bytes.</description>
                  <value>0x8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>12</name>
                  <description>12-bytes, valid for CANFD only.\nIf set for CAN format, DLC force to 8-bytes.</description>
                  <value>0x9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>16</name>
