        <!-- SHFLG: ADC Sample Hold Channel EOC Flag Register -->
        <register>
          <name>SHFLG</name>
          <displayName>SHFLG</displayName>
          <description>ADC Sample Hold Channel EOC Flag Register</description>
          <addressOffset>0x00000110</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- SHRDY0: SHRAWCODE0 ready flag -->
            <field>
              <name>SHRDY0</name>
              <description>SHRAWCODE0 ready flag</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_READY</name>
                  <description>SHRAWCODE0 not ready</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>READY</name>
                  <description>SHRAWCODE0 ready</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- SHFLGCLR: ADC Sample Hold Channel EOC Flag Clear Register -->
        <register>
          <name>SHFLGCLR</name>
          <displayName>SHFLGCLR</displayName>
          <description>ADC Sample Hold Channel EOC Flag Clear Register</description>
          <addressOffset>0x00000114</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- SHRDY0: SHRAWCODE0 ready flag clear -->
            <field>
              <name>SHRDY0</name>
              <description>SHRAWCODE0 ready flag clear</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write a 0 has no effect and always read back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write a 1 clears ADCSTS[SHRDY0]. This bit is self-cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- ADCCTL: ADC Control Register -->
        <register>
          <name>ADCCTL</name>
