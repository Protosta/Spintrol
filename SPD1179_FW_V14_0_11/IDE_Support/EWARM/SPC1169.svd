              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FROM_A</name>
                  <description>Input A is the source for rising-edge delay</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FROM_B</name>
                  <description>Input B is the source for rising-edge delay</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- FEDSRC: Falling-edge delay source -->
            <field>
              <name>FEDSRC</name>
              <description>Falling-edge delay source</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FROM_A</name>
                  <description>Input A is the source for falling-edge delay</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FROM_B</name>
                  <description>Input B is the source for falling-edge delay</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- REDPOL: Rising-edge delay output polarity -->
            <field>
              <name>REDPOL</name>
              <description>Rising-edge delay output polarity</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ACTIVE_LOW</name>
                  <description>Rising-edge delay output is inverted to have active-low polarity</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACTIVE_HIGH</name>
                  <description>Rising-edge delay output keeps the original active-high polarity</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- FEDPOL: Falling-edge delay output polarity -->
            <field>
              <name>FEDPOL</name>
              <description>Falling-edge delay output polarity</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ACTIVE_LOW</name>
                  <description>Falling-edge delay output is inverted to have active-low polarity</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACTIVE_HIGH</name>
                  <description>Falling-edge delay output keeps the original active-high polarity</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- OUTASRC: Output A source -->
            <field>
              <name>OUTASRC</name>
