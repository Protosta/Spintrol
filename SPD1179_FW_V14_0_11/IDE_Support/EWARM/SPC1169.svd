              </enumeratedValues>
            </field>

            <!-- ACTSFB: Action when one-time software force B is invoked -->
            <field>
              <name>ACTSFB</name>
              <description>Action when one-time software force B is invoked</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DO_NOTHING</name>
                  <description>Do nothing (action disabled)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SET_LOW</name>
                  <description>Clear (force PWM output B to low</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SET_HIGH</name>
                  <description>Set (force PWM output B to high</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TOGGLE</name>
                  <description>Toggle (invert current PWM AQ output B status)</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CSFLOAD: Options to load continuous software force register (AQCSFRC) active value from shadow register -->
            <field>
              <name>CSFLOAD</name>
              <description>Options to load continuous software force register (AQCSFRC) active value from shadow register</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LOAD_ON_ZERO</name>
                  <description>Load from AQCSFRC into AQCSFRCA on TBCNT=0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOAD_ON_PERIOD</name>
                  <description>Load from AQCSFRC into AQCSFRCA on TBCNT=TBPRD</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOAD_ON_ZERO_PERIOD</name>
                  <description>Load from AQCSFRC into AQCSFRCA on TBCNT=Zero or TBCNT=TBPRD</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOAD_IMMEDIATE</name>
                  <description>Write AQCSFRC immediately change the active value in AQCSFRCA</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- OTSFRC: One-time software forced event on output -->
            <field>
              <name>OTSFRC</name>
              <description>One-time software forced event on output</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write a 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORCE_A</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORCE_B</name>
                  <description></description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORCE_A_AND_B</name>
                  <description>Write a 1 initialize a one-cycle force pulse. This bit is self-cleared to 0</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- AQCSFRC: Action-Qualifier Continuous Software Force Register -->
        <register>
          <name>AQCSFRC</name>
          <displayName>AQCSFRC</displayName>
          <description>Action-Qualifier Continuous Software Force Register</description>
          <addressOffset>0x0000006C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- CSFA: Continuous software force on output A -->
            <field>
              <name>CSFA</name>
              <description>Continuous software force on output A</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Forcing disabled</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORCE_CONTINUOUS_LOW</name>
                  <description>Force a continuous low on output A</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORCE_CONTINUOUS_HIGH</name>
                  <description>Force a continuous high on output A</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Invalid option</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CSFB: Continuous software force on output B -->
            <field>
              <name>CSFB</name>
              <description>Continuous software force on output B</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Forcing disabled</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORCE_CONTINUOUS_LOW</name>
                  <description>Force a continuous low on output B</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORCE_CONTINUOUS_HIGH</name>
                  <description>Force a continuous high on output B</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Invalid option</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- AQCSFRCA: Action-Qualifier Continuous Software Force Active Register -->
        <register>
          <name>AQCSFRCA</name>
          <displayName>AQCSFRCA</displayName>
          <description>Action-Qualifier Continuous Software Force Active Register</description>
          <addressOffset>0x00000070</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- CSFA: Continuous software force on output A -->
            <field>
              <name>CSFA</name>
              <description>Continuous software force on output A</description>
              <bitRange>[1:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Forcing disabled</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORCE_CONTINUOUS_LOW</name>
                  <description>Force a continuous low on output A</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORCE_CONTINUOUS_HIGH</name>
                  <description>Force a continuous high on output A</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Invalid option</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CSFB: Continuous software force on output B -->
            <field>
              <name>CSFB</name>
              <description>Continuous software force on output B</description>
              <bitRange>[9:8]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Forcing disabled</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORCE_CONTINUOUS_LOW</name>
                  <description>Force a continuous low on output B</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORCE_CONTINUOUS_HIGH</name>
                  <description>Force a continuous high on output B</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Invalid option</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- DBCTL: Dead-Band Generator Control Register -->
        <register>
          <name>DBCTL</name>
          <displayName>DBCTL</displayName>
          <description>Dead-Band Generator Control Register</description>
          <addressOffset>0x00000074</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000070</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- REDEN: Rising-edge delay enable -->
            <field>
              <name>REDEN</name>
              <description>Rising-edge delay enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Rising-edge delay is bypassed and the input from action-qualifier goes to the submodule directly</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Rising-edge delay is enabled and applied at output A</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- FEDEN: Falling-edge delay enable -->
            <field>
              <name>FEDEN</name>
              <description>Falling-edge delay enable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Falling-edge delay is bypassed and the input from action-qualifier goes to the submodule directly</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Falling-edge delay is enabled and applied at output B</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- REDSRC: Rising-edge delay source -->
            <field>
              <name>REDSRC</name>
              <description>Rising-edge delay source</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FROM_A</name>
                  <description>Input A is the source for rising-edge delay</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FROM_B</name>
                  <description>Input B is the source for rising-edge delay</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- FEDSRC: Falling-edge delay source -->
            <field>
              <name>FEDSRC</name>
              <description>Falling-edge delay source</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FROM_A</name>
                  <description>Input A is the source for falling-edge delay</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FROM_B</name>
                  <description>Input B is the source for falling-edge delay</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- REDPOL: Rising-edge delay output polarity -->
            <field>
              <name>REDPOL</name>
              <description>Rising-edge delay output polarity</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ACTIVE_LOW</name>
                  <description>Rising-edge delay output is inverted to have active-low polarity</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACTIVE_HIGH</name>
                  <description>Rising-edge delay output keeps the original active-high polarity</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- FEDPOL: Falling-edge delay output polarity -->
            <field>
              <name>FEDPOL</name>
              <description>Falling-edge delay output polarity</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ACTIVE_LOW</name>
                  <description>Falling-edge delay output is inverted to have active-low polarity</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACTIVE_HIGH</name>
                  <description>Falling-edge delay output keeps the original active-high polarity</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- OUTASRC: Output A source -->
            <field>
              <name>OUTASRC</name>
              <description>Output A source</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FALLING_EDGE</name>
                  <description>Falling-edge delay path is selected as output A</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RISING_EDGE</name>
                  <description>Rising-edge delay path is selected as output A</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- OUTBSRC: Output B source -->
            <field>
              <name>OUTBSRC</name>
              <description>Output B source</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FALLING_EDGE</name>
                  <description>Falling-edge delay path is selected as output B</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RISING_EDGE</name>
                  <description>Rising-edge delay path is selected as output B</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DUALEDGE: Dual-edge delay mode -->
            <field>
              <name>DUALEDGE</name>
              <description>Dual-edge delay mode</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Rising-edge delay and falling-edge delay are two separate paths</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Rising-edge delay path output serves as input for Falling-edge delay path</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- HALFCYCLE: Half cycle clocking enable -->
            <field>
              <name>HALFCYCLE</name>
              <description>Half cycle clocking enable</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Full cycle clocking enabled. The dead-band counter is clocked at TBCLK.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Half cycle clocking enabled. The dead-band counter is clocked at 2x TBCLK.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CTLWE: 10 LSBs of the dead-band control write enable\nIn order to write the 10 LSBs, this bit need to be write 1 simultaneously -->
            <field>
              <name>CTLWE</name>
              <description>10 LSBs of the dead-band control write enable\nIn order to write the 10 LSBs, this bit need to be write 1 simultaneously</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>10 LSBs will not be written</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>10 LSBs will be written</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DBCTLLOAD: DBCTL[9:0] active value load mode\nIt has no effect when DBCTL[DBCTLLOCK]=1 -->
            <field>
              <name>DBCTLLOAD</name>
              <description>DBCTL[9:0] active value load mode\nIt has no effect when DBCTL[DBCTLLOCK]=1</description>
              <bitRange>[17:16]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LOAD_ON_ZERO</name>
                  <description>Load DBCTL[9:0] into DBCTLA on TBCNT=0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOAD_ON_PERIOD</name>
                  <description>Load DBCTL[9:0] into DBCTLA on TBCNT=TBPRD</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOAD_ON_ZERO_PERIOD</name>
                  <description>Load DBCTL[9:0] into DBCTLA on TBCNT=0 or TBCNT=TBPRD</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOAD_IMMEDIATE</name>
                  <description>Write DBCTL[9:0] will immediately change the active value in DBCTLA</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DBCTLLOCK: DBCTL[9:0] active value lock -->
            <field>
              <name>DBCTLLOCK</name>
              <description>DBCTL[9:0] active value lock</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>UNLOCK</name>
                  <description>Active value in DBCTLA is updated according to DBCTL[DBCTLLOAD]</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOCK</name>
                  <description>Active value in DBCTLA will not change</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DBREDLOAD: DBRED active value load mode\nIt has no effect when DBCTL[DBFEDLOCK]=1 -->
            <field>
              <name>DBREDLOAD</name>
              <description>DBRED active value load mode\nIt has no effect when DBCTL[DBFEDLOCK]=1</description>
              <bitRange>[21:20]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LOAD_ON_ZERO</name>
                  <description>Load DBRED into DBREDA on TBCNT=0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOAD_ON_PERIOD</name>
                  <description>Load DBRED into DBREDA on TBCNT=TBPRD</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOAD_ON_ZERO_PERIOD</name>
                  <description>Load DBRED into DBREDA on TBCNT=0 or TBCNT=TBPRD</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOAD_IMMEDIATE</name>
                  <description>Write DBRED will immediately change the active value in DBREDA</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DBREDLOCK: DBRED active value lock -->
            <field>
              <name>DBREDLOCK</name>
              <description>DBRED active value lock</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>UNLOCK</name>
                  <description>Active value in DBREDA is updated according to DBCTL[DBREDLOAD]</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOCK</name>
                  <description>Active value in DBREDA will not change</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DBFEDLOAD: DBFED active value load mode\nIt has no effect when DBCTL[DBFEDLOCK]=1 -->
            <field>
              <name>DBFEDLOAD</name>
              <description>DBFED active value load mode\nIt has no effect when DBCTL[DBFEDLOCK]=1</description>
              <bitRange>[25:24]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LOAD_ON_ZERO</name>
                  <description>Load DBFED into DBFEDA on TBCNT=0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOAD_ON_PERIOD</name>
                  <description>Load DBFED into DBFEDA on TBCNT=TBPRD</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOAD_ON_ZERO_PERIOD</name>
                  <description>Load DBFED into DBFEDA on TBCNT=0 or TBCNT=TBPRD</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOAD_IMMEDIATE</name>
                  <description>Write DBFED immediately change the active value in DBFEDA</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DBFEDLOCK: DBFED active value lock -->
            <field>
              <name>DBFEDLOCK</name>
              <description>DBFED active value lock</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>UNLOCK</name>
                  <description>Active value in DBFEDA is updated according to DBCTL[DBFEDLOAD]</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOCK</name>
                  <description>Active value in DBFEDA will not change</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- DBCTLA: Dead-Band Generator Control Active Register -->
        <register>
          <name>DBCTLA</name>
          <displayName>DBCTLA</displayName>
          <description>Dead-Band Generator Control Active Register</description>
          <addressOffset>0x00000078</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000070</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- REDEN: Rising-edge delay enable -->
            <field>
              <name>REDEN</name>
              <description>Rising-edge delay enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Rising-edge delay is bypassed and the input from action-qualifier goes to the submodule directly</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Rising-edge delay is enabled and applied at output A</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- FEDEN: Falling-edge delay enable -->
            <field>
              <name>FEDEN</name>
              <description>Falling-edge delay enable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Falling-edge delay is bypassed and the input from action-qualifier goes to the submodule directly</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Falling-edge delay is enabled and applied at output B</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- REDSRC: Rising-edge delay source -->
            <field>
              <name>REDSRC</name>
