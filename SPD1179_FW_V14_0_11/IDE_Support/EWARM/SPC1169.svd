        <!-- DMACHCFG1: DMA Channel Configure Register 1 -->
        <register>
          <name>DMACHCFG1</name>
          <displayName>DMACHCFG1</displayName>
          <description>DMA Channel Configure Register 1</description>
          <addressOffset>0x00000044</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000004</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- FIFOTH: FIFO threshold to determine how much space or data needs to be available in the FIFO before a burst transaction request is serviced. -->
            <field>
              <name>FIFOTH</name>
              <description>FIFO threshold to determine how much space or data needs to be available in the FIFO before a burst transaction request is serviced.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SINGLE_ENTRY</name>
                  <description>Transfer whenever data or space is avaiable in the FIFO</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HALF_DEPTH</name>
                  <description>Destination transfer will not start until data available is greater than or equal to half the FIFO depth.\nSource transfer will not start until data available is greater than half the FIFO depth.\nThe exceptions are at the end of a burst transaction request or at the end of a block transfer.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SPER: Source peripheral that communicated through hardware handshaking interface.\nThis field is ignored if DMACHCFG0.SSWHS=1. -->
