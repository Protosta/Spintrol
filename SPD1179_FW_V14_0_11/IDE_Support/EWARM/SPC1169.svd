                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- FLTDIV: Filter&apos;s clock dividing ratio is (FLTDIV+1) -->
            <field>
              <name>FLTDIV</name>
              <description>Filter&apos;s clock dividing ratio is (FLTDIV+1)</description>
              <bitRange>[20:11]</bitRange>
              <access>read-write</access>
            </field>

            <!-- FLTWIN: Filter&apos;s window size is (FLTWIN+1) samples -->
            <field>
              <name>FLTWIN</name>
              <description>Filter&apos;s window size is (FLTWIN+1) samples</description>
              <bitRange>[25:21]</bitRange>
              <access>read-write</access>
            </field>

            <!-- FLTTH: Filter&apos;s threhold is (FLTTH+1) 1&apos;s/0&apos;s for output to toggle -->
            <field>
              <name>FLTTH</name>
              <description>Filter&apos;s threhold is (FLTTH+1) 1&apos;s/0&apos;s for output to toggle</description>
              <bitRange>[30:26]</bitRange>
              <access>read-write</access>
            </field>

            <!-- FLTRST: Reset all registers in the filter with the input -->
            <field>
              <name>FLTRST</name>
              <description>Reset all registers in the filter with the input</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect. Always read back 0.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RESET</name>
                  <description>Write 1 will fill all registers in the filter with the input</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- EPWRCTL: ePower Module Control Register -->
        <register>
          <name>EPWRCTL</name>
          <displayName>EPWRCTL</displayName>
          <description>ePower Module Control Register</description>
          <addressOffset>0x00000014</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000201</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- SCLKDIV: Set the serial interface clock dividing ratio from HCLK to (SCLKDIV+1)\nThe minimum value is 1. Write 0 will be ignored. -->
            <field>
              <name>SCLKDIV</name>
              <description>Set the serial interface clock dividing ratio from HCLK to (SCLKDIV+1)\nThe minimum value is 1. Write 0 will be ignored.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- SIFBC: Serial interface backward compatible mode -->
            <field>
              <name>SIFBC</name>
              <description>Serial interface backward compatible mode</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NORMAL</name>
                  <description>6-bit address &amp; 16-bit data</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>COMPATIBLE</name>
                  <description>5-bit address &amp; 8-bit data</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CHKWKUP: Check wakeup condition when issue stop or sleep command -->
            <field>
              <name>CHKWKUP</name>
              <description>Check wakeup condition when issue stop or sleep command</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO</name>
                  <description>Do not check the wakeup condition and always issue sleep or stop command per software request</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>YES</name>
                  <description>Check wakeup condition and do not issue sleep or stop command if wakeup condition is already met</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TZSEL4GPIO: Select which TZ signal is to output to GPIO -->
            <field>
              <name>TZSEL4GPIO</name>
              <description>Select which TZ signal is to output to GPIO</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EPWRTZ0</name>
                  <description>EPWRTZ0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EPWRTZ1</name>
                  <description>EPWRTZ1</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PWM0CLRTZ0: Enable SYNC from PWM0 to clear the latched EPWRTZ0 status -->
            <field>
              <name>PWM0CLRTZ0</name>
              <description>Enable SYNC from PWM0 to clear the latched EPWRTZ0 status</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PWM1CLRTZ0: Enable SYNC from PWM1 to clear the latched EPWRTZ0 status -->
            <field>
              <name>PWM1CLRTZ0</name>
              <description>Enable SYNC from PWM1 to clear the latched EPWRTZ0 status</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PWM2CLRTZ0: Enable SYNC from PWM2 to clear the latched EPWRTZ0 status -->
            <field>
              <name>PWM2CLRTZ0</name>
              <description>Enable SYNC from PWM2 to clear the latched EPWRTZ0 status</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PWM3CLRTZ0: Enable SYNC from PWM3 to clear the latched EPWRTZ0 status -->
            <field>
              <name>PWM3CLRTZ0</name>
              <description>Enable SYNC from PWM3 to clear the latched EPWRTZ0 status</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PWM0CLRTZ1: Enable SYNC from PWM0 to clear the latched EPWRTZ1 status -->
            <field>
              <name>PWM0CLRTZ1</name>
              <description>Enable SYNC from PWM0 to clear the latched EPWRTZ1 status</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PWM1CLRTZ1: Enable SYNC from PWM1 to clear the latched EPWRTZ1 status -->
            <field>
              <name>PWM1CLRTZ1</name>
              <description>Enable SYNC from PWM1 to clear the latched EPWRTZ1 status</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PWM2CLRTZ1: Enable SYNC from PWM2 to clear the latched EPWRTZ1 status -->
            <field>
              <name>PWM2CLRTZ1</name>
              <description>Enable SYNC from PWM2 to clear the latched EPWRTZ1 status</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PWM3CLRTZ1: Enable SYNC from PWM3 to clear the latched EPWRTZ1 status -->
            <field>
              <name>PWM3CLRTZ1</name>
              <description>Enable SYNC from PWM3 to clear the latched EPWRTZ1 status</description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- EPWRSCTL: ePower Module Serial Interface Control Register -->
        <register>
          <name>EPWRSCTL</name>
          <displayName>EPWRSCTL</displayName>
          <description>ePower Module Serial Interface Control Register</description>
          <addressOffset>0x00000018</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- WDATA: Data to write to ePower module for register with specified address. -->
            <field>
              <name>WDATA</name>
              <description>Data to write to ePower module for register with specified address.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- ADDR: Register address to be read or write via the serial interface -->
            <field>
              <name>ADDR</name>
              <description>Register address to be read or write via the serial interface</description>
              <bitRange>[21:16]</bitRange>
              <access>read-write</access>
            </field>

            <!-- CMD: Serial interface command.\nFor command to write register shadow value, the register address and the register value to write should be also specified.\nFor command to read register active value, the register address should be also specified. -->
            <field>
              <name>CMD</name>
              <description>Serial interface command.\nFor command to write register shadow value, the register address and the register value to write should be also specified.\nFor command to read register active value, the register address should be also specified.</description>
              <bitRange>[24:22]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>GET_ID</name>
                  <description>Get the ePower chip ID.\nThe returned 16-bit ID is stored in EPWRSRDAT register.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>WRITE_SHADOW</name>
                  <description>Write register shadow value.</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>WRITE_ACTIVE</name>
                  <description>Write register active value from the shadow value.\nThis command needs to be right after a succseful WR_SHADOW command.\nIf it fails, user only needs to re-issue the WR_ACTIVE command.</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>READ_ACTIVE</name>
                  <description>Read register active value.</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RESET_REG</name>
                  <description>Software reset  registers.</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FEED_WDT</name>
                  <description>Feed the watchdog</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>STOP</name>
                  <description>Put the whole system into stop mode</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SLEEP</name>
                  <description>Put the whole system into sleep mode</description>
                  <value>0x7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- WKEY: Write key for this register\nWrite 0x7F to this field results in:\n1. Update CMD, ADDR, WDATA fields of the register.\n2. Starts a new command execution\n3. Sets EPWRSTS register to 0x1.\nThis filed is automatcally cleared to 0x0. -->
            <field>
              <name>WKEY</name>
              <description>Write key for this register\nWrite 0x7F to this field results in:\n1. Update CMD, ADDR, WDATA fields of the register.\n2. Starts a new command execution\n3. Sets EPWRSTS register to 0x1.\nThis filed is automatcally cleared to 0x0.</description>
              <bitRange>[31:25]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- EPWRSRDAT: ePower Module Serial Interface Read Data Register -->
        <register>
          <name>EPWRSRDAT</name>
          <displayName>EPWRSRDAT</displayName>
          <description>ePower Module Serial Interface Read Data Register</description>
          <addressOffset>0x0000001C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- RDATA: ePower chip ID by GET_ID command or register value readback by RD_ACTIVE command -->
            <field>
              <name>RDATA</name>
              <description>ePower chip ID by GET_ID command or register value readback by RD_ACTIVE command</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- EPWRSSTS: ePower Module Serial Interface Status Register -->
        <register>
          <name>EPWRSSTS</name>
          <displayName>EPWRSSTS</displayName>
          <description>ePower Module Serial Interface Status Register</description>
          <addressOffset>0x00000020</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- BUSY: ePower serial interface bus busy status -->
            <field>
              <name>BUSY</name>
              <description>ePower serial interface bus busy status</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>IDLE</name>
                  <description>Serial interface is idle</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BUSY</name>
                  <description>Serial interface is busy on communication</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- ERROR: ePower serial interface error status for the latest communication -->
            <field>
              <name>ERROR</name>
              <description>ePower serial interface error status for the latest communication</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CORRECT</name>
                  <description>The latest commnucation is done without error</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ERROR</name>
                  <description>The latest commnucation is done with error</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- EPWRREGKEY: ePower Module Register Write-Allow Key Register -->
        <register>
          <name>EPWRREGKEY</name>
          <displayName>EPWRREGKEY</displayName>
          <description>ePower Module Register Write-Allow Key Register</description>
          <addressOffset>0x00000024</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x1ACCE551</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- KEY: Write 0x1ACCE551 to unlock protected registers -->
            <field>
              <name>KEY</name>
              <description>Write 0x1ACCE551 to unlock protected registers</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>PHCOMP</name>
      <description></description>
      <groupName>PHCOMP</groupName>
      <baseAddress>0x40000500</baseAddress>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>40</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
         <name>PHCOMP</name>
         <description>PHCOMP Interrupt</description>
         <value>39</value>
      </interrupt>
      <registers>

