            </field>

            <!-- IDE: Identifier extension bit. -->
            <field>
              <name>IDE</name>
              <description>Identifier extension bit.</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
