        </register>

        <!-- GLDCTL0: Global Shadow to Active Load Control Register 0 -->
        <register>
          <name>GLDCTL0</name>
          <displayName>GLDCTL0</displayName>
          <description>Global Shadow to Active Load Control Register 0</description>
          <addressOffset>0x00000004</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- GLDEN: Global shadow to active load enable -->
            <field>
              <name>GLDEN</name>
              <description>Global shadow to active load enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Shadow to active load is defined per register regardless of GLDSEL.\ni.e. CMPA load is always controlled by CMPCTL[CMPALOAD]</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Shadow to active load is globally controlled</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- GLDLOAD: Global shadow to active load mode -->
            <field>
              <name>GLDLOAD</name>
              <description>Global shadow to active load mode</description>
              <bitRange>[3:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LOAD_ON_ZERO</name>
                  <description>Load from shadow to active on TBCNT=0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOAD_ON_PERIOD</name>
                  <description>Load from shadow to active on TBCNT=TBPRD</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOAD_ON_ZERO_PERIOD</name>
                  <description>Load from shadow to active on TBCNT=0 or TBCNT=TBPRD</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOAD_ON_SYNC</name>
                  <description>Load from shadow to active on SYNC event</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOAD_ON_SYNC_ZERO</name>
                  <description>Load from shadow to active on SYNC event or TBCNT=0</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOAD_ON_SYNC_PERIOD</name>
                  <description>Load from shadow to active on SYNC event or TBCNT=TBPRD</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOAD_ON_SYNC_ZERO_PERIOD</name>
                  <description>Load from shadow to active on SYNC event, TBCNT=0 or TBCNT=TBPRD</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOAD_ON_FORCE</name>
                  <description>Load from shadow to active on software by writing 1 to GLDCTL1[FRCLOAD]</description>
                  <value>0x7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- GLDPRD: Global shadow to active load strobe period\nNo global load pulse will be generated if GLDPRD=0. Otherwise, the global load pulse is generated when new event comes upon GLDCNT=GLDPRD-1. In other words, the load pulse is generated every GLDPRD events.\nIt has no effect if OSTMODE=1 -->
            <field>
              <name>GLDPRD</name>
              <description>Global shadow to active load strobe period\nNo global load pulse will be generated if GLDPRD=0. Otherwise, the global load pulse is generated when new event comes upon GLDCNT=GLDPRD-1. In other words, the load pulse is generated every GLDPRD events.\nIt has no effect if OSTMODE=1</description>
              <bitRange>[7:4]</bitRange>
              <access>read-write</access>
            </field>

            <!-- GLDCNT: Global shadow to active load strobe counter\nIt indicates how many selected global load events have occurred -->
            <field>
              <name>GLDCNT</name>
              <description>Global shadow to active load strobe counter\nIt indicates how many selected global load events have occurred</description>
              <bitRange>[11:8]</bitRange>
              <access>read-only</access>
            </field>

            <!-- OSTMODE: One-shot global load mode -->
            <field>
              <name>OSTMODE</name>
              <description>One-shot global load mode</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CONTINUOUS_MODE</name>
                  <description>Global strobe is continuously controlled by GLDPRD and GLDCNT</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ONE_SHOT_MODE</name>
                  <description>Global strobe is blocked until GLDCTL1[OSTLOAD] is written with 1</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- GLDCTL1: Global Shadow to Active Load Control Register 1 -->
        <register>
          <name>GLDCTL1</name>
          <displayName>GLDCTL1</displayName>
          <description>Global Shadow to Active Load Control Register 1</description>
          <addressOffset>0x00000008</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- OSTLOAD: Start the one-shot load pending -->
            <field>
              <name>OSTLOAD</name>
              <description>Start the one-shot load pending</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect. Read 0 indicates there is no pending one-shot load</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PENDING</name>
                  <description>Write 1 initialize a one-shot load pending. Upon event defined by GLDCTL[GLDLOAD], the global load happens and this bit is self-cleared to 0.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- FRCLOAD: Global force shadow to active load -->
            <field>
              <name>FRCLOAD</name>
              <description>Global force shadow to active load</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORCE</name>
                  <description>Write 1 generates global load event to the event counter</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- GLDSEL: Global Shadow to Active Load Select Register -->
        <register>
          <name>GLDSEL</name>
          <displayName>GLDSEL</displayName>
          <description>Global Shadow to Active Load Select Register</description>
          <addressOffset>0x0000000C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- TBPRD: TBPRD global shadow to active load select -->
            <field>
              <name>TBPRD</name>
              <description>TBPRD global shadow to active load select</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
