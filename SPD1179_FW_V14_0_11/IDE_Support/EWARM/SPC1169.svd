                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORCE</name>
                  <description>Write a 1 forces a one-shot trip event and sets TZIF bits</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

