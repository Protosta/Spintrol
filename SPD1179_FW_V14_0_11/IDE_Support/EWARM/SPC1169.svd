      <registers>

        <!-- SHADOWSTS: Shadow Status Register -->
        <register>
          <name>SHADOWSTS</name>
          <displayName>SHADOWSTS</displayName>
          <description>Shadow Status Register</description>
          <addressOffset>0x00000000</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- TBPRD: TBPRD shadow status -->
            <field>
              <name>TBPRD</name>
              <description>TBPRD shadow status</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EMPTY</name>
                  <description>A load from TBPRD to TBPRDA clears this bit</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FULL</name>
                  <description>Write to TBPRD set this bit and overwrite current value in TBPRD</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CMPA: CMPA shadow status -->
            <field>
              <name>CMPA</name>
              <description>CMPA shadow status</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EMPTY</name>
                  <description>A load from CMPA to CMPAA clears this bit</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FULL</name>
                  <description>Write to CMPA set this bit and overwrite current value in CMPA</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CMPB: CMPB shadow status -->
            <field>
              <name>CMPB</name>
              <description>CMPB shadow status</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EMPTY</name>
                  <description>A load from CMPB to CMPBA clears this bit</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FULL</name>
                  <description>Write to CMPB set this bit and overwrite current value in CMPB</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CMPC: CMPC shadow status -->
            <field>
              <name>CMPC</name>
              <description>CMPC shadow status</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EMPTY</name>
                  <description>A load from CMPC to CMPCA clears this bit</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FULL</name>
                  <description>Write to CMPC set this bit and overwrite current value in CMPC</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CMPD: CMPD shadow status -->
            <field>
              <name>CMPD</name>
              <description>CMPD shadow status</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EMPTY</name>
                  <description>A load from CMPD to CMPDA clears this bit</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FULL</name>
                  <description>Write to CMPD set this bit and overwrite current value in CMPD</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- AQCTLA: AQCTLA shadow status -->
            <field>
              <name>AQCTLA</name>
              <description>AQCTLA shadow status</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EMPTY</name>
                  <description>A load from AQCTLA to AQCTLAA clears this bit</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FULL</name>
                  <description>Write to AQCTLA set this bit and overwrite current value in AQCTLA</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- AQCTLB: AQCTLB shadow status -->
            <field>
              <name>AQCTLB</name>
              <description>AQCTLB shadow status</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EMPTY</name>
                  <description>A load from AQCTLB to AQCTLBA clears this bit</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FULL</name>
                  <description>Write to AQCTLB set this bit and overwrite current value in AQCTLB</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- AQCSFRC: AQCSFRC shadow status -->
            <field>
              <name>AQCSFRC</name>
              <description>AQCSFRC shadow status</description>
              <bitRange>[7:7]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EMPTY</name>
                  <description>A load from AQCSFRC to AQCSFRCA clears this bit</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
