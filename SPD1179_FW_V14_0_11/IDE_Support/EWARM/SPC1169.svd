              <bitRange>[14:12]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>TRI_STATE</name>
                  <description>Set output B to high-impedance</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SET_LOW</name>
                  <description>Force output B to low state</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SET_HIGH</name>
                  <description>Force output B to high state</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TOGGLE</name>
                  <description>Force output B to invert current state (high-&amp;gt;low, low-&amp;gt;high)</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DO_NOTHING</name>
                  <description>Do nothing for output B</description>
                  <value>0x7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DCBEVT1D: Action on output B when a digital compare B event 1 occurs and TBCNT is counting down -->
            <field>
              <name>DCBEVT1D</name>
              <description>Action on output B when a digital compare B event 1 occurs and TBCNT is counting down</description>
              <bitRange>[17:15]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>TRI_STATE</name>
                  <description>Set output B to high-impedance</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SET_HIGH</name>
                  <description>Force output B to high state</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SET_LOW</name>
                  <description>Force output B to low state</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TOGGLE</name>
                  <description>Force output B to invert current state (high-&amp;gt;low, low-&amp;gt;high)</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DO_NOTHING</name>
                  <description>Do nothing for output B</description>
                  <value>0x7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- TZIF: Trip-Zone Interrupt Flag Register -->
        <register>
          <name>TZIF</name>
          <displayName>TZIF</displayName>
          <description>Trip-Zone Interrupt Flag Register</description>
          <addressOffset>0x000000A4</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- OST: One-shot trip event interrupt flag\nThis bit is always 0 if TZIE.OST=0 -->
            <field>
              <name>OST</name>
              <description>One-shot trip event interrupt flag\nThis bit is always 0 if TZIE.OST=0</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>One-shot trip interrupt does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>One-shot trip interrupt occurred. Further event will not trigger interrupt until this bit is cleared by writing 1 to TZCLR.OST.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CBC: Cycle-by-cycle trip event interrupt flag\nThis bit is always 0 if TZIE.CBC=0 -->
            <field>
              <name>CBC</name>
              <description>Cycle-by-cycle trip event interrupt flag\nThis bit is always 0 if TZIE.CBC=0</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Cycle-by-cycle trip interrupt does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Cycle-by-cycle trip interrupt occurred. Further event will not trigger interrupt until this bit is cleared by wring 1 to TZCLR.CBC. If the cycle-by-cycle trip event is still present when the CBC bit is cleared, it will be immediately set again and a new interrupt is generated.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DCAEVT0: Digital compare A event 0 interrupt flag\nThis bit is always 0 if TZIE.DCAEVT0=0 -->
            <field>
              <name>DCAEVT0</name>
              <description>Digital compare A event 0 interrupt flag\nThis bit is always 0 if TZIE.DCAEVT0=0</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>DCAEVT0 did not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>DCAEVT0 has occurred. It is cleared by writing 1 to TZIC.DCAEVT0.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DCAEVT1: Digital compare A event 1 interrupt flag\nThis bit is always 0 if TZIE.DCAEVT1=0 -->
            <field>
              <name>DCAEVT1</name>
              <description>Digital compare A event 1 interrupt flag\nThis bit is always 0 if TZIE.DCAEVT1=0</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>DCAEVT1 did not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>DCAEVT1 has occurred. It is cleared by writing 1 to TZIC.DCAEVT1.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DCBEVT0: Digital compare B event 0 interrupt flag\nThis bit is always 0 if TZIE.DCAEVT1=0 -->
            <field>
              <name>DCBEVT0</name>
              <description>Digital compare B event 0 interrupt flag\nThis bit is always 0 if TZIE.DCAEVT1=0</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>DCBEVT0 interrupt does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>DCBEVT0 interrupt occured. Further DCBEVT0 event will not trigger interrupt until this bit is cleared by writing 1 to TZIC.DCBEVT0.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DCBEVT1: Digital compare B event 1 interrupt flag\nThis bit is always 0 if TZIE.DCBEVT1=0 -->
            <field>
              <name>DCBEVT1</name>
              <description>Digital compare B event 1 interrupt flag\nThis bit is always 0 if TZIE.DCBEVT1=0</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>DCBEVT interrupt does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>DCBEVT1 interrupt occurred. Further DCBEVT1 event will not trigger interrupt until this bit is cleared by writing 1 to TZIC.DCBEVT1.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- INT: Global trip interrupt flag -->
            <field>
              <name>INT</name>
              <description>Global trip interrupt flag</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>No trip-zone interrupt has been generated</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Trip-zone interrupt was generated and issued to the CPU.\nNo further trip-zone interrupt will be generated until this flag is cleared by writing 1 to TZIC.INT</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- OSTRAW: One-shot trip event raw interrupt flag -->
            <field>
              <name>OSTRAW</name>
              <description>One-shot trip event raw interrupt flag</description>
              <bitRange>[16:16]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>One-shot trip event does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>One-shot trip event occurred. It is cleared by writing 1 to TZCLR.OST.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CBCRAW: Cycle-by-cycle trip event raw interrupt flag -->
            <field>
              <name>CBCRAW</name>
              <description>Cycle-by-cycle trip event raw interrupt flag</description>
              <bitRange>[17:17]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Cycle-by-cycle trip event does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Cycle-by-cycle trip event occurred. It will remain set until it is manually cleared by wring 1 to TZCLR.CBC. If the cycle-by-cycle trip event is still present, it will be immediately set again.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DCAEVT0RAW: Digital compare A event 0 raw interrupt flag -->
            <field>
              <name>DCAEVT0RAW</name>
              <description>Digital compare A event 0 raw interrupt flag</description>
              <bitRange>[18:18]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>DCAEVT0 event does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>DCAEVT0 event occurred. It is cleared by writing 1 to TZIC.DCAEVT0.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DCAEVT1RAW: Digital compare A event 1 raw interrupt flag -->
            <field>
              <name>DCAEVT1RAW</name>
              <description>Digital compare A event 1 raw interrupt flag</description>
              <bitRange>[19:19]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>DCAEVT1 event does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>DCAEVT1 event occurred. It is cleared by writing 1 to TZIC.DCAEVT1.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DCBEVT0RAW: Digital compare B event 0 raw interrupt flag -->
            <field>
              <name>DCBEVT0RAW</name>
              <description>Digital compare B event 0 raw interrupt flag</description>
              <bitRange>[20:20]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>DCBEVT0 event does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>DCBEVT0 event occurred. It is cleared by writing 1 to TZIC.DCBEVT0.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DCBEVT1RAW: Digital compare B event 1 raw interrupt flag -->
            <field>
              <name>DCBEVT1RAW</name>
              <description>Digital compare B event 1 raw interrupt flag</description>
              <bitRange>[21:21]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>DCBEVT1 event does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>DCBEVT1 event occurred. It is cleared by writing 1 to TZIC.DCBEVT1.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- TZIC: Trip-Zone Clear Register -->
        <register>
          <name>TZIC</name>
          <displayName>TZIC</displayName>
          <description>Trip-Zone Clear Register</description>
          <addressOffset>0x000000A8</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- OST: Clear one-shot trip status flag -->
            <field>
              <name>OST</name>
              <description>Clear one-shot trip status flag</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write a 1 clears TZIF.OST</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CBC: Clear cycle-by-cycle trip status flag -->
            <field>
              <name>CBC</name>
              <description>Clear cycle-by-cycle trip status flag</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write a 1 clears TZIF.CBC</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DCAEVT0: Clear digital compare A event 0 status flag -->
            <field>
              <name>DCAEVT0</name>
              <description>Clear digital compare A event 0 status flag</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write a 1 clears TZIF.DCAEVT0</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DCAEVT1: Clear digital compare A event 1 status flag -->
            <field>
              <name>DCAEVT1</name>
              <description>Clear digital compare A event 1 status flag</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write a 1 clears TZIF.DCAEVT1</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DCBEVT0: Clear digital compare B event 0 status flag -->
            <field>
              <name>DCBEVT0</name>
              <description>Clear digital compare B event 0 status flag</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write a 1 clears TZIF.DCBEVT0</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DCBEVT1: Clear digital compare B event 1 status flag -->
            <field>
              <name>DCBEVT1</name>
              <description>Clear digital compare B event 1 status flag</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write a 1 clears TZIF.DCBEVT1</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- INT: Clear global interrupt status flag -->
            <field>
              <name>INT</name>
              <description>Clear global interrupt status flag</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write a 1 clears TZIF.INT and TZ interrupt</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CBCCLRMODE: Latched CBC trip status clear mode.\nThis bit is writable only when CBCCLRMODEWE bit is 1 and PWMREGKEY=0x1acce551 -->
            <field>
              <name>CBCCLRMODE</name>
              <description>Latched CBC trip status clear mode.\nThis bit is writable only when CBCCLRMODEWE bit is 1 and PWMREGKEY=0x1acce551</description>
              <bitRange>[30:29]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CLEAR_ON_ZERO</name>
                  <description>Clear CBC trip on TBCNT=0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR_ON_PERIOD</name>
                  <description>Clear CBC trip on TBCNT=TBPRD</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR_ON_ZERO_PERIOD</name>
                  <description>Clear CBC trip on TBCNT=0 or TBCNT=TBPRD</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR_DISABLE</name>
                  <description>Clear disabled. i.e. Never clear the CBC trip</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CBCCLRMODEWE: Latched CBC trip status clear mode write enable -->
            <field>
              <name>CBCCLRMODEWE</name>
              <description>Latched CBC trip status clear mode write enable</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Write 1 enables concurrent write to CBCCLRMODE bit. This bit is self-cleared to 0</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- TZIE: Trip-Zone Interrupt Enable Register -->
        <register>
          <name>TZIE</name>
          <displayName>TZIE</displayName>
          <description>Trip-Zone Interrupt Enable Register</description>
          <addressOffset>0x000000AC</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- OST: One-shot trip-zone interrupt enable -->
            <field>
              <name>OST</name>
              <description>One-shot trip-zone interrupt enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CBC: Cycle-by-cycle trip-zone interrupt enable -->
            <field>
              <name>CBC</name>
              <description>Cycle-by-cycle trip-zone interrupt enable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DCAEVT0: Digital compare A event 0 interrupt enable -->
            <field>
              <name>DCAEVT0</name>
              <description>Digital compare A event 0 interrupt enable</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DCAEVT1: Digital compare A event 1 interrupt enable -->
            <field>
              <name>DCAEVT1</name>
              <description>Digital compare A event 1 interrupt enable</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DCBEVT0: Digital compare B event 0 interrupt enable -->
            <field>
              <name>DCBEVT0</name>
              <description>Digital compare B event 0 interrupt enable</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DCBEVT1: Digital compare B event 1 interrupt enable -->
            <field>
              <name>DCBEVT1</name>
              <description>Digital compare B event 1 interrupt enable</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
