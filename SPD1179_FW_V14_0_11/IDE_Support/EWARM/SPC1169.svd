              </enumeratedValues>
            </field>

            <!-- RMTEN: Enable remote frame auto response. -->
            <field>
              <name>RMTEN</name>
              <description>Enable remote frame auto response.</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>DIR==0: transmit remote frame first, then wait receive data frame.\nDIR==1: wait receive remote frame first, then transmit message in mailbox.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DIR: Message data transfer direction on bus. -->
            <field>
              <name>DIR</name>
              <description>Message data transfer direction on bus.</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>RECEPTION</name>
                  <description>Wait receive data.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRANSMISSION</name>
                  <description>Wait transmit data.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- EN: Enable mailbox -->
            <field>
              <name>EN</name>
              <description>Enable mailbox</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>CAN</name>
      <description></description>
      <groupName>CAN</groupName>
      <baseAddress>0x40005400</baseAddress>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>144</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
         <name>CANTRG3</name>
         <description>CAN Transfer Group 3 Interrupt</description>
         <value>13</value>
      </interrupt>
      <interrupt>
         <name>CANTRG0</name>
         <description>CAN Transfer Group 0 Interrupt</description>
         <value>10</value>
      </interrupt>
      <interrupt>
         <name>CANTRG1</name>
         <description>CAN Transfer Group 1 Interrupt</description>
         <value>11</value>
      </interrupt>
      <interrupt>
         <name>CANTRG6</name>
         <description>CAN Transfer Group 6 Interrupt</description>
         <value>16</value>
      </interrupt>
      <interrupt>
         <name>CANTRG7</name>
         <description>CAN Transfer Group 7 Interrupt</description>
         <value>17</value>
      </interrupt>
      <interrupt>
         <name>CANTRG4</name>
         <description>CAN Transfer Group 4 Interrupt</description>
         <value>14</value>
      </interrupt>
      <interrupt>
         <name>CANTRG5</name>
         <description>CAN Transfer Group 5 Interrupt</description>
         <value>15</value>
      </interrupt>
      <interrupt>
         <name>CANMISC</name>
         <description>CAN Miscellaneous Interrupt</description>
         <value>18</value>
      </interrupt>
      <interrupt>
         <name>CANTRG2</name>
         <description>CAN Transfer Group 2 Interrupt</description>
         <value>12</value>
      </interrupt>
      <registers>

        <!-- CANCTL: Control Register -->
        <register>
          <name>CANCTL</name>
          <displayName>CANCTL</displayName>
          <description>Control Register</description>
          <addressOffset>0x00000000</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000060</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- RUN: Enable module run. -->
            <field>
              <name>RUN</name>
              <description>Enable module run.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>STOP</name>
                  <description>Stop module</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RUN</name>
                  <description>Run module</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RST: Software reset. -->
            <field>
              <name>RST</name>
              <description>Software reset.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Force module to reset state. This bit will get cleared automatically after module reset.\nNote: To execute software reset, the following procedure is necessary:\n1. Set CANCTL.RUN to STOP CAN communication.\n2. Set CANCTL.RST bit.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RECOVEN: Enable bus off recovery.\nThis field is not write protected by REGKEY. -->
            <field>
              <name>RECOVEN</name>
              <description>Enable bus off recovery.\nThis field is not write protected by REGKEY.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>After bus off:\nif CANCTL.AUTOON is not set, software enable this bit to start Auto-Bus-On procedure;\nif CANCTL.AUTOON is set, hardware start Auto-Bus-On procedure.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- AUTOON: Enable auto bus on. -->
            <field>
              <name>AUTOON</name>
              <description>Enable auto bus on.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>The Auto-Bus-On feature is disabled.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>The Auto-Bus-On feature is enabled.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RETX: Enable automatic retransmission.\nThis field is writable only when CANSTS.OP is STOP. -->
            <field>
              <name>RETX</name>
              <description>Enable automatic retransmission.\nThis field is writable only when CANSTS.OP is STOP.</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Enable automatic retransmission.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Disable automatic retransmission of &quot;not successful&quot; messages.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- IOSWAP: Enable swap TXD/RXD Pin.\nThis field is writable only when CANSTS.OP is STOP. -->
            <field>
              <name>IOSWAP</name>
              <description>Enable swap TXD/RXD Pin.\nThis field is writable only when CANSTS.OP is STOP.</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable swap TXD/RXD pin.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable swap TXD/RXD pin.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PXEN: Protocol exception enable.\nThis field is writable only when CANSTS.OP is STOP. -->
            <field>
              <name>PXEN</name>
              <description>Protocol exception enable.\nThis field is writable only when CANSTS.OP is STOP.</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXPAUSE: Transmission pause 2 nominal bit enable. -->
            <field>
              <name>TXPAUSE</name>
              <description>Transmission pause 2 nominal bit enable.</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>After successful transmit one frame, then delay 2 nominal bit to send another frame. This make other node send lower priority message on bus without arbitration.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- EDGEFLT: Edge filter enable in integration status. -->
            <field>
              <name>EDGEFLT</name>
              <description>Edge filter enable in integration status.</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>During integration status, sample consecutive 2tq dominant will be treated as falling edge.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RESMODE: Restricted mode enable\nThis field is write 1 protected by REGKEY, and only writable when CANSTS.OP is STOP.\nThis field can be set to 0 at any time. -->
            <field>
              <name>RESMODE</name>
              <description>Restricted mode enable\nThis field is write 1 protected by REGKEY, and only writable when CANSTS.OP is STOP.\nThis field can be set to 0 at any time.</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- MONMODE: Monitor mode enable\nThis field is write 1 protected by REGKEY, and only writable when CANSTS.OP is STOP.\nThis field can be set to 0 at any time. -->
            <field>
              <name>MONMODE</name>
              <description>Monitor mode enable\nThis field is write 1 protected by REGKEY, and only writable when CANSTS.OP is STOP.\nThis field can be set to 0 at any time.</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TSTMODE: Test mode enable\nThis field is writable only when CANSTS.OP is STOP. -->
            <field>
              <name>TSTMODE</name>
              <description>Test mode enable\nThis field is writable only when CANSTS.OP is STOP.</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- FDEN: CANFD enable.\nThis field is writable only when CANSTS.OP is STOP. -->
            <field>
              <name>FDEN</name>
              <description>CANFD enable.\nThis field is writable only when CANSTS.OP is STOP.</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable CANFD format frame.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable CANFD format frame.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- NONISO: NON-ISO CAN protocol mode.\nThis field is writable only when CANSTS.OP is STOP. -->
            <field>
              <name>NONISO</name>
              <description>NON-ISO CAN protocol mode.\nThis field is writable only when CANSTS.OP is STOP.</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO</name>
                  <description>Use ISO-CANFD format, which defined by ISO11898-1:2015.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>YES</name>
                  <description>Use NON-ISO-CANFD format, which defined by Bosch CAN2.0B and CANFD_V1.0</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PRTYCHK: Parity check enable. -->
            <field>
              <name>PRTYCHK</name>
              <description>Parity check enable.</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- CANNBTQ: Nominal Bit Timing Quatum Register -->
        <register>
          <name>CANNBTQ</name>
          <displayName>CANNBTQ</displayName>
          <description>Nominal Bit Timing Quatum Register</description>
          <addressOffset>0x00000004</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00090403</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- NBRP: Norminal bit rate prescaler value.\nThis field is writable only when CANSTS.OP is STOP. -->
            <field>
              <name>NBRP</name>
              <description>Norminal bit rate prescaler value.\nThis field is writable only when CANSTS.OP is STOP.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- NSEG1: Time segment before the sample point of nominal bit rate.\nThis field is writable only when CANSTS.OP is STOP. -->
            <field>
              <name>NSEG1</name>
              <description>Time segment before the sample point of nominal bit rate.\nThis field is writable only when CANSTS.OP is STOP.</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>

            <!-- NSEG2: Time segment after the sample point of nominal bit rate.\nThis field is writable only when CANSTS.OP is STOP. -->
            <field>
              <name>NSEG2</name>
              <description>Time segment after the sample point of nominal bit rate.\nThis field is writable only when CANSTS.OP is STOP.</description>
              <bitRange>[22:16]</bitRange>
              <access>read-write</access>
            </field>

            <!-- NSJW: Synchronization jump width of nominal bit rate.\nThis field is writable only when CANSTS.OP is STOP. -->
            <field>
              <name>NSJW</name>
              <description>Synchronization jump width of nominal bit rate.\nThis field is writable only when CANSTS.OP is STOP.</description>
              <bitRange>[30:24]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- CANDBTQ: Data Bit Timing Quatum Register -->
        <register>
          <name>CANDBTQ</name>
          <displayName>CANDBTQ</displayName>
          <description>Data Bit Timing Quatum Register</description>
          <addressOffset>0x00000008</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00090403</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- DBRP: Data baud rate prescaler value.\nThis field is writable only when CANSTS.OP is STOP. -->
            <field>
              <name>DBRP</name>
              <description>Data baud rate prescaler value.\nThis field is writable only when CANSTS.OP is STOP.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- DSEG1: Time segment before the sample point for CANFD data bit rate.\nThis field is writable only when CANSTS.OP is STOP. -->
            <field>
              <name>DSEG1</name>
              <description>Time segment before the sample point for CANFD data bit rate.\nThis field is writable only when CANSTS.OP is STOP.</description>
              <bitRange>[12:8]</bitRange>
              <access>read-write</access>
            </field>

            <!-- DSEG2: Time segment after the sample point for CANFD data bit rate.\nThis field is writable only when CANSTS.OP is STOP. -->
            <field>
              <name>DSEG2</name>
              <description>Time segment after the sample point for CANFD data bit rate.\nThis field is writable only when CANSTS.OP is STOP.</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>

            <!-- DSJW: Synchronization jump width for CANFD data bit rate.\nThis field is writable only when CANSTS.OP is STOP. -->
            <field>
              <name>DSJW</name>
              <description>Synchronization jump width for CANFD data bit rate.\nThis field is writable only when CANSTS.OP is STOP.</description>
              <bitRange>[27:24]</bitRange>
              <access>read-write</access>
            </field>

            <!-- TDC: Transmitter delay compensation enable.\nThis field is writable only when CANSTS.OP is STOP. -->
            <field>
              <name>TDC</name>
              <description>Transmitter delay compensation enable.\nThis field is writable only when CANSTS.OP is STOP.</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- CANTDC: Transmitter Delay Compensation Register -->
        <register>
          <name>CANTDC</name>
          <displayName>CANTDC</displayName>
          <description>Transmitter Delay Compensation Register</description>
          <addressOffset>0x0000000C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- TDCO: Transmitter delay conmpensation SSP offset -->
            <field>
              <name>TDCO</name>
              <description>Transmitter delay conmpensation SSP offset</description>
              <bitRange>[9:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- TDCW: Transmitter delay compensation filter window length. -->
            <field>
              <name>TDCW</name>
              <description>Transmitter delay compensation filter window length.</description>
              <bitRange>[19:10]</bitRange>
              <access>read-write</access>
            </field>

            <!-- TDCV: Transmitter delay compensation value -->
            <field>
              <name>TDCV</name>
              <description>Transmitter delay compensation value</description>
              <bitRange>[29:20]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- CANBRDLY: Bus-Off Recovery Delay Register -->
        <register>
          <name>CANBRDLY</name>
          <displayName>CANBRDLY</displayName>
          <description>Bus-Off Recovery Delay Register</description>
          <addressOffset>0x00000010</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- DLY: Bus-Off recovery delay. -->
            <field>
              <name>DLY</name>
              <description>Bus-Off recovery delay.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- CANSTS: Status Register -->
        <register>
          <name>CANSTS</name>
          <displayName>CANSTS</displayName>
          <description>Status Register</description>
          <addressOffset>0x00000014</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- TEC: Transmitter error counter. -->
            <field>
              <name>TEC</name>
              <description>Transmitter error counter.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-only</access>
            </field>

            <!-- REC: Receiver error counter. -->
            <field>
              <name>REC</name>
              <description>Receiver error counter.</description>
              <bitRange>[14:8]</bitRange>
              <access>read-only</access>
            </field>

            <!-- ERRPASSIVE: Error passive state. -->
            <field>
              <name>ERRPASSIVE</name>
              <description>Error passive state.</description>
              <bitRange>[15:15]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCURED</name>
                  <description>On CAN Bus error, the CAN could send active error frames.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCURRED</name>
                  <description>The CAN Core is in the error passive state as defined in the CAN Specification.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- ERRWARN: Error warning. -->
            <field>
              <name>ERRWARN</name>
              <description>Error warning.</description>
              <bitRange>[16:16]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCURED</name>
                  <description>Both error counters are below the error warning limit.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCURRED</name>
                  <description>At least one of the error counters has reached the error warning limit of 96.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- OPMODE: Operation mode. -->
            <field>
              <name>OPMODE</name>
              <description>Operation mode.</description>
              <bitRange>[19:17]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>STOP</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>INTEGRATION</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>IDLE</name>
                  <description></description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TXING</name>
                  <description></description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RXING</name>
                  <description></description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BUSOFF</name>
                  <description></description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
