        <!-- DCFOFFSET: Digital Compare Filter Offset Register -->
        <register>
          <name>DCFOFFSET</name>
          <displayName>DCFOFFSET</displayName>
          <description>Digital Compare Filter Offset Register</description>
          <addressOffset>0x000000D0</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Blanking window offset\nIt defines the number of TBCLK cycles from the blanking window reference specified by DCFCTL.PULSESEL to the point when the blanking window is applied. -->
            <field>
              <name>VAL</name>
              <description>Blanking window offset\nIt defines the number of TBCLK cycles from the blanking window reference specified by DCFCTL.PULSESEL to the point when the blanking window is applied.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- DCFOFFSETCNT: Digital Compare Filter Offset Counter Register -->
        <register>
          <name>DCFOFFSETCNT</name>
          <displayName>DCFOFFSETCNT</displayName>
          <description>Digital Compare Filter Offset Counter Register</description>
          <addressOffset>0x000000D4</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Blanking offset counter\nIt is read only and indicates the current value of the offset counter. The counter counts down to zero and then stops until it is re-loaded on the next event defined by DCFCTL.PULSESEL. -->
            <field>
              <name>VAL</name>
              <description>Blanking offset counter\nIt is read only and indicates the current value of the offset counter. The counter counts down to zero and then stops until it is re-loaded on the next event defined by DCFCTL.PULSESEL.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- DCFWINDOW: Digital Compare Filter Window Register -->
        <register>
          <name>DCFWINDOW</name>
          <displayName>DCFWINDOW</displayName>
          <description>Digital Compare Filter Window Register</description>
          <addressOffset>0x000000D8</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Blanking window width in TBCLK cycles\nThe blanking window begins when the offset counter expires. When this occurs, the window counter is loaded and begins to count down. If the blanking window is currently active and the offset counter expires, the blanking window counter is restarted.\nThe blanking window can cross a PWM period boundary.\nNo blanking window is generated when it is set to zero. -->
            <field>
              <name>VAL</name>
              <description>Blanking window width in TBCLK cycles\nThe blanking window begins when the offset counter expires. When this occurs, the window counter is loaded and begins to count down. If the blanking window is currently active and the offset counter expires, the blanking window counter is restarted.\nThe blanking window can cross a PWM period boundary.\nNo blanking window is generated when it is set to zero.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- DCFWINDOWCNT: Digital Compare Filter Window Counter Register -->
        <register>
          <name>DCFWINDOWCNT</name>
          <displayName>DCFWINDOWCNT</displayName>
          <description>Digital Compare Filter Window Counter Register</description>
          <addressOffset>0x000000DC</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Blanking window counter\nIt is read only and indicates the current value of the window counter. The counter counts down to zero and then stops until it is re-loaded when the offset counter reaches zero again. -->
            <field>
              <name>VAL</name>
              <description>Blanking window counter\nIt is read only and indicates the current value of the window counter. The counter counts down to zero and then stops until it is re-loaded when the offset counter reaches zero again.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- DCCAPCTL: Digital Compare Capture Control Register -->
        <register>
          <name>DCCAPCTL</name>
          <displayName>DCCAPCTL</displayName>
          <description>Digital Compare Capture Control Register</description>
          <addressOffset>0x000000E0</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- CAPEN: TBCNT counter capture enable -->
            <field>
              <name>CAPEN</name>
              <description>TBCNT counter capture enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DIRECT: DCCAP direct load mode -->
            <field>
              <name>DIRECT</name>
              <description>DCCAP direct load mode</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Shadow mode. The DCCAP active value is copied to shadow register on a TBCNT=TBPRD or TBCNT=zero event as defined by DCFCTL.PULSESEL. Reads of the DCCAP register always returns the shadow register contents.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Direct mode. Reads of the DCCAP register always returns the active value.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- MULTICAP: DCCAP multiple capture mode -->
            <field>
              <name>MULTICAP</name>
              <description>DCCAP multiple capture mode</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Capture only once upon the first event in each cycle until next cycle is started by the pulse defined in DCFCTL.PULSESEL</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Capture upon every events and always keep the latest captured value</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CAPENWE: CAPEN bit write enable -->
            <field>
              <name>CAPENWE</name>
              <description>CAPEN bit write enable</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Write 1 enables concurrent write to CAPEN bit. This bit is self-cleared to 0</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DIRECTWE: DIRECT bit write enable -->
            <field>
              <name>DIRECTWE</name>
              <description>DIRECT bit write enable</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Write 1 enables concurrent write to DIRECT bit. This bit is self-cleared to 0</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- MULTICAPWE: MULTICAP bit write enable -->
            <field>
              <name>MULTICAPWE</name>
              <description>MULTICAP bit write enable</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Write 1 enables concurrent write to MULTICAP bit. This bit is self-cleared to 0</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CAPCLR: Latched capture flag clear -->
            <field>
              <name>CAPCLR</name>
              <description>Latched capture flag clear</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write a 1 clears the latched flag. This bit is self-cleared to 0</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CAPFLG: Latched capture flag -->
            <field>
              <name>CAPFLG</name>
              <description>Latched capture flag</description>
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>No DC capture event occurred</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>DC capture event has occurred</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- DCCAP: Digital Compare Counter Capture Register -->
        <register>
          <name>DCCAP</name>
          <displayName>DCCAP</displayName>
          <description>Digital Compare Counter Capture Register</description>
          <addressOffset>0x000000E4</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Captured TBCNT value upon a rising-edge of DCEVTFLT\nIn shadow mode, the captured value is copied to the shadow register on a TBCNT=TBPRD or TBCNT=zero event as defined by DCFCTL.PULSESEL. Reads of the DCCAP register always returns the shadow register contents.\nIn direct mode, reads of the DCCAP register always returns the active value. -->
            <field>
              <name>VAL</name>
              <description>Captured TBCNT value upon a rising-edge of DCEVTFLT\nIn shadow mode, the captured value is copied to the shadow register on a TBCNT=TBPRD or TBCNT=zero event as defined by DCFCTL.PULSESEL. Reads of the DCCAP register always returns the shadow register contents.\nIn direct mode, reads of the DCCAP register always returns the active value.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- ETCTL: Event-Trigger Control Register -->
