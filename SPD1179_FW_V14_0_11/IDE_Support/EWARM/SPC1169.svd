                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write a 0 has no effect. Always readback 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write a 1 clears EPWRTZSTS[EPWRTZ1]. This bit is self-cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

