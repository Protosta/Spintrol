                  <name>RECEPTION</name>
                  <description>Wait receive data.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRANSMISSION</name>
                  <description>Wait transmit data.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- EN: Enable mailbox -->
            <field>
              <name>EN</name>
              <description>Enable mailbox</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
