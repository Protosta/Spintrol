        <!-- GPIOWKUPCTL: GPIO Wake-Up Control Register -->
        <register>
          <name>GPIOWKUPCTL</name>
          <displayName>GPIOWKUPCTL</displayName>
          <description>GPIO Wake-Up Control Register</description>
          <addressOffset>0x0000007C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00010001</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- STOPWKUPPOL: GPIO level to wake up from stop state -->
            <field>
              <name>STOPWKUPPOL</name>
              <description>GPIO level to wake up from stop state</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ACTIVE_LOW</name>
                  <description>Wake up from stop when low</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACTIVE_HIGH</name>
                  <description>Wake up from stop when high</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- STOPWKUPIO: GPIO number to wake up from stop state -->
            <field>
              <name>STOPWKUPIO</name>
              <description>GPIO number to wake up from stop state</description>
              <bitRange>[6:1]</bitRange>
              <access>read-write</access>
            </field>

            <!-- STOPWKUPWE: GPIO wake up from stop state write enable\nThis bit should be write 1 at the same time when write STOPWKUPIO and STOPWKUPPOL bits -->
            <field>
              <name>STOPWKUPWE</name>
              <description>GPIO wake up from stop state write enable\nThis bit should be write 1 at the same time when write STOPWKUPIO and STOPWKUPPOL bits</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SLEEPWKUPPOL: GPIO level to wake up from sleep state -->
            <field>
              <name>SLEEPWKUPPOL</name>
              <description>GPIO level to wake up from sleep state</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ACTIVE_LOW</name>
                  <description>Wake up from sleep when low</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ACTIVE_HIGH</name>
                  <description>Wake up from sleep when high</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SLEEPWKUPIO: GPIO number to wake up from sleep state -->
            <field>
              <name>SLEEPWKUPIO</name>
              <description>GPIO number to wake up from sleep state</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>GPIO28</name>
                  <description>Use GPIO28 to wake up the MCU from sleep</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GPIO4</name>
                  <description>Use GPIO4 to wake up the MCU from sleep</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SLEEPWKUPWE: GPIO wake up from sleep state write enable\nThis bit should be write 1 at the same time when write SLEEPWKUPIO and SLEEPWKUPPOL bits -->
            <field>
              <name>SLEEPWKUPWE</name>
              <description>GPIO wake up from sleep state write enable\nThis bit should be write 1 at the same time when write SLEEPWKUPIO and SLEEPWKUPPOL bits</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- GPIONMICTL: GPIO Non-Maskable Interrupt Control Register -->
        <register>
          <name>GPIONMICTL</name>
          <displayName>GPIONMICTL</displayName>
          <description>GPIO Non-Maskable Interrupt Control Register</description>
          <addressOffset>0x00000080</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- POL: GPIO edge to trigger the NMI -->
            <field>
              <name>POL</name>
              <description>GPIO edge to trigger the NMI</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FALLING_EDGE</name>
                  <description>Falling edge</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RISING_EDGE</name>
                  <description>Rising edge</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- IOSEL: GPIO number to trigger the NMI -->
            <field>
              <name>IOSEL</name>
              <description>GPIO number to trigger the NMI</description>
              <bitRange>[6:1]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
