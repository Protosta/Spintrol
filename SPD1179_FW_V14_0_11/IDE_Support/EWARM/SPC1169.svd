                <enumeratedValue>
                  <name>PWM1SYNCO</name>
                  <description>PWM1 synchronous output</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWM2SYNCO</name>
                  <description>PWM2 synchronous output</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWM3SYNCO</name>
