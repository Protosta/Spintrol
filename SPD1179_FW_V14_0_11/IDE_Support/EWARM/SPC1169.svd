          <addressOffset>0x00000048</addressOffset>
          <!-- registerPropertiesGroup -->
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- TS: Timestamp -->
            <field>
              <name>TS</name>
              <description>Timestamp</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- CANMBOXMCTL: Mailbox Message Control Register -->
        <register>
          <name>CANMBOXMCTL</name>
          <displayName>CANMBOXMCTL</displayName>
          <description>Mailbox Message Control Register</description>
          <addressOffset>0x0000004C</addressOffset>
          <!-- registerPropertiesGroup -->
          <size>0x20</size>
          <access>read-write</access>
