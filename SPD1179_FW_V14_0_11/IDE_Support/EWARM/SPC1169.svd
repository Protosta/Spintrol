        <!-- ETPS: Event-Trigger Prescale Register -->
        <register>
          <name>ETPS</name>
          <displayName>ETPS</displayName>
          <description>Event-Trigger Prescale Register</description>
          <addressOffset>0x000000EC</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- INTPRD: PWM interrupt period select\nInterrupt is generated upon INTPRD&amp;lt;=INTCNT and ETCTL[INTEN]=1. No interrupt will be generated if INTPRD=0 -->
            <field>
              <name>INTPRD</name>
              <description>PWM interrupt period select\nInterrupt is generated upon INTPRD&amp;lt;=INTCNT and ETCTL[INTEN]=1. No interrupt will be generated if INTPRD=0</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable the interrupt event counter. No interrupt will be generated and ETFRC.INT is ignored.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GEN_INT_ON_1ST_EVENT</name>
                  <description>Generate an interrupt when ETPS.INTCNT=0001 (first event)</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GEN_INT_ON_2ND_EVENT</name>
                  <description>Generate an interrupt when ETPS.INTCNT=0010 (second event)</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GEN_INT_ON_3RD_EVENT</name>
                  <description>Generate an interrupt when ETPS.INTCNT=0011 (third event)</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GEN_INT_ON_4TH_EVENT</name>
                  <description>Generate an interrupt when ETPS.INTCNT=0100 (fourth event)</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GEN_INT_ON_5TH_EVENT</name>
                  <description>Generate an interrupt when ETPS.INTCNT=0101 (fifth event)</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GEN_INT_ON_6TH_EVENT</name>
                  <description>Generate an interrupt when ETPS.INTCNT=0110(sixth event)</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GEN_INT_ON_7TH_EVENT</name>
                  <description>Generate an interrupt when ETPS.INTCNT=0111 (seventh event)</description>
                  <value>0x7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GEN_INT_ON_8TH_EVENT</name>
                  <description>Generate an interrupt when ETPS.INTCNT=1000 (eighth event)</description>
                  <value>0x8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GEN_INT_ON_9TH_EVENT</name>
                  <description>Generate an interrupt when ETPS.INTCNT=1001 (ninth event)</description>
                  <value>0x9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GEN_INT_ON_10TH_EVENT</name>
                  <description>Generate an interrupt when ETPS.INTCNT=1010 (tenth event)</description>
                  <value>0xA</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GEN_INT_ON_11TH_EVENT</name>
                  <description>Generate an interrupt when ETPS.INTCNT=1011 (eleventh event)</description>
                  <value>0xB</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GEN_INT_ON_12TH_EVENT</name>
                  <description>Generate an interrupt when ETPS.INTCNT=1100(twelfth event)</description>
                  <value>0xC</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GEN_INT_ON_13TH_EVENT</name>
                  <description>Generate an interrupt when ETPS.INTCNT=1101 (thirteenth event)</description>
                  <value>0xD</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GEN_INT_ON_14TH_EVENT</name>
                  <description>Generate an interrupt when ETPS.INTCNT=1110(fourteenth event)</description>
                  <value>0xE</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GEN_INT_ON_15TH_EVENT</name>
                  <description>Generate an interrupt when ETPS.INTCNT=1111 (fifteenth event)</description>
                  <value>0xF</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- INTCNT: PWM interrupt counter\nIt indicates how many selected ETSEL.INTSEL events have occurred. It is automatically cleared when an interrupt pulse is generated.\nIt can be initialized via write. -->
            <field>
              <name>INTCNT</name>
              <description>PWM interrupt counter\nIt indicates how many selected ETSEL.INTSEL events have occurred. It is automatically cleared when an interrupt pulse is generated.\nIt can be initialized via write.</description>
              <bitRange>[7:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EVENT_OCCUR</name>
                  <description>No events have occurred</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1_EVENT_OCCUR</name>
                  <description>1 event has occurred</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2_EVENT_OCCUR</name>
                  <description>2 events have occurred</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3_EVENT_OCCUR</name>
                  <description>3 events have occurred</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4_EVENT_OCCUR</name>
                  <description>4 events have occurred</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>5_EVENT_OCCUR</name>
                  <description>5 events have occurred</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>6_EVENT_OCCUR</name>
                  <description>6 events have occurred</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>7_EVENT_OCCUR</name>
                  <description>7 events have occurred</description>
                  <value>0x7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>8_EVENT_OCCUR</name>
                  <description>8 events have occurred</description>
                  <value>0x8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>9_EVENT_OCCUR</name>
                  <description>9 events have occurred</description>
                  <value>0x9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>10_EVENT_OCCUR</name>
                  <description>10 events have occurred</description>
                  <value>0xA</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>11_EVENT_OCCUR</name>
                  <description>11 events have occurred</description>
                  <value>0xB</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>12_EVENT_OCCUR</name>
                  <description>12 events have occurred</description>
                  <value>0xC</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>13_EVENT_OCCUR</name>
                  <description>13 events have occurred</description>
                  <value>0xD</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>14_EVENT_OCCUR</name>
                  <description>14 events have occurred</description>
                  <value>0xE</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>15_EVENT_OCCUR</name>
                  <description>15 events have occurred</description>
                  <value>0xF</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SOCAPRD: PWM ADC start-of-conversion A event (SOCA) period select\nSOCA is generated upon SOCAPRD&amp;lt;=SOCACNT and ETCTL[SOCAEN]=1. No SOCA will be generated if SOCAPRD=0 -->
            <field>
              <name>SOCAPRD</name>
              <description>PWM ADC start-of-conversion A event (SOCA) period select\nSOCA is generated upon SOCAPRD&amp;lt;=SOCACNT and ETCTL[SOCAEN]=1. No SOCA will be generated if SOCAPRD=0</description>
              <bitRange>[11:8]</bitRange>
