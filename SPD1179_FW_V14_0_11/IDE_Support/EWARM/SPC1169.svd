          <description>PPU SOC Delay Register [%s]</description>
          <addressOffset>0x00000188</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Delay from trigger to execution for SOC selected by PPUCTL[n].SOCSEL -->
            <field>
              <name>VAL</name>
              <description>Delay from trigger to execution for SOC selected by PPUCTL[n].SOCSEL</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- PPURAWIF: PPU Raw Interrupt Flag Register [%s] -->
        <register>
          <!-- dimElementGroup -->
          <dim>3</dim>
          <dimIncrement>4</dimIncrement>
          <!-- end of dimElementGroup -->
          <name>PPURAWIF[%s]</name>
          <displayName>PPURAWIF[%s]</displayName>
          <description>PPU Raw Interrupt Flag Register [%s]</description>
          <addressOffset>0x000001A8</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- TZUV: Latched under-voltage event flag -->
            <field>
              <name>TZUV</name>
              <description>Latched under-voltage event flag</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Under-voltage event does not happen</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Under-voltage event happened</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TZOV: Latched over-voltage event flag -->
            <field>
              <name>TZOV</name>
              <description>Latched over-voltage event flag</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Over-voltage event does not happen</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Over-voltage event happened</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- XZRO: Latched zero-cross event flag -->
            <field>
              <name>XZRO</name>
              <description>Latched zero-cross event flag</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Zero-cross event does not happen</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Zero-cross event happened</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- PPUIF: PPU Interrupt Flag Register [%s] -->
        <register>
          <!-- dimElementGroup -->
          <dim>3</dim>
          <dimIncrement>4</dimIncrement>
          <!-- end of dimElementGroup -->
          <name>PPUIF[%s]</name>
          <displayName>PPUIF[%s]</displayName>
          <description>PPU Interrupt Flag Register [%s]</description>
          <addressOffset>0x000001C8</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- TZUV: Latched PPU under-voltage interrupt flag -->
            <field>
              <name>TZUV</name>
              <description>Latched PPU under-voltage interrupt flag</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>PPU over-voltage interrupt does not happen</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>PPU over-voltage interrupt happened\nFurther event will not trigger interrupt until this bit is cleared</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TZOV: Latched PPU over-voltage interrupt flag -->
            <field>
              <name>TZOV</name>
              <description>Latched PPU over-voltage interrupt flag</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>PPU over-voltage interrupt does not happen</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>PPU over-voltage interrupt happened.\nFurther event will not trigger interrupt until this bit is cleared</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- XZRO: Latched PPU zero-cross interrupt flag -->
            <field>
              <name>XZRO</name>
              <description>Latched PPU zero-cross interrupt flag</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>PPU zero-cross interrupt does not happen</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>PPU zero-cross interrupt happened.\nFurther event will not trigger interrupt until this bit is cleared</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- INT: PPU interrupt flag -->
            <field>
              <name>INT</name>
              <description>PPU interrupt flag</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>PPU interrupt does not happen</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>PPU interrupt happened and issued to the CPU.\nFuther interrupt will not be generated until this bit is cleared</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- PPUIC: PPU Interrupt Clear Register [%s] -->
        <register>
          <!-- dimElementGroup -->
          <dim>3</dim>
          <dimIncrement>4</dimIncrement>
          <!-- end of dimElementGroup -->
          <name>PPUIC[%s]</name>
          <displayName>PPUIC[%s]</displayName>
          <description>PPU Interrupt Clear Register [%s]</description>
          <addressOffset>0x000001E8</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- TZUV: PPU under-voltage interrupt clear -->
            <field>
              <name>TZUV</name>
              <description>PPU under-voltage interrupt clear</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write a 0 has no effect and always read back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write a 1 clears the TZUV flag. This bit is self-cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TZOV: PPU over-voltage interrupt clear -->
            <field>
              <name>TZOV</name>
              <description>PPU over-voltage interrupt clear</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write a 0 has no effect and always read back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write a 1 clears the TZOV flag. This bit is self-cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- XZRO: PPU zero-cross interrupt clear -->
            <field>
              <name>XZRO</name>
              <description>PPU zero-cross interrupt clear</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write a 0 has no effect and always read back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write a 1 clears the XZRO flag. This bit is self-cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- INT: PPU interrupt flag clear -->
            <field>
              <name>INT</name>
              <description>PPU interrupt flag clear</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write a 0 has no effect and always read back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write a 1 clears the interrupt flag. This bit is self-cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- PPUIE: PPU Interrupt Enable Register [%s] -->
        <register>
          <!-- dimElementGroup -->
          <dim>3</dim>
          <dimIncrement>4</dimIncrement>
