        <!-- PPUCTL: PPU Control Register [%s] -->
        <register>
          <!-- dimElementGroup -->
          <dim>3</dim>
          <dimIncrement>4</dimIncrement>
          <!-- end of dimElementGroup -->
          <name>PPUCTL[%s]</name>
          <displayName>PPUCTL[%s]</displayName>
          <description>PPU Control Register [%s]</description>
          <addressOffset>0x00000248</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000400</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- EN: PPU enable -->
            <field>
              <name>EN</name>
              <description>PPU enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable PPU</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable PPU</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CBCEN: PPU cycle-by-cycle clear enable -->
            <field>
              <name>CBCEN</name>
              <description>PPU cycle-by-cycle clear enable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable PPU cycle-by-cycle clear</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable PPU cycle-by-cycle clear</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SOCSEL: Select the SOC signal to derive its self PPUSOCDLY[n] -->
            <field>
              <name>SOCSEL</name>
              <description>Select the SOC signal to derive its self PPUSOCDLY[n]</description>
              <bitRange>[5:2]</bitRange>
              <access>read-write</access>
            </field>

            <!-- DATASEL: Select the ADC result to compare with the reference -->
            <field>
              <name>DATASEL</name>
              <description>Select the ADC result to compare with the reference</description>
              <bitRange>[9:6]</bitRange>
              <access>read-write</access>
            </field>

            <!-- POL: Polarity for comparison -->
            <field>
              <name>POL</name>
              <description>Polarity for comparison</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>REF_MINUS_CODE</name>
                  <description>PPU result is the reference minus the selected result</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CODE_MINUS_REF</name>
                  <description>PPU result is the selected result minus the reference</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- PPUREF: PPU Reference Register [%s] -->
        <register>
          <!-- dimElementGroup -->
          <dim>3</dim>
          <dimIncrement>4</dimIncrement>
          <!-- end of dimElementGroup -->
          <name>PPUREF[%s]</name>
          <displayName>PPUREF[%s]</displayName>
          <description>PPU Reference Register [%s]</description>
          <addressOffset>0x00000268</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Reference with extended sign bit\nShould be within [-4096, 4095] -->
            <field>
              <name>VAL</name>
              <description>Reference with extended sign bit\nShould be within [-4096, 4095]</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- PPUTHL: PPU Trip-Zone Low-Side Threshold Register [%s] -->
        <register>
          <!-- dimElementGroup -->
          <dim>3</dim>
          <dimIncrement>4</dimIncrement>
