                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TBCNT_EQU_ZERO_PERIOD</name>
                  <description>Enable event TBCNT=0 or TBCNT=TBPRD</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TBCNT_EQU_CMPA_UP</name>
