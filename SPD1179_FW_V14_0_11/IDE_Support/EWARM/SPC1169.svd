                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FULL</name>
                  <description>Write to DBRED set this bit and overwrite current value in DBRED</description>
                  <value>0x1</value>
                </enumeratedValue>
