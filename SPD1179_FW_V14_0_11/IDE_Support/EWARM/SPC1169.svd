                  <description>1.19 V</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1P33_V</name>
                  <description>1.33 V</description>
                  <value>0x7</value>
                </enumeratedValue>
              </enumeratedValues>
