                  <name>ACTIVE_HIGH</name>
                  <description>Output 1 when the comparator input is higher than the reference</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SYNCCLREN: Enable latched COMP0H status clear by PWMSYNC -->
            <field>
              <name>SYNCCLREN</name>
              <description>Enable latched COMP0H status clear by PWMSYNC</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>PWMSYNC does not affect the latched COMPH status</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>PWMSYNC will clear the latched COMPH status</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- FLTDIV: Filter&apos;s clock dividing ratio is (FLTDIV+1) -->
            <field>
              <name>FLTDIV</name>
              <description>Filter&apos;s clock dividing ratio is (FLTDIV+1)</description>
              <bitRange>[18:9]</bitRange>
              <access>read-write</access>
            </field>

            <!-- FLTWIN: Filter&apos;s window size is (FLTWIN+1) samples -->
            <field>
              <name>FLTWIN</name>
              <description>Filter&apos;s window size is (FLTWIN+1) samples</description>
              <bitRange>[23:19]</bitRange>
              <access>read-write</access>
            </field>

            <!-- FLTTH: Filter&apos;s threshold is (FLTTH+1) 1&apos;s/0&apos;s for output to toggle -->
            <field>
              <name>FLTTH</name>
              <description>Filter&apos;s threshold is (FLTTH+1) 1&apos;s/0&apos;s for output to toggle</description>
              <bitRange>[28:24]</bitRange>
              <access>read-write</access>
            </field>

            <!-- FLTRST: Reset all registers in the filter with the input -->
            <field>
              <name>FLTRST</name>
              <description>Reset all registers in the filter with the input</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect. Always read back 0.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RESET</name>
                  <description>Write 1 will fill all registers in the filter with the input</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- DAC0CTL: DAC0 Control Register -->
        <register>
          <name>DAC0CTL</name>
          <displayName>DAC0CTL</displayName>
          <description>DAC0 Control Register</description>
          <addressOffset>0x00000360</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000002</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
