              <name>PHREFSEL</name>
              <description>Phase comparitor reference select</description>
              <bitRange>[14:12]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PHC</name>
                  <description>Common-node sensed signal</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DAC1</name>
                  <description>DAC1 output</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DAC2</name>
                  <description>DAC2 output</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ANA_IN0</name>
                  <description>ANA_IN0 pin input</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ANA_IN1</name>
                  <description>ANA_IN1 pin input</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ANA_IN2</name>
                  <description>ANA_IN2 pin input</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ANA_IN3</name>
                  <description>ANA_IN3 pin input</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ANA_IN4</name>
                  <description>ANA_IN4 pin input</description>
                  <value>0x7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- HYSTSEL: Comparitor hysterisis select -->
            <field>
              <name>HYSTSEL</name>
              <description>Comparitor hysterisis select</description>
              <bitRange>[16:15]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0_MV</name>
                  <description>0 mV</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>12_MV</name>
                  <description>12 mV</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>24_MV</name>
                  <description>24 mV</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>36_MV</name>
                  <description>36 mV</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- MODE: Operation mode -->
            <field>
              <name>MODE</name>
              <description>Operation mode</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>BEMF_PHCOMP</name>
                  <description>Phase comparator mode for back EMF sensing</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NORMAL_COMP</name>
                  <description>Normal voltage comparator</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PWM0BLANK: Trigger blanking due to PWM0 toggling -->
            <field>
              <name>PWM0BLANK</name>
              <description>Trigger blanking due to PWM0 toggling</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PWM1BLANK: Trigger blanking due to PWM1 toggling -->
            <field>
              <name>PWM1BLANK</name>
              <description>Trigger blanking due to PWM1 toggling</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PWM2BLANK: Trigger blanking due to PWM2 toggling -->
            <field>
              <name>PWM2BLANK</name>
              <description>Trigger blanking due to PWM2 toggling</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PWM3BLANK: Trigger blanking due to PWM3 toggling -->
            <field>
              <name>PWM3BLANK</name>
              <description>Trigger blanking due to PWM3 toggling</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- PHCOMPBLANK: Phase Comparison Blanking Control -->
        <register>
          <name>PHCOMPBLANK</name>
          <displayName>PHCOMPBLANK</displayName>
          <description>Phase Comparison Blanking Control</description>
          <addressOffset>0x00000018</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- OFFSET: Blanking window offset referred to the toggling of all PWM outputs -->
            <field>
              <name>OFFSET</name>
              <description>Blanking window offset referred to the toggling of all PWM outputs</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- WINSIZE: Blanking window size -->
            <field>
              <name>WINSIZE</name>
              <description>Blanking window size</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- PHCOMPFILTER: Phase Comparison Filter Control -->
        <register>
          <name>PHCOMPFILTER</name>
          <displayName>PHCOMPFILTER</displayName>
          <description>Phase Comparison Filter Control</description>
          <addressOffset>0x0000001C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- FLTDIV: Set the filter&apos;s clock dividing ratio to (FLTDIV+1) -->
            <field>
              <name>FLTDIV</name>
              <description>Set the filter&apos;s clock dividing ratio to (FLTDIV+1)</description>
              <bitRange>[9:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- FLTWIN: Set the filter&apos;s window size to (FLTWIN+1) samples -->
            <field>
              <name>FLTWIN</name>
              <description>Set the filter&apos;s window size to (FLTWIN+1) samples</description>
              <bitRange>[14:10]</bitRange>
              <access>read-write</access>
            </field>

            <!-- FLTTH: Set the filter&apos;s threhold to (FLTTH+1) 1&apos;s/0&apos;s for output to toggle -->
            <field>
              <name>FLTTH</name>
              <description>Set the filter&apos;s threhold to (FLTTH+1) 1&apos;s/0&apos;s for output to toggle</description>
              <bitRange>[19:15]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- PHCOMPRST: Phase Comparison FSM Reset Register -->
        <register>
          <name>PHCOMPRST</name>
          <displayName>PHCOMPRST</displayName>
          <description>Phase Comparison FSM Reset Register</description>
          <addressOffset>0x00000020</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- PHURST: Reset U-phase comparison state machine\nIn BEMF phase comparitor mode, the 1st zero-cross event will be ignored after the reset pulse -->
            <field>
              <name>PHURST</name>
              <description>Reset U-phase comparison state machine\nIn BEMF phase comparitor mode, the 1st zero-cross event will be ignored after the reset pulse</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect. Always reads back 0.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RESET</name>
                  <description>Write 1 resets the FSM. This bit is self-cleared</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PHVRST: Reset V-phase comparison state machine\nIn BEMF phase comparitor mode, the 1st zero-cross event will be ignored after the reset pulse -->
            <field>
              <name>PHVRST</name>
              <description>Reset V-phase comparison state machine\nIn BEMF phase comparitor mode, the 1st zero-cross event will be ignored after the reset pulse</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect. Always reads back 0.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RESET</name>
                  <description>Write 1 resets the FSM. This bit is self-cleared</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PHWRST: Reset W-phase comparison state machine\nIn BEMF phase comparitor mode, the 1st zero-cross event will be ignored after the reset pulse -->
            <field>
              <name>PHWRST</name>
              <description>Reset W-phase comparison state machine\nIn BEMF phase comparitor mode, the 1st zero-cross event will be ignored after the reset pulse</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect. Always reads back 0.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RESET</name>
                  <description>Write 1 resets the FSM. This bit is self-cleared</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- PHCOMPREGKEY: Phase Comparison Register Write-Allow Key Register -->
        <register>
          <name>PHCOMPREGKEY</name>
          <displayName>PHCOMPREGKEY</displayName>
          <description>Phase Comparison Register Write-Allow Key Register</description>
          <addressOffset>0x00000024</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x1ACCE551</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- KEY: Write 0x1ACCE551 to unlock protected registers -->
            <field>
              <name>KEY</name>
              <description>Write 0x1ACCE551 to unlock protected registers</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>ENGR</name>
      <description></description>
      <groupName>ENGR</groupName>
      <baseAddress>0x40000F00</baseAddress>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>256</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>

        <!-- ADC1OFFSET: FuSa ADC Offset Trim Register -->
        <register>
          <name>ADC1OFFSET</name>
          <displayName>ADC1OFFSET</displayName>
          <description>FuSa ADC Offset Trim Register</description>
          <addressOffset>0x00000014</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Offset trim, which is a signed number within [-4096, 4095] -->
            <field>
              <name>VAL</name>
              <description>Offset trim, which is a signed number within [-4096, 4095]</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- MEMECCEN: Memory ECC Enable Register -->
        <register>
          <name>MEMECCEN</name>
          <displayName>MEMECCEN</displayName>
          <description>Memory ECC Enable Register</description>
          <addressOffset>0x00000044</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x0000001F</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- ROMECC: ROM ECC enable -->
            <field>
              <name>ROMECC</name>
              <description>ROM ECC enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- FLASHECC: FLASH ECC enable -->
            <field>
              <name>FLASHECC</name>
              <description>FLASH ECC enable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RAM0ECC: RAM0 ECC enable -->
            <field>
              <name>RAM0ECC</name>
              <description>RAM0 ECC enable</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RAM1ECC: RAM1 ECC enable -->
            <field>
              <name>RAM1ECC</name>
              <description>RAM1 ECC enable</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CANECC: CAN ECC enable -->
            <field>
              <name>CANECC</name>
              <description>CAN ECC enable</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>WDT0</name>
      <description></description>
      <groupName>WDT</groupName>
      <baseAddress>0x40001000</baseAddress>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>40</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>

        <!-- WDTLOAD: Watchdog Timer Load Register -->
        <register>
          <name>WDTLOAD</name>
          <displayName>WDTLOAD</displayName>
          <description>Watchdog Timer Load Register</description>
          <addressOffset>0x00000000</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x03D09000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Load value (Minimum valid value is 1)\nThe value from which the counter is to decrease. When this register is written to, the count is immediately restarted from the new value. -->
            <field>
              <name>VAL</name>
              <description>Load value (Minimum valid value is 1)\nThe value from which the counter is to decrease. When this register is written to, the count is immediately restarted from the new value.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- WDTCNT: Watchdog Timer Current Value Register -->
        <register>
          <name>WDTCNT</name>
          <displayName>WDTCNT</displayName>
          <description>Watchdog Timer Current Value Register</description>
          <addressOffset>0x00000004</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x03D09000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Current value of the decrementing counter. -->
            <field>
              <name>VAL</name>
              <description>Current value of the decrementing counter.</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- WDTCTL: Watchdog Timer Control Register -->
        <register>
          <name>WDTCTL</name>
          <displayName>WDTCTL</displayName>
          <description>Watchdog Timer Control Register</description>
          <addressOffset>0x00000008</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000007</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- EN: Enable the watchdog counter -->
            <field>
              <name>EN</name>
              <description>Enable the watchdog counter</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable the counter and reset it to WDTLOAD</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable the counter</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- HALTEDRUN: Allow watchdog to run during CPU halted mode -->
            <field>
              <name>HALTEDRUN</name>
              <description>Allow watchdog to run during CPU halted mode</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable the counter and reset it to WDTLOAD when CPU is in halted mode</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable the counter when CPU is in halted mode</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- LOCKUPRUN: Allow watchdog to run during CPU lockup mode -->
            <field>
              <name>LOCKUPRUN</name>
              <description>Allow watchdog to run during CPU lockup mode</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable the counter and reset it to WDTLOAD when CPU is in lockup mode</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable the counter when CPU is in lockup mode</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- WDTRAWIF: Watchdog Timer Raw Interrupt Flag Register -->
        <register>
          <name>WDTRAWIF</name>
          <displayName>WDTRAWIF</displayName>
          <description>Watchdog Timer Raw Interrupt Flag Register</description>
          <addressOffset>0x0000000C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- INT: Raw interrupt flag from the counter\nThe value is ANDed with WDTIE to create the masked interrupt, which is passed to the interrupt output pin. -->
            <field>
              <name>INT</name>
              <description>Raw interrupt flag from the counter\nThe value is ANDed with WDTIE to create the masked interrupt, which is passed to the interrupt output pin.</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Raw interrupt does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Raw interrupt occurred</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- WDTIF: Watchdog Timer Interrupt Flag Register -->
        <register>
          <name>WDTIF</name>
          <displayName>WDTIF</displayName>
          <description>Watchdog Timer Interrupt Flag Register</description>
          <addressOffset>0x00000010</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- INT: Interrupt flag from the counter\nThe value is the logical AND of WDTRAWIF and WDTIE -->
            <field>
              <name>INT</name>
              <description>Interrupt flag from the counter\nThe value is the logical AND of WDTRAWIF and WDTIE</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Masked interrupt does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Masked interrupt occurred</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- WDTIC: Watchdog Timer Interrupt Clear Register  -->
        <register>
          <name>WDTIC</name>
          <displayName>WDTIC</displayName>
          <description>Watchdog Timer Interrupt Clear Register </description>
          <addressOffset>0x00000014</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- INT: Clear interrupt.\nIf write 1 to this bit when WDTCNT is within [WDTTHL, WDTTHH], the WDTCNT will be reset to WDTLOAD -->
            <field>
              <name>INT</name>
              <description>Clear interrupt.\nIf write 1 to this bit when WDTCNT is within [WDTTHL, WDTTHH], the WDTCNT will be reset to WDTLOAD</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write a 0 has no effect and always read back 0.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write a 1 clears both the WDTRAWIF and WDTIF, and reset counter to WDTLOAD when WDTCNT is within [WDTTHL, WDTTHH]\nThis bit is self-cleared to 0.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- WDTIE: Watchdog Timer Interrupt Enable Register -->
        <register>
          <name>WDTIE</name>
          <displayName>WDTIE</displayName>
          <description>Watchdog Timer Interrupt Enable Register</description>
          <addressOffset>0x00000018</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- INT: Interrupt enable -->
            <field>
              <name>INT</name>
              <description>Interrupt enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- WDTTHL: Watchdog Windowed-Feed Low Threshold Register -->
        <register>
          <name>WDTTHL</name>
          <displayName>WDTTHL</displayName>
          <description>Watchdog Windowed-Feed Low Threshold Register</description>
          <addressOffset>0x0000001C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Watchdog can be feed (via write a 1 to WDTIC) only when WDTCNT is within [WDTTHL, WDTTHH] -->
            <field>
              <name>VAL</name>
              <description>Watchdog can be feed (via write a 1 to WDTIC) only when WDTCNT is within [WDTTHL, WDTTHH]</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- WDTTHH: Watchdog Windowed-Feed Low Threshold Register -->
        <register>
          <name>WDTTHH</name>
          <displayName>WDTTHH</displayName>
          <description>Watchdog Windowed-Feed Low Threshold Register</description>
          <addressOffset>0x00000020</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0xFFFFFFFF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Watchdog can be feed (via write a 1 to WDTIC) only when WDTCNT is within [WDTTHL, WDTTHH] -->
            <field>
              <name>VAL</name>
              <description>Watchdog can be feed (via write a 1 to WDTIC) only when WDTCNT is within [WDTTHL, WDTTHH]</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- WDTREGKEY: Watchdog Register Write-Allow Key Register -->
        <register>
          <name>WDTREGKEY</name>
          <displayName>WDTREGKEY</displayName>
          <description>Watchdog Register Write-Allow Key Register</description>
          <addressOffset>0x00000024</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- KEY: Write 0x1ACCE551 to unlock protected watchdog registers -->
            <field>
              <name>KEY</name>
              <description>Write 0x1ACCE551 to unlock protected watchdog registers</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
