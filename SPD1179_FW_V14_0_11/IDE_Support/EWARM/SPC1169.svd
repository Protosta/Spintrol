                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- EOB: End of block. -->
            <field>
              <name>EOB</name>
