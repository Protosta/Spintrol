                <enumeratedValue>
                  <name>PHCOMPWFLT</name>
                  <description>PHCOMPW filtered output</description>
                  <value>0x7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- PINMUXREGKEY: PINMUX  Register Write-Allow Key Register -->
        <register>
          <name>PINMUXREGKEY</name>
          <displayName>PINMUXREGKEY</displayName>
          <description>PINMUX  Register Write-Allow Key Register</description>
          <addressOffset>0x000000A8</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x1ACCE551</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- KEY: Write 0x1ACCE551 to unlock protected pinmux registers -->
            <field>
              <name>KEY</name>
              <description>Write 0x1ACCE551 to unlock protected pinmux registers</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>EPWR</name>
      <description></description>
      <groupName>EPWR</groupName>
      <baseAddress>0x40000400</baseAddress>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>40</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
         <name>EPWRTZ0</name>
         <description>ePower Tripzone Interrupt 0</description>
         <value>2</value>
      </interrupt>
      <interrupt>
         <name>EPWRTZ1</name>
         <description>ePower Tripzone Interrupt 1</description>
         <value>3</value>
      </interrupt>
      <registers>

        <!-- EPWRTZFLT: ePower Module Filtered Trip-Zone Event Register -->
        <register>
          <name>EPWRTZFLT</name>
          <displayName>EPWRTZFLT</displayName>
          <description>ePower Module Filtered Trip-Zone Event Register</description>
          <addressOffset>0x00000000</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- EPWRTZ0: Filtered EPWRTZ0 event without latch -->
            <field>
              <name>EPWRTZ0</name>
              <description>Filtered EPWRTZ0 event without latch</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>EPWRTZ0 event does not happen</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>EPWRTZ0 event happened</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- EPWRTZ1: Filtered EPWRTZ1 event without latch -->
            <field>
              <name>EPWRTZ1</name>
              <description>Filtered EPWRTZ1 event without latch</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>EPWRTZ1 event does not happen</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>EPWRTZ1 event happened</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- EPWRTZFLG: ePower Module Latched Trip-Zone Flag Register -->
        <register>
          <name>EPWRTZFLG</name>
          <displayName>EPWRTZFLG</displayName>
