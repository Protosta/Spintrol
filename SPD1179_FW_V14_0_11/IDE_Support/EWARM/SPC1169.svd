          <addressOffset>0x00000288</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Signed trip-zone threshold within [-8192, 8191] -->
            <field>
              <name>VAL</name>
              <description>Signed trip-zone threshold within [-8192, 8191]</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

