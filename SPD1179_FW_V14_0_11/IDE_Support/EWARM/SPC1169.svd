                  <name>DISABLE</name>
                  <description>Normal 32MHz mode (Trimmed)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Low frequency mode (Not trimmed)</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- XOCTL: Crystal Oscillator Control Register -->
        <register>
          <name>XOCTL</name>
          <displayName>XOCTL</displayName>
          <description>Crystal Oscillator Control Register</description>
          <addressOffset>0x00000008</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00007F58</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

