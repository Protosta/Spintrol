        <!-- ETFLG: Event-Trigger Flag Register -->
        <register>
          <name>ETFLG</name>
          <displayName>ETFLG</displayName>
          <description>Event-Trigger Flag Register</description>
          <addressOffset>0x000000F0</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- INT: Latched PWM interrupt flag -->
            <field>
              <name>INT</name>
              <description>Latched PWM interrupt flag</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Indicates no event occurred</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Indicates a PWM interrupt was generated. No further interrupts will be generated until the flag bit is cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SOCA: Latched PWM ADC start-of-conversion A flag -->
            <field>
              <name>SOCA</name>
              <description>Latched PWM ADC start-of-conversion A flag</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Indicates no event occurred</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Indicates a SOCA event was generated. The pulse will continue to be generated even if the flag is set.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SOCB: Latched PWM ADC start-of-conversion B flag -->
            <field>
              <name>SOCB</name>
              <description>Latched PWM ADC start-of-conversion B flag</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description> Indicates no event occurred</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Indicates a SOCB event was generated. The pulse will continue to be generated even if the flag is set.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SOCC: Latched PWM ADC start-of-conversion C flag -->
            <field>
              <name>SOCC</name>
              <description>Latched PWM ADC start-of-conversion C flag</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description> Indicates no event occurred</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Indicates a SOCC event was generated. The pulse will continue to be generated even if the flag is set.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- ETCLR: Event-Trigger Clear Register -->
        <register>
          <name>ETCLR</name>
          <displayName>ETCLR</displayName>
          <description>Event-Trigger Clear Register</description>
          <addressOffset>0x000000F4</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- INT: Latched PWM interrupt flag clear -->
            <field>
              <name>INT</name>
              <description>Latched PWM interrupt flag clear</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write a 1 clears ETFLG.INT</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SOCA: Latched PWM ADC start-of-conversion A flag clear -->
            <field>
              <name>SOCA</name>
              <description>Latched PWM ADC start-of-conversion A flag clear</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write a 1 clears ETFLG.SOCA</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SOCB: Latched PWM ADC start-of-conversion B flag clear -->
            <field>
              <name>SOCB</name>
              <description>Latched PWM ADC start-of-conversion B flag clear</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write a 1 clears ETFLG.SOCB</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SOCC: Latched PWM ADC start-of-conversion C flag clear -->
            <field>
              <name>SOCC</name>
              <description>Latched PWM ADC start-of-conversion C flag clear</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write a 1 clears ETFLG.SOCC</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- ETFRC: Event-Trigger Force Register -->
        <register>
          <name>ETFRC</name>
          <displayName>ETFRC</displayName>
          <description>Event-Trigger Force Register</description>
          <addressOffset>0x000000F8</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- INT: Software force a PWM interrupt\nINT bit should be written 1 at the same time\nThis bit is ignored if ETSEL.INTEN=0 or ETPS.INTPRD=00 -->
            <field>
              <name>INT</name>
              <description>Software force a PWM interrupt\nINT bit should be written 1 at the same time\nThis bit is ignored if ETSEL.INTEN=0 or ETPS.INTPRD=00</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORCE</name>
                  <description>Write a 1 generates an interrupt and sets the ETFLG.INT flag</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SOCA: Software force a start-of-conversion A pulse\nSOCAWE bit should be written 1 at the same time\nThis bit is ignored if ETSEL.SOCAEN=0 -->
            <field>
              <name>SOCA</name>
              <description>Software force a start-of-conversion A pulse\nSOCAWE bit should be written 1 at the same time\nThis bit is ignored if ETSEL.SOCAEN=0</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORCE</name>
                  <description>Write a 1 generates an interrupt and sets the ETFLG.SOCA flag</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SOCB: Software force a start-of-conversion B pulse\nSOCBWE bit should be written 1 at the same time\nThis bit is ignored if ETSEL.SOCBEN=0 -->
            <field>
              <name>SOCB</name>
              <description>Software force a start-of-conversion B pulse\nSOCBWE bit should be written 1 at the same time\nThis bit is ignored if ETSEL.SOCBEN=0</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORCE</name>
                  <description>Write a 1 generates an interrupt and sets the ETFLG.SOCB flag</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SOCC: Software force a start-of-conversion B pulse\nSOCCWE bit should be written 1 at the same time\nThis bit is ignored if ETSEL.SOCCEN=0 -->
            <field>
              <name>SOCC</name>
              <description>Software force a start-of-conversion B pulse\nSOCCWE bit should be written 1 at the same time\nThis bit is ignored if ETSEL.SOCCEN=0</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORCE</name>
                  <description>Write a 1 generates an interrupt and sets the ETFLG.SOCC flag</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- INTWE: INT bit write enable -->
            <field>
              <name>INTWE</name>
              <description>INT bit write enable</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SOCAWE: SOCA bit write enable -->
            <field>
              <name>SOCAWE</name>
              <description>SOCA bit write enable</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SOCBWE: SOCB bit write enable -->
            <field>
              <name>SOCBWE</name>
              <description>SOCB bit write enable</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SOCCWE: SOCC bit write enable -->
            <field>
              <name>SOCCWE</name>
              <description>SOCC bit write enable</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- PWMREGKEY: PWM Register Write-Allow Key Register -->
        <register>
          <name>PWMREGKEY</name>
          <displayName>PWMREGKEY</displayName>
          <description>PWM Register Write-Allow Key Register</description>
          <addressOffset>0x000000FC</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x1ACCE551</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- KEY: Write 0x1ACCE551 to unlock protected PWM registers -->
            <field>
              <name>KEY</name>
              <description>Write 0x1ACCE551 to unlock protected PWM registers</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

