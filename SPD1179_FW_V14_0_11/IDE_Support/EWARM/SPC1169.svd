        <!-- TBCTL: Time-Base Control Register -->
        <register>
          <name>TBCTL</name>
          <displayName>TBCTL</displayName>
          <description>Time-Base Control Register</description>
          <addressOffset>0x00000014</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000006</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- CNTRUN: Counter run/stop control -->
            <field>
              <name>CNTRUN</name>
              <description>Counter run/stop control</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>COUNT_STOP</name>
                  <description>Counter stop</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>COUNT_RUN</name>
                  <description>Counter free-running</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CNTMODE: Counter mode -->
            <field>
              <name>CNTMODE</name>
              <description>Counter mode</description>
              <bitRange>[2:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>COUNT_DOWN</name>
                  <description>Down-count</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>COUNT_UP</name>
                  <description>Up-count</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>COUNT_UP_DOWN</name>
                  <description>Up-down-count</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>COUNT_FREEZE</name>
                  <description>Stop and freeze (default on reset)</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PHSEN: Phase register enable -->
            <field>
              <name>PHSEN</name>
              <description>Phase register enable</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Do not load time-base counter (TBCNT) from time-base phase register (TBPHS)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description> Load TBCNT from TBPHS when synchronization event occurs (SYNCI input, software synchronization or digital compare sync event)</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PHSDIR: Phase direction\nIt is valid only when TBCNT is in up-down-count mode (CNTMODE=10) -->
            <field>
              <name>PHSDIR</name>
              <description>Phase direction\nIt is valid only when TBCNT is in up-down-count mode (CNTMODE=10)</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>COUNT_DOWN_AFTER_SYNC</name>
                  <description>Count down after synchronization event</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>COUNT_UP_AFTER_SYNC</name>
                  <description>Count up after synchronization event</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TBPRDLOAD: TBPRD active value load mode\nIt has no effect when TBCTL[TBPRDLOCK]=1 -->
            <field>
              <name>TBPRDLOAD</name>
              <description>TBPRD active value load mode\nIt has no effect when TBCTL[TBPRDLOCK]=1</description>
              <bitRange>[6:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LOAD_ON_ZERO</name>
                  <description>Load TBPRD into TBPRDA on TBCNT=0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOAD_ON_SYNC</name>
                  <description>Load TBPRD into TBPRDA on SYNC event</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOAD_ON_SYNC_ZERO</name>
                  <description>Load TBPRD into TBPRDA on SYNC event or TBCNT=0</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOAD_IMMEDIATE</name>
                  <description>Write TBPRD will immediately change the active value in TBPRDA</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TBPRDLOCK: TBPRD active value lock -->
            <field>
              <name>TBPRDLOCK</name>
              <description>TBPRD active value lock</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>UNLOCK</name>
                  <description>Active value in TBPRDA is updated according to TBCTL[TBPRDLOAD]</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOCK</name>
                  <description>Active value in TBPRDA will not change</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SYNCOSEL: Synchronization output select -->
            <field>
              <name>SYNCOSEL</name>
              <description>Synchronization output select</description>
              <bitRange>[10:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SYNCI_AND_FRCSYNC</name>
                  <description>SYNCI and the software forced sync</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TBCNT_EQU_ZERO</name>
                  <description>TBCNT=0 event</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TBCNT_EQU_TBPRD</name>
                  <description>TBCNT=TBPRD event</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TBCNT_EQU_CMPA</name>
                  <description>TBCNT=CMPA event</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TBCNT_EQU_CMPB</name>
                  <description>TBCNT=CMPB event</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TBCNT_EQU_CMPC</name>
                  <description>TBCNT=CMPC event</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TBCNT_EQU_CMPD</name>
                  <description>TBCNT=CMPD event</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable SYNCO</description>
                  <value>0x7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- FRCSYNC: Software forced synchronization\nThis event is ORed with SYNCI input and is valid only when SYNCOSEL=000 -->
            <field>
              <name>FRCSYNC</name>
              <description>Software forced synchronization\nThis event is ORed with SYNCI input and is valid only when SYNCOSEL=000</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FORCE</name>
                  <description>Write 1 forces a one-time synchronization pulse. This bit is self-cleared to 0 and not affected by PWMREGKEY protection</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TBDIV: TBCLK dividing ratio from pre-divider output.\nOverall dividing ratio is 2^TBPDIV * (TBDIV+1) -->
            <field>
              <name>TBDIV</name>
              <description>TBCLK dividing ratio from pre-divider output.\nOverall dividing ratio is 2^TBPDIV * (TBDIV+1)</description>
              <bitRange>[14:12]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>1</name>
                  <description>/1 (default on reset)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>/2</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3</name>
                  <description>/3</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4</name>
                  <description>/4</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>5</name>
                  <description>/5</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>6</name>
                  <description>/6</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>7</name>
                  <description>/7</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>8</name>
                  <description>/8</description>
                  <value>0x7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TBPDIV: TBCLK pre-dividing ratio from PWM clock input.\nOverall dividing ratio is 2^TBPDIV * (TBDIV+1) -->
            <field>
              <name>TBPDIV</name>
              <description>TBCLK pre-dividing ratio from PWM clock input.\nOverall dividing ratio is 2^TBPDIV * (TBDIV+1)</description>
              <bitRange>[17:15]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>1</name>
                  <description>/1 (default on reset)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2</name>
                  <description>/2</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4</name>
                  <description>/4</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>8</name>
                  <description>/8</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>16</name>
                  <description>/16</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>32</name>
                  <description>/32</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>64</name>
                  <description>/64</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>128</name>
                  <description>/128</description>
                  <value>0x7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DBGRUN: PWM counter behaviour when CPU is halted\n\nNote: Debug operation and CPU fault exceptions both can cause CPU halted. -->
            <field>
              <name>DBGRUN</name>
              <description>PWM counter behaviour when CPU is halted\n\nNote: Debug operation and CPU fault exceptions both can cause CPU halted.</description>
              <bitRange>[19:18]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>STOP_AFTER_COUNTING</name>
                  <description>Stop after the next time-base counter increment or decrement</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>STOP_AFTER_CYCLE</name>
                  <description>Stop when TBCNT completes a whole cycle (TBCNT=TBPRD for up-count mode and TBCNT=0 for other modes)</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>KEEP_RUN</name>
                  <description>Counter keep running when CPU is halted</description>
                  <value>0x2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- TBPRD: Time-Base Period Register -->
        <register>
          <name>TBPRD</name>
          <displayName>TBPRD</displayName>
          <description>Time-Base Period Register</description>
          <addressOffset>0x00000018</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Time-base counter period -->
            <field>
              <name>VAL</name>
              <description>Time-base counter period</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- TBPRDA: Time-Base Period Active Register -->
        <register>
          <name>TBPRDA</name>
          <displayName>TBPRDA</displayName>
          <description>Time-Base Period Active Register</description>
          <addressOffset>0x0000001C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Time-base counter active period\nWhen TBCTL[PRDLOAD]=0x3, write to TBPRD directly affects this register.\nOtherwise, the value is loaded from TBPRD upon the events defined in TBCTL[PRDLOAD]. -->
            <field>
              <name>VAL</name>
              <description>Time-base counter active period\nWhen TBCTL[PRDLOAD]=0x3, write to TBPRD directly affects this register.\nOtherwise, the value is loaded from TBPRD upon the events defined in TBCTL[PRDLOAD].</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- TBPHS: Time-Base Phase Register -->
        <register>
          <name>TBPHS</name>
          <displayName>TBPHS</displayName>
          <description>Time-Base Phase Register</description>
          <addressOffset>0x00000020</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Time-base counter phase when synchronization event occurs\nTBCTL[PHSEN]=0: The synchronization event is ignored and TBCNT keeps its value.\nTBCTL[PHSEN]=1: Time-base counter (TBCNT) will be loaded with TBPHS when synchronization event occurs. -->
            <field>
              <name>VAL</name>
              <description>Time-base counter phase when synchronization event occurs\nTBCTL[PHSEN]=0: The synchronization event is ignored and TBCNT keeps its value.\nTBCTL[PHSEN]=1: Time-base counter (TBCNT) will be loaded with TBPHS when synchronization event occurs.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- TBCNT: Time-Base Counter Register -->
        <register>
          <name>TBCNT</name>
          <displayName>TBCNT</displayName>
          <description>Time-Base Counter Register</description>
          <addressOffset>0x00000024</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Current value of the time-base counter -->
            <field>
              <name>VAL</name>
              <description>Current value of the time-base counter</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- TBFLG: Time-Base Status Register -->
        <register>
          <name>TBFLG</name>
          <displayName>TBFLG</displayName>
          <description>Time-Base Status Register</description>
          <addressOffset>0x00000028</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- SYNCI: Input synchronization latched status -->
            <field>
              <name>SYNCI</name>
              <description>Input synchronization latched status</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EVENT</name>
                  <description>No input synchronization event has occurred</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EVENT_OCCUR</name>
                  <description>An input synchronization event has occurred</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CNTMAX: Time-base counter reaching max latched status -->
            <field>
              <name>CNTMAX</name>
              <description>Time-base counter reaching max latched status</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_REACHED</name>
                  <description>TBCNT never reaches 0xFFFF</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>REACHED</name>
                  <description>TBCNT reached 0xFFFF</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CNTZRO: Time-base counter reaching zero latched status -->
            <field>
              <name>CNTZRO</name>
              <description>Time-base counter reaching zero latched status</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_REACHED</name>
                  <description>TBCNT never reaches 0x0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>REACHED</name>
                  <description>TBCNT reached 0x0</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CNTPRD: Time-base counter reaching period latched status -->
            <field>
              <name>CNTPRD</name>
              <description>Time-base counter reaching period latched status</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_REACHED</name>
                  <description>TBCNT never reaches TBPRD</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>REACHED</name>
                  <description>TBCNT reached TBPRD</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CNTCMPA: Time-base counter reaching CMPA latched status -->
            <field>
              <name>CNTCMPA</name>
              <description>Time-base counter reaching CMPA latched status</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_REACHED</name>
                  <description>TBCNTnever reaches CMPA</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>REACHED</name>
                  <description>TBCNT reached CMPA</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CNTCMPB: Time-base counter reaching CMPB latched status -->
            <field>
              <name>CNTCMPB</name>
              <description>Time-base counter reaching CMPB latched status</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_REACHED</name>
                  <description>TBCNT never reaches CMPB</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>REACHED</name>
                  <description>TBCNT reached CMPB</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CNTCMPC: Time-base counter reaching CMPC latched status -->
            <field>
              <name>CNTCMPC</name>
              <description>Time-base counter reaching CMPC latched status</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_REACHED</name>
                  <description>TBCNT never reaches CMPC</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>REACHED</name>
                  <description>TBCNT reached CMPC</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CNTCMPD: Time-base counter reaching CMPD latched status -->
            <field>
              <name>CNTCMPD</name>
              <description>Time-base counter reaching CMPD latched status</description>
              <bitRange>[7:7]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_REACHED</name>
                  <description>TBCNT never reaches CMPD</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>REACHED</name>
                  <description>TBCNT reached CMPD</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CNTDIR: Time-base counter direction status -->
            <field>
              <name>CNTDIR</name>
              <description>Time-base counter direction status</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>COUNTING_DOWN</name>
                  <description>Time-base counter is currently counting down</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>COUNTING_UP</name>
                  <description>Time-base counter is currently counting up</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- TBFLGCLR: Time-Base Status Clear Register -->
        <register>
          <name>TBFLGCLR</name>
          <displayName>TBFLGCLR</displayName>
          <description>Time-Base Status Clear Register</description>
          <addressOffset>0x0000002C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- SYNCI: Input synchronization latched status clear -->
            <field>
              <name>SYNCI</name>
              <description>Input synchronization latched status clear</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write 1 cleares the TZFLG.SYNCI. This bit is self-cleared to 0</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CNTMAX: Time-base counter reaching max latched status clear -->
            <field>
              <name>CNTMAX</name>
              <description>Time-base counter reaching max latched status clear</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write 1 cleares the TZFLG.CNTMAX. This bit is self-cleared to 0</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CNTZRO: Time-base counter reaching zero latched status clear -->
            <field>
              <name>CNTZRO</name>
              <description>Time-base counter reaching zero latched status clear</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write 1 cleares the TZFLG.CNTZRO. This bit is self-cleared to 0</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CNTPRD: Time-base counter reaching period latched status clear -->
            <field>
              <name>CNTPRD</name>
              <description>Time-base counter reaching period latched status clear</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write 1 cleares the TZFLG.CNTPRD. This bit is self-cleared to 0</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CNTCMPA: Time-base counter reaching CMPA latched status clear -->
            <field>
              <name>CNTCMPA</name>
              <description>Time-base counter reaching CMPA latched status clear</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write 1 cleares the TZFLG.CNTCMPA. This bit is self-cleared to 0</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CNTCMPB: Time-base counter reaching CMPB latched status clear -->
            <field>
              <name>CNTCMPB</name>
              <description>Time-base counter reaching CMPB latched status clear</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write 1 cleares the TZFLG.CNTCMPB. This bit is self-cleared to 0</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CNTCMPC: Time-base counter reaching CMPC latched status clear -->
            <field>
              <name>CNTCMPC</name>
              <description>Time-base counter reaching CMPC latched status clear</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write 1 cleares the TZFLG.CNTCMPC. This bit is self-cleared to 0</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CNTCMPD: Time-base counter reaching CMPD latched status clear -->
            <field>
              <name>CNTCMPD</name>
              <description>Time-base counter reaching CMPD latched status clear</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write 1 cleares the TZFLG.CNTCMPD. This bit is self-cleared to 0</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- CMPCTL: Counter-Compare Control Register -->
        <register>
          <name>CMPCTL</name>
          <displayName>CMPCTL</displayName>
          <description>Counter-Compare Control Register</description>
          <addressOffset>0x00000030</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- CMPALOAD: CMPA active value load mode\nIt has no effect when CMPATL[CMPALOCK]=1 -->
            <field>
              <name>CMPALOAD</name>
              <description>CMPA active value load mode\nIt has no effect when CMPATL[CMPALOCK]=1</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LOAD_ON_ZERO</name>
                  <description>Load CMPA into CMPAA on TBCNT=0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOAD_ON_PERIOD</name>
                  <description>Load CMPA into CMPAA on TBCNT=TBPRD</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOAD_ON_ZERO_PERIOD</name>
                  <description>Load CMPA into CMPAA on TBCNT=0 or TBCNT=TBPRD</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOAD_ON_SYNC</name>
                  <description>Load CMPA into CMPAA on SYNC event</description>
