            </field>

            <!-- GLIFRC_B_53:  -->
            <field>
              <name>GLIFRC_B_53</name>
              <description></description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>
            </field>

            <!-- GLIFRC_B_54:  -->
            <field>
              <name>GLIFRC_B_54</name>
              <description></description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
            </field>

            <!-- GLIFRC_B_55:  -->
            <field>
              <name>GLIFRC_B_55</name>
              <description></description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
            </field>

            <!-- GLIFRC_B_56:  -->
            <field>
              <name>GLIFRC_B_56</name>
              <description></description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
            </field>

            <!-- GLIFRC_B_57:  -->
            <field>
              <name>GLIFRC_B_57</name>
              <description></description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
            </field>

            <!-- GLIFRC_B_58:  -->
            <field>
              <name>GLIFRC_B_58</name>
              <description></description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
            </field>

            <!-- GLIFRC_B_59:  -->
            <field>
              <name>GLIFRC_B_59</name>
              <description></description>
              <bitRange>[27:27]</bitRange>
              <access>read-write</access>
            </field>

            <!-- GLIFRC_B_60:  -->
            <field>
              <name>GLIFRC_B_60</name>
              <description></description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
            </field>

            <!-- GLIFRC_B_61:  -->
            <field>
              <name>GLIFRC_B_61</name>
              <description></description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
            </field>

            <!-- GLIFRC_B_62:  -->
            <field>
              <name>GLIFRC_B_62</name>
              <description></description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>

            <!-- GLIFRC_B_63:  -->
            <field>
              <name>GLIFRC_B_63</name>
              <description></description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- GGRAWIF: GPIO Global Interrupt Raw Flag Register -->
        <register>
          <name>GGRAWIF</name>
          <displayName>GGRAWIF</displayName>
          <description>GPIO Global Interrupt Raw Flag Register</description>
          <addressOffset>0x000001F0</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- LEVEL: Global GPIO level event flag\nThis bit is the logic OR of GLRAWIF bits -->
            <field>
              <name>LEVEL</name>
              <description>Global GPIO level event flag\nThis bit is the logic OR of GLRAWIF bits</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Specified level was not detected on GPIO</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Specified level was detected on GPIO</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- EDGE: Global GPIO edge event flag\nThis bit is the logic OR of GRERAWIF and GFERAWIF bits -->
            <field>
              <name>EDGE</name>
              <description>Global GPIO edge event flag\nThis bit is the logic OR of GRERAWIF and GFERAWIF bits</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>No edge was detected on GPIO</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Edge was detected on GPIO</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- REDGE: Global GPIO rising edge event flag\nThis bit is the logic OR of GRERAWIF bits -->
            <field>
              <name>REDGE</name>
              <description>Global GPIO rising edge event flag\nThis bit is the logic OR of GRERAWIF bits</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>No rising edge was detected on GPIO</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Rising edge was detected on GPIO</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- FEDGE: Global GPIO falling edge event flag\nThis bit is the logic OR of GFERAWIF bits -->
            <field>
              <name>FEDGE</name>
              <description>Global GPIO falling edge event flag\nThis bit is the logic OR of GFERAWIF bits</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>No falling edge was detected on GPIO</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Falling edge was detected on GPIO</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- GGIF: GPIO Global Interrupt Flag Register -->
        <register>
          <name>GGIF</name>
          <displayName>GGIF</displayName>
          <description>GPIO Global Interrupt Flag Register</description>
          <addressOffset>0x000001F4</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- LEVEL: Global GPIO level-triggered interrupt flag -->
            <field>
              <name>LEVEL</name>
              <description>Global GPIO level-triggered interrupt flag</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Level-triggered interrupt does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Level-triggered interrupt occurred and issued to the CPU. Further interrupt will not be generated until this bit is cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- EDGE: Global GPIO edge-triggered interrupt flag -->
            <field>
              <name>EDGE</name>
              <description>Global GPIO edge-triggered interrupt flag</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Edge-triggered interrupt does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Edge-triggered interrupt occurred and issued to the CPU. Further interrupt will not be generated until this bit is cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- GGIC: GPIO Global Interrupt Clear Register -->
        <register>
          <name>GGIC</name>
          <displayName>GGIC</displayName>
          <description>GPIO Global Interrupt Clear Register</description>
          <addressOffset>0x000001F8</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- LEVEL: Global GPIO level-triggered interrupt clear -->
            <field>
              <name>LEVEL</name>
              <description>Global GPIO level-triggered interrupt clear</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write a 0 has no effet and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write a 1 clears the flag. This bit is self-cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- EDGE: Global GPIO edge-triggered interrupt clear -->
            <field>
              <name>EDGE</name>
              <description>Global GPIO edge-triggered interrupt clear</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write a 0 has no effet and always reads back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write a 1 clears the flag. This bit is self-cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- GPIOREGKEY: GPIO Register Write-Allow Key Register -->
        <register>
          <name>GPIOREGKEY</name>
          <displayName>GPIOREGKEY</displayName>
          <description>GPIO Register Write-Allow Key Register</description>
          <addressOffset>0x000001FC</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x1ACCE551</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- KEY: Write 0x1ACCE551 to unlock protected GPIO registers -->
            <field>
              <name>KEY</name>
              <description>Write 0x1ACCE551 to unlock protected GPIO registers</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>UART0</name>
      <description></description>
      <groupName>UART</groupName>
      <baseAddress>0x40001400</baseAddress>
      <addressBlock>
        <offset>0x00000000</offset>
        <size>92</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
         <name>UART0</name>
         <description>UART0 Interrupt</description>
         <value>6</value>
      </interrupt>
      <registers>

        <!-- UARTDAT: UART Data Register -->
        <register>
          <name>UARTDAT</name>
          <displayName>UARTDAT</displayName>
          <description>UART Data Register</description>
          <addressOffset>0x00000000</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Data transmitted or received on the UART bus.\nA write to the register accesses the transmit hold register to set the data to be transmitted.\nA read to the register accesses the receive buffer register to get the received data -->
            <field>
              <name>VAL</name>
              <description>Data transmitted or received on the UART bus.\nA write to the register accesses the transmit hold register to set the data to be transmitted.\nA read to the register accesses the receive buffer register to get the received data</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- UARTCTL: UART Control Register -->
        <register>
          <name>UARTCTL</name>
          <displayName>UARTCTL</displayName>
          <description>UART Control Register</description>
          <addressOffset>0x00000004</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- RXEN: UART receive enable -->
            <field>
              <name>RXEN</name>
              <description>UART receive enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable UART receive</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable UART receive</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXEN: UART transmit enable -->
            <field>
              <name>TXEN</name>
              <description>UART transmit enable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable UART transmit</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable UART transmit</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXDMAEN: Receive DMA requests enable -->
            <field>
              <name>RXDMAEN</name>
              <description>Receive DMA requests enable</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable DMA for UART receiver</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable DMA for UART receiver</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXDMAEN: Transmit DMA requests enable -->
            <field>
              <name>TXDMAEN</name>
              <description>Transmit DMA requests enable</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable DMA for UART transmitter</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable DMA for UART transmitter</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- LPBK: Loopback mode for diagnostic testing as below\n(1) Set the transmitter serial output to logic 1 state\n(2) Disconnect the receiver serial input from pin.\n(3) Transmitted data is received immediately. The output of the Transmit Shift Register is looped back into the Receive Shift Register input.\n(4) Support transferring a break signal from the transmitter section to the receiver section\nThis bit must be configured before UART is enabled -->
            <field>
              <name>LPBK</name>
              <description>Loopback mode for diagnostic testing as below\n(1) Set the transmitter serial output to logic 1 state\n(2) Disconnect the receiver serial input from pin.\n(3) Transmitted data is received immediately. The output of the Transmit Shift Register is looped back into the Receive Shift Register input.\n(4) Support transferring a break signal from the transmitter section to the receiver section\nThis bit must be configured before UART is enabled</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NORMAL_MODE</name>
                  <description>Normal UART operation</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOOPBACK_MODE</name>
                  <description>Loopback-mode UART operation</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- BUS32: 32-Bit bus width\n -->
            <field>
              <name>BUS32</name>
              <description>32-Bit bus width\n</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>8BIT</name>
                  <description>8-bit peripheral bus</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>32BIT</name>
                  <description>32-bit peripheral bus</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- ABEN: Auto baud enable -->
            <field>
              <name>ABEN</name>
              <description>Auto baud enable</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable auto baud</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable auto baud</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- ABUP: Auto baud count update option -->
            <field>
              <name>ABUP</name>
              <description>Auto baud count update option</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>UPDATE_BY_HW</name>
                  <description>Baud counter is updated by the hardware</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>UPDATE_BY_SW</name>
                  <description>Baud counter is updated by the software</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- NRZMODE: NRZ coding mode.\nThis bit is ignored in serail infra-red (SIR) mode and general NRZ level is always used. -->
            <field>
              <name>NRZMODE</name>
              <description>NRZ coding mode.\nThis bit is ignored in serail infra-red (SIR) mode and general NRZ level is always used.</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NRZ_LEVEL</name>
                  <description>NRZ level coding. High level for 1 and low level for 0.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NRZ_SPACE</name>
                  <description>NRZ space coding. Keep constant on 1 and toggle on 0.</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NRZ_MARK</name>
                  <description>NRZ mark coding. Keep constant on 0 and toggle on 1.</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- DATABIT: Data bits of each character -->
            <field>
              <name>DATABIT</name>
              <description>Data bits of each character</description>
              <bitRange>[11:10]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>5_DATA_BIT</name>
                  <description>5-bit character</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>6_DATA_BIT</name>
                  <description>6-bit character</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>7_DATA_BIT</name>
                  <description>7-bit character</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>8_DATA_BIT</name>
                  <description>8-bit character</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PRTYBIT: Parity bit mode -->
            <field>
              <name>PRTYBIT</name>
              <description>Parity bit mode</description>
              <bitRange>[13:12]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EVEN_PARITY</name>
                  <description>Sends or checks for even parity</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ODD_PARITY</name>
                  <description>Sends or checks for odd parity</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>STICKY_HIGH_PARITY</name>
                  <description>Sends or checks for sticky high parity</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>STICKY_LOW_PARITY</name>
                  <description>Sends or checks for sticky low parity</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- PRTYEN: Parity enable -->
            <field>
              <name>PRTYEN</name>
              <description>Parity enable</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PARITY_DISABLE</name>
                  <description>Disable parity bit for UART mode and disable ID parity check for LIN</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PARITY_ENABLE</name>
                  <description>Enable parity bit for UART mode and enable ID parity check for LIN</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- STOPBIT: Stop bits -->
            <field>
              <name>STOPBIT</name>
              <description>Stop bits</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>1_STOP_BIT</name>
                  <description>1 stop bit</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2_STOP_BIT</name>
                  <description>1.5 stop bits for 5-bit character\n2 stop bits for 6/7/8 bit character</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CLRRF: Clear the receive FIFO -->
            <field>
              <name>CLRRF</name>
              <description>Clear the receive FIFO</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write a 0 has no effect and always read back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write a 1 clears the receive FIFO and RXDAV flag\nThis bit is self-cleared</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CLRTF: Clear the transmit FIFO\nThe transmit shift register is not affected by this bit, and it completes the current transmission. -->
            <field>
              <name>CLRTF</name>
              <description>Clear the transmit FIFO\nThe transmit shift register is not affected by this bit, and it completes the current transmission.</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write a 0 has no effect and always read back 0</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEAR</name>
                  <description>Write a 1 clears the transmit FIFO and sets TXDREQ flag.\nThis bit is self-cleared</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SETBRK: Set Break\nCauses a break condition to be transmitted to the receiving UART. Acts only on the TXD pin and has no effect on the transmit logic. In FIFO mode, wait until the transmitter is idle (UARTSTS.TXDONE=1) to set and clear SB. -->
            <field>
              <name>SETBRK</name>
              <description>Set Break\nCauses a break condition to be transmitted to the receiving UART. Acts only on the TXD pin and has no effect on the transmit logic. In FIFO mode, wait until the transmitter is idle (UARTSTS.TXDONE=1) to set and clear SB.</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>No effect on TXD output</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SET_BREAK</name>
                  <description>This bit is self cleared when the UART starts to transmit the break condition. If software write this bit again before the current break condition is stop transmitting, TXD pin will keep low for the new frame. i.e. The receiver sees single break condition with bus is holding low for multiple frame duration.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- IDLECNTEN: Bus idle counter enable -->
            <field>
              <name>IDLECNTEN</name>
              <description>Bus idle counter enable</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RFEMODE: Receive FIFO error report mode -->
            <field>
              <name>RFEMODE</name>
              <description>Receive FIFO error report mode</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>REPORT_IF_WRITABLE</name>
                  <description>Report frame error, parity error and break indicator only when the FIFO is not full and data is writable</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>REPORT_ALL</name>
                  <description>Report frame error, parity error and break indicator upon event regardless of FIFO status</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SWAPPIN: Swap TXD and RXD pin function -->
            <field>
              <name>SWAPPIN</name>
              <description>Swap TXD and RXD pin function</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ORIGINAL_FUNCTION</name>
                  <description>Transmit data via TXD and receive data via RXD</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SWAP_FUNCTION</name>
                  <description>Transmit data via RXD and receive data via TXD</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- LINCTL: LIN Control Register -->
        <register>
          <name>LINCTL</name>
          <displayName>LINCTL</displayName>
          <description>LIN Control Register</description>
          <addressOffset>0x00000008</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00E00000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- LINEN: LIN mode enable -->
            <field>
              <name>LINEN</name>
              <description>LIN mode enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>UART_MODE</name>
                  <description>Disable LIN mode</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LIN_MODE</name>
                  <description>Enable LIN mode</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- MASTER: LIN node role -->
            <field>
              <name>MASTER</name>
              <description>LIN node role</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SLAVE</name>
                  <description>Slave node</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MASTER</name>
                  <description>Mater node</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SBRKLEN: Synchronize break length -->
            <field>
              <name>SBRKLEN</name>
              <description>Synchronize break length</description>
              <bitRange>[4:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>13_BIT</name>
                  <description>Synch break is 13-bit dominant</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>14_BIT</name>
                  <description>Synch break is 14-bit dominant</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>15_BIT</name>
                  <description>Synch break is 15-bit dominant</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>16_BIT</name>
                  <description>Synch break is 16-bit dominant</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>17_BIT</name>
                  <description>Synch break is 17-bit dominant</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>18_BIT</name>
                  <description>Synch break is 18-bit dominant</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>19_BIT</name>
                  <description>Synch break is 19-bit dominant</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>20_BIT</name>
                  <description>Synch break is 20-bit dominant</description>
                  <value>0x7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SBRKDEL: Synchronize break delimiter -->
            <field>
              <name>SBRKDEL</name>
              <description>Synchronize break delimiter</description>
              <bitRange>[6:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>1_BIT</name>
                  <description>Synch break delimiter is 1-bit recessive</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2_BIT</name>
                  <description>Synch break delimiter is 2-bit recessive</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3_BIT</name>
                  <description>Synch break delimiter is 3-bit recessive</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4_BIT</name>
                  <description>Synch break delimiter is 4-bit recessive</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RESP: Response to take -->
            <field>
              <name>RESP</name>
              <description>Response to take</description>
              <bitRange>[8:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>RESPONSE_NONE</name>
                  <description>Do not response in the frame</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RESPONSE_RX</name>
                  <description>Receive data in the frame</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RESPONSE_TX</name>
                  <description>Transmit data in the frame</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RESPONSE_TR</name>
                  <description>Transmit and receive data in the frame (For debug purpose)</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RESPLEN: Response data length -->
            <field>
              <name>RESPLEN</name>
              <description>Response data length</description>
              <bitRange>[12:9]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>X_BYTE</name>
                  <description>The repsonse data field length is decide by LINID[5:4]\n11: 8-byte; 10: 4-byte; Other: 2-byte</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1_BYTE</name>
                  <description>The repsonse data field has 1-byte</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2_BYTE</name>
                  <description>The repsonse data field has 2-byte</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3_BYTE</name>
                  <description>The repsonse data field has 3-byte</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4_BYTE</name>
                  <description>The repsonse data field has 4-byte</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>5_BYTE</name>
                  <description>The repsonse data field has 5-byte</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>6_BYTE</name>
                  <description>The repsonse data field has 6-byte</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>7_BYTE</name>
                  <description>The repsonse data field has 7-byte</description>
                  <value>0x7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>8_BYTE</name>
                  <description>The repsonse data field has 8-byte</description>
                  <value>0x8</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- BYTESPACE: Inter-byte space (number of bauds) -->
            <field>
              <name>BYTESPACE</name>
              <description>Inter-byte space (number of bauds)</description>
              <bitRange>[14:13]</bitRange>
              <access>read-write</access>
            </field>

            <!-- RESPSPACE: Response space (number of bauds) -->
            <field>
              <name>RESPSPACE</name>
              <description>Response space (number of bauds)</description>
              <bitRange>[18:16]</bitRange>
              <access>read-write</access>
            </field>

            <!-- RFMODE: Receive FIFO operation mode -->
            <field>
              <name>RFMODE</name>
              <description>Receive FIFO operation mode</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SAVE_ALL_DATA_AND_CHECKSUM</name>
                  <description>The frame data as well as the checksum byte will be saved in the RX FIFO regardless whether the checksum is correct\nThis is useful to debug the checksum error</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SAVE_CORRECT_DATA</name>
                  <description>The frame data will saved in the RX FIFO only when the checksum is correct</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- ATOTH: Auto timeout threshold  -->
            <field>
              <name>ATOTH</name>
              <description>Auto timeout threshold </description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>MANUAL_THRESHOLD</name>
                  <description>The threshold is manually specified via UARTTOTH</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AUTO_THRESHOLD</name>
                  <description>The threshold is automatically set according to LIN standard, namely the minimum required transmission time plus 40% margin</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- ATXCHKSUM: Auto transmit checksum -->
            <field>
              <name>ATXCHKSUM</name>
              <description>Auto transmit checksum</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>MANUAL_TX</name>
                  <description>Checksum is transmitted by manual request via writing 1 to TXCHKSUM bit</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AUTO_TX</name>
                  <description>Checksum is transmitted automatically after the data field</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- CHKSUM: Checksum mode -->
            <field>
              <name>CHKSUM</name>
              <description>Checksum mode</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CLASSIC_MODE</name>
                  <description>Classic checksum is used so the checksum contains the modulo-256 sum with carry over all data bytes</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENHANCED_MODE</name>
                  <description>Enhanced checksum is used so the checksum contains the modulo-256 sum with carry over all data bytes and the protected ID.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXCHKSUM: One-shot checksum transmit request -->
            <field>
              <name>TXCHKSUM</name>
              <description>One-shot checksum transmit request</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Write 0 has no effect and read back 0 after checksum is transmitted</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRANSMIT</name>
                  <description>Write 1 will request to transmit the checksum\nIf the data field is already finished, the checksum will be transmitted immediately\nIf the data field is not finished, the request is pended and the checksum will be transmitted right after the data field is done</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- LINID: LIN ID Register -->
        <register>
          <name>LINID</name>
          <displayName>LINID</displayName>
          <description>LIN ID Register</description>
          <addressOffset>0x0000000C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- ID: LIN ID\nWrite to this register set the ID to be transmitted\nRead from this register get the received ID -->
            <field>
              <name>ID</name>
              <description>LIN ID\nWrite to this register set the ID to be transmitted\nRead from this register get the received ID</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- LINIDFILT: LIN ID Filter Register -->
        <register>
          <name>LINIDFILT</name>
          <displayName>LINIDFILT</displayName>
          <description>LIN ID Filter Register</description>
          <addressOffset>0x00000010</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- REFID: LIN ID reference for the compare -->
            <field>
              <name>REFID</name>
              <description>LIN ID reference for the compare</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>

            <!-- MASK: LIN ID mask\nIt indicates whether the corresponding bit in REFID is used for comparison\n0: Not compare; 1: Compare -->
            <field>
              <name>MASK</name>
              <description>LIN ID mask\nIt indicates whether the corresponding bit in REFID is used for comparison\n0: Not compare; 1: Compare</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- BUSIDLETH: Bus Idle Threshold Register -->
        <register>
          <name>BUSIDLETH</name>
          <displayName>BUSIDLETH</displayName>
          <description>Bus Idle Threshold Register</description>
          <addressOffset>0x00000014</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0xFFFFFFFF</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Number of AHB clock cycles to report bus idle (no activity on the RXD) -->
            <field>
              <name>VAL</name>
              <description>Number of AHB clock cycles to report bus idle (no activity on the RXD)</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- UARTBDCNT: UART Baud Count Register -->
        <register>
          <name>UARTBDCNT</name>
          <displayName>UARTBDCNT</displayName>
          <description>UART Baud Count Register</description>
          <addressOffset>0x00000018</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000010</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: UART baud rate will be UART clock / UARTBDCNT.\nThe minimum valid value is 16 and write a value below 16 will be reset to 16. -->
            <field>
              <name>VAL</name>
              <description>UART baud rate will be UART clock / UARTBDCNT.\nThe minimum valid value is 16 and write a value below 16 will be reset to 16.</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- UARTABCNT: UART Auto-Baud Count Register -->
        <register>
          <name>UARTABCNT</name>
          <displayName>UARTABCNT</displayName>
          <description>UART Auto-Baud Count Register</description>
          <addressOffset>0x0000001C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Number of UART clock cycles within a start-bit pulse -->
            <field>
              <name>VAL</name>
              <description>Number of UART clock cycles within a start-bit pulse</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- UARTTOTH: UART Timeout Threshold Register -->
        <register>
          <name>UARTTOTH</name>
          <displayName>UARTTOTH</displayName>
          <description>UART Timeout Threshold Register</description>
          <addressOffset>0x00000020</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000030</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Number of UART baud cycles for the specified condition to keep before the timeout event is generated\nThe minimum allowed number is 1. Write a value as 0 will be reset to 1\nFor UART mode, the condition is that there is unread received data in the FIFO and the RXD bus keeps high\nFor LIN mode, the condition is that the received data length is below the expectation when the response field is timeout -->
            <field>
              <name>VAL</name>
              <description>Number of UART baud cycles for the specified condition to keep before the timeout event is generated\nThe minimum allowed number is 1. Write a value as 0 will be reset to 1\nFor UART mode, the condition is that there is unread received data in the FIFO and the RXD bus keeps high\nFor LIN mode, the condition is that the received data length is below the expectation when the response field is timeout</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- UARTRXLVL: UART Receive FIFO Level Register -->
        <register>
          <name>UARTRXLVL</name>
          <displayName>UARTRXLVL</displayName>
          <description>UART Receive FIFO Level Register</description>
          <addressOffset>0x00000024</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Number of bytes (0-64) remaining in the Receive FIFO -->
            <field>
              <name>VAL</name>
              <description>Number of bytes (0-64) remaining in the Receive FIFO</description>
              <bitRange>[6:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- UARTTXLVL: UART Transmit FIFO Level Register -->
        <register>
          <name>UARTTXLVL</name>
          <displayName>UARTTXLVL</displayName>
          <description>UART Transmit FIFO Level Register</description>
          <addressOffset>0x00000028</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Number of bytes (0-64) remaining in the Transmit FIFO -->
            <field>
              <name>VAL</name>
              <description>Number of bytes (0-64) remaining in the Transmit FIFO</description>
              <bitRange>[6:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>

        <!-- UARTRXTH: UART Receive FIFO Threshold Register -->
        <register>
          <name>UARTRXTH</name>
          <displayName>UARTRXTH</displayName>
          <description>UART Receive FIFO Threshold Register</description>
          <addressOffset>0x0000002C</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Trigger receive data available interrupt when UARTRFLVL&amp;gt;UARTRFTH -->
            <field>
              <name>VAL</name>
              <description>Trigger receive data available interrupt when UARTRFLVL&amp;gt;UARTRFTH</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- UARTTXTH: UART Transmit FIFO Threshold Register -->
        <register>
          <name>UARTTXTH</name>
          <displayName>UARTTXTH</displayName>
          <description>UART Transmit FIFO Threshold Register</description>
          <addressOffset>0x00000030</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- VAL: Trigger transmit data request interrupt when UARTTFLVL&amp;lt;=UARTTFTH -->
            <field>
              <name>VAL</name>
              <description>Trigger transmit data request interrupt when UARTTFLVL&amp;lt;=UARTTFTH</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- UARTSIRCTL: UART Infrared Control Register -->
        <register>
          <name>UARTSIRCTL</name>
          <displayName>UARTSIRCTL</displayName>
          <description>UART Infrared Control Register</description>
          <addressOffset>0x00000034</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x0000010C</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- RXSIREN: Receiver SIR enable -->
            <field>
              <name>RXSIREN</name>
              <description>Receiver SIR enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>UART</name>
                  <description>Receiver is in UART mode.\nAll clocking to the lrDA decoder is blocked and the RXD pin is fed directly to the UART.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>INFRARED</name>
                  <description>Receiver is in infrared mode.\nThe signal from the RXD pin is processed by lrDA decoder before it is fed to the UART.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXSIREN: Transmitter SIR enable -->
            <field>
              <name>TXSIREN</name>
              <description>Transmitter SIR enable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>UART</name>
                  <description>Transmitter is in UART mode.\nAll clocking to the lrDA encoder is blocked and the UART&apos;s TXD signal is connected directly to the device pin.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>INFRARED</name>
                  <description>Transmitter is in infrared mode.\nThe normal TXD output from the UART is processed by the lrDA encoder before it is fed to the device pin.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXPOL: Receive data polarity -->
            <field>
              <name>RXPOL</name>
              <description>Receive data polarity</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NEGATIVE_PULSE_AS_ZERO</name>
                  <description>SIR decoder takes negative pulses as zeros</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>POSITIVE_PULSE_AS_ZERO</name>
                  <description>SIR decoder takes positive pulses as zeros</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXPOL: Transmit data polarity -->
            <field>
              <name>TXPOL</name>
              <description>Transmit data polarity</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NEGATIVE_PULSE_AS_ZERO</name>
                  <description>SIR encoder generates a negative pulse for a data bit of zero</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>POSITIVE_PULSE_AS_ZERO</name>
                  <description>SIR encoder generates a positive pulse for a data bit of zero</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- XMODE: Transmit pulse width select -->
            <field>
              <name>XMODE</name>
              <description>Transmit pulse width select</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>WIDTH_3_OVER_16</name>
                  <description>Transmit pulse width has a constant duty cycle as 3/16 bit time</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>WIDTH_TXPW_CYCLES</name>
                  <description>Transmit pulse width has a constant width as TXPW UART clock cycles</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXPW: Transmit pulse width\nThe minimum allowed value is 1. Write a 0 will be reset as 1 by hardware. -->
            <field>
              <name>TXPW</name>
              <description>Transmit pulse width\nThe minimum allowed value is 1. Write a 0 will be reset as 1 by hardware.</description>
              <bitRange>[13:5]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>

        <!-- UARTSTS: UART Status Register -->
        <register>
          <name>UARTSTS</name>
          <displayName>UARTSTS</displayName>
          <description>UART Status Register</description>
          <addressOffset>0x00000040</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x0000000C</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- RXNE: Receive FIFO not empty (i.e. UARTRFLVL&amp;gt;0) -->
            <field>
              <name>RXNE</name>
              <description>Receive FIFO not empty (i.e. UARTRFLVL&amp;gt;0)</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EMPTY</name>
                  <description>Receive FIFO is empty</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NOT_EMPTY</name>
                  <description>Receive FIFO contains one or more data entries</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXFULL: Receive FIFO full -->
            <field>
              <name>RXFULL</name>
              <description>Receive FIFO full</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_FULL</name>
                  <description>Receive FIFO contains empty locations</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FULL</name>
                  <description>Receive FIFO is completely full</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXEMPTY: Transmit FIFO empty -->
            <field>
              <name>TXEMPTY</name>
              <description>Transmit FIFO empty</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_EMPTY</name>
                  <description>Transmit FIFO contains one ore more data entries</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EMPTY</name>
                  <description>Transmit FIFO is completely empty.\nBut there may be still data in the transmit shift out register and the transmit is going on.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXNF: Transmit FIFO not full (i.e. UARTTFLVL&amp;lt;64) -->
            <field>
              <name>TXNF</name>
              <description>Transmit FIFO not full (i.e. UARTTFLVL&amp;lt;64)</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FULL</name>
                  <description>Transmit FIFO is full</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NOT_FULL</name>
                  <description>Transmit FIFO contains empty locations</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXPRTYERR: Parity error indicator for the data just read out from the receive FIFO.\nFor 32-bit bus, this bit is the logic OR of the parity error for all bytes read. -->
            <field>
              <name>RXPRTYERR</name>
              <description>Parity error indicator for the data just read out from the receive FIFO.\nFor 32-bit bus, this bit is the logic OR of the parity error for all bytes read.</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CORRECT</name>
                  <description>No parity error for the data read out via UARTDAT</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ERROR</name>
                  <description>Parity error for the data read out via UARTDAT</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXFRMERR: Frame error indicator for the data just read out from the receive FIFO.\nFor 32-bit bus, this bit is the logic OR of the frame error for all bytes read. -->
            <field>
              <name>RXFRMERR</name>
              <description>Frame error indicator for the data just read out from the receive FIFO.\nFor 32-bit bus, this bit is the logic OR of the frame error for all bytes read.</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CORRECT</name>
                  <description>No frame error for the data read out via UARTDAT</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ERROR</name>
                  <description>Frame error for the data read out via UARTDAT</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXBRK: Break condition indicator for the data just read out from the receive FIFO.\nFor 32-bit bus, this bit is the logic OR of the break condition for all bytes read. -->
            <field>
              <name>RXBRK</name>
              <description>Break condition indicator for the data just read out from the receive FIFO.\nFor 32-bit bus, this bit is the logic OR of the break condition for all bytes read.</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NORMAL_DATA</name>
                  <description>The all &quot;0&quot; byte read from UARTDAT is a normal data</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BREAK_CONDITION</name>
                  <description>The all &quot;0&quot; byte read from UARTDAT is due to a break condition</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXERR: Indicate there is parity error, frame error or break condition for the un-read data in the receive FIFO -->
            <field>
              <name>RXERR</name>
              <description>Indicate there is parity error, frame error or break condition for the un-read data in the receive FIFO</description>
              <bitRange>[7:7]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CORRECT</name>
                  <description>Data in receive FIFO are all error-free</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ERROR</name>
                  <description>There is error for un-read data in the receive FIFO</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXBUSY: Indicate the UART is receiving -->
            <field>
              <name>RXBUSY</name>
              <description>Indicate the UART is receiving</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>IDLE</name>
                  <description>The UART receiver is in idle state</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BUSY</name>
                  <description>The UART receiver is busy</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXBUSY: Indicate the UART is transmitting -->
            <field>
              <name>TXBUSY</name>
              <description>Indicate the UART is transmitting</description>
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>IDLE</name>
                  <description>The UART transmitter is in idle state</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BUSY</name>
                  <description>The UART transmitter is busy</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- UARTRAWIF: UART Raw Interrupt Flag Register -->
        <register>
          <name>UARTRAWIF</name>
          <displayName>UARTRAWIF</displayName>
          <description>UART Raw Interrupt Flag Register</description>
          <addressOffset>0x00000044</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- RXUDF: Receive underflow interrupt raw flag\nIt indicates an attempt to read UARTDAT when the receive FIFO is empty -->
            <field>
              <name>RXUDF</name>
              <description>Receive underflow interrupt raw flag\nIt indicates an attempt to read UARTDAT when the receive FIFO is empty</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Event occurred</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Event does not occur</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXOVF: Receive overflow interrupt raw flag\nIt indicates a new character is received when the receive FIFO is full and the new data is dropped. -->
            <field>
              <name>RXOVF</name>
              <description>Receive overflow interrupt raw flag\nIt indicates a new character is received when the receive FIFO is full and the new data is dropped.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Event occurred</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Event does not occur</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXREQ: Receive data read request interrupt raw flag -->
            <field>
              <name>RXREQ</name>
              <description>Receive data read request interrupt raw flag</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Read a 0 indicates there are not enough data in the receive FIFO\nIt will be set to 1 once UARTRXLVL&amp;gt;UARTRXTH</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Read a 1 indicates there are enough data in the receive FIFO\nIt will be cleared to 0 once UARTRXLVL&amp;lt;=UARTRXTH</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXPRTYERR: Receive parity error interrupt raw flag\nThis bit is set once a parity error is received\nIn LIN mode, it indicates parity error for the PID -->
            <field>
              <name>RXPRTYERR</name>
              <description>Receive parity error interrupt raw flag\nThis bit is set once a parity error is received\nIn LIN mode, it indicates parity error for the PID</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Event occurred</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Event does not occur</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXFRMERR: Receive frame error interrupt raw flag\nThis bit is set once a frame error (stop bit is low) is received -->
            <field>
              <name>RXFRMERR</name>
              <description>Receive frame error interrupt raw flag\nThis bit is set once a frame error (stop bit is low) is received</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Event occurred</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Event does not occur</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXBRK: Receive break condition interrupt raw flag\nThis bit is set once a break condition is received -->
            <field>
              <name>RXBRK</name>
              <description>Receive break condition interrupt raw flag\nThis bit is set once a break condition is received</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Event occurred</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Event does not occur</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXTIMEOUT: Receive time out interrupt raw flag\nFor LIN mode, it indicates timeout for the response field -->
            <field>
              <name>RXTIMEOUT</name>
              <description>Receive time out interrupt raw flag\nFor LIN mode, it indicates timeout for the response field</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Event occurred</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Event does not occur</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXOVF: Transmit overflow interrupt raw flag\nIt indicates an attempt to write UARTDAT when transmit FIFO is full -->
            <field>
              <name>TXOVF</name>
              <description>Transmit overflow interrupt raw flag\nIt indicates an attempt to write UARTDAT when transmit FIFO is full</description>
              <bitRange>[7:7]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Event occurred</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Event does not occur</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- TXREQ: Transmit data write request interrupt raw flag -->
            <field>
              <name>TXREQ</name>
              <description>Transmit data write request interrupt raw flag</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Read a 0 indicates there is enough data in the transmit FIFO\nIt will be set to 1 once UARTTXLVL&amp;lt;=UARTTXTH</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Read a 1 indicates the transmit FIFO requests more data\nIt will be cleared to 0 once UARTTXLVL&amp;gt;UARTTXTH</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- ABLOCK: Auto-baud lock interrupt raw flag -->
            <field>
              <name>ABLOCK</name>
              <description>Auto-baud lock interrupt raw flag</description>
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Event does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Event occurred</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- LINIDMATCH: LIN received ID match interrupt raw flag -->
            <field>
              <name>LINIDMATCH</name>
              <description>LIN received ID match interrupt raw flag</description>
              <bitRange>[10:10]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Event does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Event occurred</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- LINBITERR: LIN bit error interrupt raw flag -->
            <field>
              <name>LINBITERR</name>
              <description>LIN bit error interrupt raw flag</description>
              <bitRange>[11:11]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Event does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Event occurred</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- LINCSERR: LIN checksum error interrup raw flag -->
            <field>
              <name>LINCSERR</name>
              <description>LIN checksum error interrup raw flag</description>
              <bitRange>[12:12]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Event does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Event occurred</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- LINSBERR: LIN received sync byte error raw flag -->
            <field>
              <name>LINSBERR</name>
              <description>LIN received sync byte error raw flag</description>
              <bitRange>[13:13]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Event does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Event occurred</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- BUSIDLE: LIN bus idle raw flag -->
            <field>
              <name>BUSIDLE</name>
              <description>LIN bus idle raw flag</description>
              <bitRange>[14:14]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Event does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Event occurred</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>


          </fields>
        </register>

        <!-- UARTIF: UART Interrupt Flag Register -->
        <register>
          <name>UARTIF</name>
          <displayName>UARTIF</displayName>
          <description>UART Interrupt Flag Register</description>
          <addressOffset>0x00000048</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- RXUDF: Receive underflow interrupt flag\nThis bit is always 0 if UARTIE_RXUDF=0 -->
            <field>
              <name>RXUDF</name>
              <description>Receive underflow interrupt flag\nThis bit is always 0 if UARTIE_RXUDF=0</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Interrupt is never triggerred</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Interrupt is triggered and issued to the CPU.\nFurther event will not trigger interrupt until this bit is cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RXOVF: Receive overflow interrupt flag\nThis bit is always 0 if UARTIE_RXOVF=0 -->
            <field>
              <name>RXOVF</name>
              <description>Receive overflow interrupt flag\nThis bit is always 0 if UARTIE_RXOVF=0</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Interrupt is never triggerred</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Interrupt is triggered and issued to the CPU.\nFurther event will not trigger interrupt until this bit is cleared.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

