        <!-- DMAIF: DMA Combined Interrupt Flag Register -->
        <register>
          <name>DMAIF</name>
          <displayName>DMAIF</displayName>
          <description>DMA Combined Interrupt Flag Register</description>
          <addressOffset>0x00000360</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- TC: Global transfer complete interrupt flag\nThis bit is the logic OR of DMATCIF bits -->
            <field>
              <name>TC</name>
              <description>Global transfer complete interrupt flag\nThis bit is the logic OR of DMATCIF bits</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>No transfer complete interrupt was generated</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Transfer complete interrupt was generated</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- BC: Global block transfer complete interrupt flag\nThis bit is the logic OR of DMATCIF bits -->
            <field>
              <name>BC</name>
              <description>Global block transfer complete interrupt flag\nThis bit is the logic OR of DMATCIF bits</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>No transfer complete interrupt was generated</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Transfer complete interrupt was generated</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- SC: Global source transfer complete interrupt flag\nThis bit is the logic OR of DMATCIF bits -->
            <field>
              <name>SC</name>
              <description>Global source transfer complete interrupt flag\nThis bit is the logic OR of DMATCIF bits</description>
              <bitRange>[2:2]</bitRange>
