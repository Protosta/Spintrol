        <!-- ADCREGKEY: ADC Register Write-Allow Key Register -->
        <register>
          <name>ADCREGKEY</name>
          <displayName>ADCREGKEY</displayName>
          <description>ADC Register Write-Allow Key Register</description>
          <addressOffset>0x000002CC</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x1ACCE551</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- KEY: Write 0x1ACCE551 to unlock protected ADC registers -->
            <field>
              <name>KEY</name>
              <description>Write 0x1ACCE551 to unlock protected ADC registers</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>

    <peripheral>
      <name>COMP</name>
      <description></description>
      <groupName>COMP</groupName>
      <baseAddress>0x40003000</baseAddress>
      <addressBlock>
        <offset>0x000002F4</offset>
        <size>268</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>

        <!-- COMPFLTOUT: Comparator Filter Output Register -->
        <register>
          <name>COMPFLTOUT</name>
          <displayName>COMPFLTOUT</displayName>
          <description>Comparator Filter Output Register</description>
          <addressOffset>0x000002F4</addressOffset>
          <!-- registerPropertiesGroup --> 
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <!-- end of registerPropertiesGroup -->

          <fields>

            <!-- COMPL: COMPL filtered output without latch -->
            <field>
              <name>COMPL</name>
              <description>COMPL filtered output without latch</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LOW</name>
                  <description>Input is higher than the low-boundary</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HIGH</name>
                  <description>Input is lower than the low-boundary</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- COMPH: COMPH filtered output without latch -->
            <field>
              <name>COMPH</name>
              <description>COMPH filtered output without latch</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LOW</name>
                  <description>Input is lower than the high-boundary</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HIGH</name>
                  <description>Input is higher than the high-boundary</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>

        <!-- COMPFLG: Comparator Flag Register -->
        <register>
          <name>COMPFLG</name>
          <displayName>COMPFLG</displayName>
