                <enumeratedValue>
                  <name>NOT_OCCURED</name>
                  <description></description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCURRED</name>
                  <description></description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- OVWR: Enable overWrite mailbox which is end of block. -->
            <field>
