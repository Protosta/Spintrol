                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Event occurred</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RAM0MBE: Latched RAM0 ECC multi-bit error flag -->
            <field>
              <name>RAM0MBE</name>
              <description>Latched RAM0 ECC multi-bit error flag</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOT_OCCUR</name>
                  <description>Event does not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OCCUR</name>
                  <description>Event occurred</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>

            <!-- RAM1MBE: Latched RAM1 ECC multi-bit error flag -->
            <field>
              <name>RAM1MBE</name>
              <description>Latched RAM1 ECC multi-bit error flag</description>
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
